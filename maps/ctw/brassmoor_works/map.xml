<map proto="1.5.0">
    <name>Brassmoor Works</name>
    <version>1.0.0</version>
    <objective>Capture the enemy's two wools: one from their Boiler House, one from under their Water Tower.</objective>
    <gamemode>ctw</gamemode>
    <authors>
        <author>Claude (pgmvox trial)</author>
    </authors>
    <teams>
        <team id="red-team" color="red" max="16">Red</team>
        <team id="blue-team" color="blue" max="16">Blue</team>
    </teams>
    <filters>
        <team id="only-red">red-team</team>
        <not id="not-red">
            <team>red-team</team>
        </not>
        <team id="only-blue">blue-team</team>
        <not id="not-blue">
            <team>blue-team</team>
        </not>
        <any id="spawn-minable">
            <material>iron block</material>
        </any>
        <all id="spawn-minable-regrowth">
            <filter id="spawn-minable"/>
            <cause>world</cause>
        </all>
        <any id="woolroom-materials">
            <material>wood</material>
            <material>stained clay</material>
            <material>web</material>
            <all>
                <cause>player</cause>
                <any>
                    <material>water</material>
                    <material>stationary water</material>
                </any>
            </all>
        </any>
        <all id="reds-woolrooms-filter">
            <filter id="not-red"/>
            <filter id="woolroom-materials"/>
        </all>
        <all id="blues-woolrooms-filter">
            <filter id="not-blue"/>
            <filter id="woolroom-materials"/>
        </all>
        <not id="not-void">
            <void/>
        </not>
    </filters>
    <spawns>
        <spawn team="red-team" kit="spawn-kit" yaw="0">
            <region>
                <point>0.5,71,-94.5</point>
            </region>
        </spawn>
        <spawn team="blue-team" kit="spawn-kit" yaw="180">
            <region>
                <point>-0.5,71,94.5</point>
            </region>
        </spawn>
        <default yaw="90">
            <region>
                <point>0.5,96,0.5</point>
            </region>
        </default>
    </spawns>
    <regions>
        <cuboid min="-12,70,-100" max="12,91,-88" id="red-spawn"/>
        <apply enter="only-red" region="red-spawn" message="You may not enter the enemy spawn!"/>
        <apply block-place="spawn-minable-regrowth" block-break="spawn-minable" region="red-spawn" message="You may not edit the spawn!"/>
        <cuboid min="-12,70,88" max="12,91,100" id="blue-spawn"/>
        <apply enter="only-blue" region="blue-spawn" message="You may not enter the enemy spawn!"/>
        <apply block-place="spawn-minable-regrowth" block-break="spawn-minable" region="blue-spawn" message="You may not edit the spawn!"/>
        <block id="lime-blue-monument">3,71,87</block>
        <cuboid min="-79,69,-90" max="-63,79,-72" id="lime-room"/>
        <apply enter="not-red" region="lime-room" message="You may not enter your own wool room!"/>
        <point id="lime-wool-spawn">-72.5,70,-83.5</point>
        <block id="magenta-red-monument">-4,71,-88</block>
        <cuboid min="63,69,72" max="79,79,90" id="magenta-room"/>
        <apply enter="not-blue" region="magenta-room" message="You may not enter your own wool room!"/>
        <point id="magenta-wool-spawn">72.5,70,83.5</point>
        <block id="yellow-blue-monument">-4,71,87</block>
        <cuboid min="60,67,-88" max="76,75,-70" id="yellow-room"/>
        <apply enter="not-red" region="yellow-room" message="You may not enter your own wool room!"/>
        <point id="yellow-wool-spawn">68.5,68,-81.5</point>
        <block id="orange-red-monument">3,71,-88</block>
        <cuboid min="-76,67,70" max="-60,75,88" id="orange-room"/>
        <apply enter="not-blue" region="orange-room" message="You may not enter your own wool room!"/>
        <point id="orange-wool-spawn">-68.5,68,81.5</point>
        <union id="reds-woolrooms">
            <region id="lime-room"/>
            <region id="yellow-room"/>
        </union>
        <apply block="reds-woolrooms-filter" region="reds-woolrooms" message="You may not edit the wool room!"/>
        <union id="blues-woolrooms">
            <region id="magenta-room"/>
            <region id="orange-room"/>
        </union>
        <apply block="blues-woolrooms-filter" region="blues-woolrooms" message="You may not edit the wool room!"/>
        <below y="50" id="the-fall"/>
        <apply kit="fall-kill" region="the-fall"/>
        <apply block-place="not-void" message="You may not build in the void!"/>
    </regions>
    <renewables>
        <renewable region="red-spawn" renew-filter="spawn-minable"/>
        <renewable region="blue-spawn" renew-filter="spawn-minable"/>
    </renewables>
    <wools craftable="false">
        <wool team="blue-team" color="lime" monument="lime-blue-monument" location="-72.5,69,-85.5"/>
        <wool team="red-team" color="magenta" monument="magenta-red-monument" location="72.5,69,85.5"/>
        <wool team="blue-team" color="yellow" monument="yellow-blue-monument" location="68.5,67,-83.5"/>
        <wool team="red-team" color="orange" monument="orange-red-monument" location="-68.5,67,83.5"/>
    </wools>
    <spawners>
        <spawner spawn-region="lime-wool-spawn" player-region="lime-room" delay="1.5s">
            <item material="wool" damage="5"/>
        </spawner>
        <spawner spawn-region="magenta-wool-spawn" player-region="magenta-room" delay="1.5s">
            <item material="wool" damage="2"/>
        </spawner>
        <spawner spawn-region="yellow-wool-spawn" player-region="yellow-room" delay="1.5s">
            <item material="wool" damage="4"/>
        </spawner>
        <spawner spawn-region="orange-wool-spawn" player-region="orange-room" delay="1.5s">
            <item material="wool" damage="1"/>
        </spawner>
    </spawners>
    <kits>
        <kit id="spawn-kit">
            <item slot="0" material="iron sword" unbreakable="true"/>
            <item slot="1" material="bow" unbreakable="true">
                <enchantment level="1">infinity</enchantment>
            </item>
            <item slot="2" material="iron pickaxe" unbreakable="true">
                <enchantment level="1">efficiency</enchantment>
            </item>
            <item slot="3" material="iron axe" unbreakable="true"/>
            <item slot="4" material="wood" amount="64"/>
            <item slot="5" material="stained clay" amount="48" team-color="true"/>
            <item slot="6" material="golden apple"/>
            <item slot="7" material="water bucket"/>
            <item slot="8" material="cooked beef" amount="16"/>
            <item slot="28" material="arrow"/>
            <helmet material="leather helmet" unbreakable="true" team-color="true"/>
            <chestplate material="iron chestplate" unbreakable="true"/>
            <leggings material="chainmail leggings" unbreakable="true"/>
            <boots material="leather boots" unbreakable="true" team-color="true"/>
        </kit>
        <kit id="fall-kill" force="true">
            <effect duration="1" amplifier="5">instant damage</effect>
        </kit>
    </kits>
    <itemkeep>
        <item>iron sword</item>
        <item>bow</item>
        <item>iron pickaxe</item>
        <item>iron axe</item>
        <item>water bucket</item>
    </itemkeep>
    <kill-rewards>
        <kill-reward>
            <item material="wood" amount="16"/>
            <item material="golden apple"/>
        </kill-reward>
    </kill-rewards>
    <maxbuildheight>92</maxbuildheight>
</map>

