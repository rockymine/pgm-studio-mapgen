<map proto="1.5.0">
    <name>Hollowstack</name>
    <version>1.0.0</version>
    <objective>Capture the enemy's two wools, from the forest in its cavern and the vault in its dungeon, and carry them up to your keep.</objective>
    <gamemode>ctw</gamemode>
    <include id="gapple-kill-reward"/>
    <authors>
        <author>Claude (freeform generator, on pgmvox)</author>
    </authors>
    <kits>
        <kit id="spawn-kit">
            <item slot="0" material="stone sword" unbreakable="true"/>
            <item slot="1" material="bow" unbreakable="true">
                <enchantment level="1">infinity</enchantment>
            </item>
            <item slot="2" material="iron pickaxe" unbreakable="true">
                <enchantment level="1">efficiency</enchantment>
            </item>
            <item slot="3" material="iron axe" unbreakable="true"/>
            <item slot="4" material="wood" amount="64" damage="1"/>
            <item slot="5" material="glass" amount="64"/>
            <item slot="6" material="golden apple"/>
            <item slot="7" material="water bucket"/>
            <item slot="8" material="ladder" amount="32"/>
            <item slot="28" material="arrow"/>
            <item slot="29" material="shears" unbreakable="true"/>
            <item slot="31" material="wood" amount="64" damage="1"/>
            <helmet material="leather helmet" unbreakable="true" team-color="true"/>
            <chestplate material="leather chestplate" unbreakable="true" team-color="true"/>
            <leggings material="leather leggings" unbreakable="true" team-color="true"/>
            <boots material="leather boots" unbreakable="true" team-color="true"/>
        </kit>
    </kits>
    <teams>
        <team id="blue-team" color="blue" max="16">Blue</team>
        <team id="red-team" color="red" max="16">Red</team>
    </teams>
    <filters>
        <team id="only-blue">blue-team</team>
        <not id="not-blue">
            <team>blue-team</team>
        </not>
        <team id="only-red">red-team</team>
        <not id="not-red">
            <team>red-team</team>
        </not>
        <any id="woolroom-materials">
            <material>wood</material>
            <material>stained clay</material>
            <material>web</material>
            <all>
                <cause>player</cause>
                <any>
                    <material>water</material>
                    <material>stationary water</material>
                </any>
            </all>
        </any>
        <all id="blues-woolrooms-filter">
            <filter id="not-blue"/>
            <filter id="woolroom-materials"/>
        </all>
        <all id="reds-woolrooms-filter">
            <filter id="not-red"/>
            <filter id="woolroom-materials"/>
        </all>
        <not id="block-place-void-filter">
            <void/>
        </not>
        <any id="block-break-void-filter">
            <all>
                <any>
                    <material>log</material>
                    <material>log 2</material>
                    <material>leaves</material>
                    <material>leaves 2</material>
                    <material>long grass</material>
                    <material>yellow flower</material>
                    <material>red rose</material>
                    <material>double plant</material>
                    <material>water lily</material>
                    <material>vine</material>
                </any>
                <void/>
            </all>
            <filter id="block-place-void-filter"/>
        </any>
    </filters>
    <spawns>
        <spawn team="blue-team" kit="spawn-kit" yaw="90">
            <region>
                <point>82.5,101,4.5</point>
            </region>
        </spawn>
        <spawn team="red-team" kit="spawn-kit" yaw="270">
            <region>
                <point>-82.5,101,-4.5</point>
            </region>
        </spawn>
        <default yaw="90">
            <region>
                <point>1,112,1</point>
            </region>
        </default>
    </spawns>
    <regions>
        <cuboid min="81,101,2" max="93,107,11" id="blue-spawn"/>
        <apply enter="only-blue" region="blue-spawn" message="You may not enter the enemy spawn!"/>
        <apply block="never" region="blue-spawn" message="You may not build in a spawn!"/>
        <cuboid min="-93,101,-11" max="-81,107,-2" id="red-spawn"/>
        <apply enter="only-red" region="red-spawn" message="You may not enter the enemy spawn!"/>
        <apply block="never" region="red-spawn" message="You may not build in a spawn!"/>
        <block id="lime-blue-monument">79,101,-7</block>
        <cuboid min="-23,58,-6" max="-13,67,5" id="lime-room"/>
        <apply enter="not-red" region="lime-room" message="You may not enter your own wool room!"/>
        <point id="lime-wool-spawn">-17.5,60,-0.5</point>
        <block id="orange-red-monument">-80,101,6</block>
        <cuboid min="13,58,-5" max="23,67,6" id="orange-room"/>
        <apply enter="not-blue" region="orange-room" message="You may not enter your own wool room!"/>
        <point id="orange-wool-spawn">17.5,60,0.5</point>
        <block id="yellow-blue-monument">79,101,7</block>
        <cuboid min="-82,35,-19" max="-69,45,-6" id="yellow-room"/>
        <apply enter="not-red" region="yellow-room" message="You may not enter your own wool room!"/>
        <point id="yellow-wool-spawn">-80.5,37,-12.5</point>
        <block id="light_blue-red-monument">-80,101,-8</block>
        <cuboid min="69,35,6" max="82,45,19" id="light_blue-room"/>
        <apply enter="not-blue" region="light_blue-room" message="You may not enter your own wool room!"/>
        <point id="light_blue-wool-spawn">80.5,37,12.5</point>
        <union id="blues-woolrooms">
            <region id="orange-room"/>
            <region id="light_blue-room"/>
        </union>
        <apply block="blues-woolrooms-filter" region="blues-woolrooms" message="You may not edit the wool room!"/>
        <union id="reds-woolrooms">
            <region id="lime-room"/>
            <region id="yellow-room"/>
        </union>
        <apply block="reds-woolrooms-filter" region="reds-woolrooms" message="You may not edit the wool room!"/>
        <negative id="not-build-area">
            <rectangle min="-13,-28" max="13,28"/>
        </negative>
        <apply block-place="block-place-void-filter" block-break="block-break-void-filter" region="not-build-area" message="You may not edit the void!"/>
    </regions>
    <wools craftable="false">
        <wool team="blue-team" color="lime" monument="lime-blue-monument" location="-17.5,59,-0.5"/>
        <wool team="red-team" color="orange" monument="orange-red-monument" location="17.5,59,0.5"/>
        <wool team="blue-team" color="yellow" monument="yellow-blue-monument" location="-80.5,36,-12.5"/>
        <wool team="red-team" color="light blue" monument="light_blue-red-monument" location="80.5,36,12.5"/>
    </wools>
    <spawners>
        <spawner spawn-region="lime-wool-spawn" player-region="lime-room" delay="1.5s">
            <item material="wool" damage="5"/>
        </spawner>
        <spawner spawn-region="orange-wool-spawn" player-region="orange-room" delay="1.5s">
            <item material="wool" damage="1"/>
        </spawner>
        <spawner spawn-region="yellow-wool-spawn" player-region="yellow-room" delay="1.5s">
            <item material="wool" damage="4"/>
        </spawner>
        <spawner spawn-region="light_blue-wool-spawn" player-region="light_blue-room" delay="1.5s">
            <item material="wool" damage="3"/>
        </spawner>
    </spawners>
    <maxbuildheight>118</maxbuildheight>
    <block-drops>
        <rule>
            <filter>
                <any>
                    <material>wood</material>
                    <material>glass</material>
                    <material>ladder</material>
                </any>
            </filter>
            <drops>
                <item material="wood" chance="0"/>
            </drops>
        </rule>
    </block-drops>
    <itemkeep>
        <item>stone sword</item>
        <item>bow</item>
        <item>iron pickaxe</item>
        <item>iron axe</item>
        <item>golden apple</item>
        <item>water bucket</item>
        <item>arrow</item>
        <item>shears</item>
        <item>wood</item>
        <item>glass</item>
        <item>ladder</item>
    </itemkeep>
    <itemremove>
        <item>leather helmet</item>
        <item>leather chestplate</item>
        <item>leather leggings</item>
        <item>leather boots</item>
        <item>flint</item>
        <item>gravel</item>
        <item>sapling</item>
        <item>apple</item>
        <item>string</item>
        <item>seeds</item>
        <item>long grass</item>
        <item>brown mushroom</item>
        <item>red mushroom</item>
        <item>vine</item>
        <item>double plant</item>
    </itemremove>
    <toolrepair>
        <tool>stone sword</tool>
        <tool>bow</tool>
        <tool>iron pickaxe</tool>
        <tool>iron axe</tool>
        <tool>shears</tool>
    </toolrepair>
    <kill-rewards>
        <kill-reward>
            <item material="wood" amount="16" damage="1"/>
            <item material="glass" amount="16"/>
            <item material="ladder" amount="16"/>
        </kill-reward>
    </kill-rewards>
    <hunger>
        <depletion>off</depletion>
    </hunger>
</map>

