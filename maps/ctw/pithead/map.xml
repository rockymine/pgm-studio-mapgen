<map proto="1.5.0">
    <name>Pithead</name>
    <version>0.1.0</version>
    <objective>Capture the enemy's two wools from the works at the ends of their approaches, and place them on the monuments in your spawn yard.</objective>
    <gamemode>ctw</gamemode>
    <include id="gapple-kill-reward"/>
    <authors>
        <author>Claude (freeform generator)</author>
    </authors>
    <kits>
        <kit id="spawn-kit">
            <clear/>
            <item slot="0" material="iron sword" unbreakable="true"/>
            <item slot="1" material="bow" unbreakable="true"/>
            <item slot="2" material="iron pickaxe" unbreakable="true">
                <enchantment level="2">efficiency</enchantment>
            </item>
            <item slot="3" material="iron axe" unbreakable="true"/>
            <item slot="4" material="wood" amount="64"/>
            <item slot="5" material="golden apple" amount="2"/>
            <item slot="6" material="wood" amount="64"/>
            <item slot="7" material="shears" unbreakable="true"/>
            <item slot="9" material="arrow" amount="32"/>
            <helmet material="leather helmet" unbreakable="true" team-color="true"/>
            <chestplate material="leather chestplate" unbreakable="true" team-color="true"/>
            <leggings material="chainmail leggings" unbreakable="true"/>
            <boots material="iron boots" unbreakable="true"/>
        </kit>
    </kits>
    <teams>
        <team id="red-team" color="red" max="7">Red</team>
        <team id="blue-team" color="blue" max="7">Blue</team>
    </teams>
    <filters>
        <team id="only-red">red-team</team>
        <not id="not-red">
            <team>red-team</team>
        </not>
        <team id="only-blue">blue-team</team>
        <not id="not-blue">
            <team>blue-team</team>
        </not>
        <any id="woolroom-materials">
            <material>wood</material>
            <material>stained clay</material>
            <material>web</material>
            <all>
                <cause>player</cause>
                <any>
                    <material>water</material>
                    <material>stationary water</material>
                </any>
            </all>
        </any>
        <all id="reds-woolrooms-filter">
            <filter id="not-red"/>
            <filter id="woolroom-materials"/>
        </all>
        <all id="blues-woolrooms-filter">
            <filter id="not-blue"/>
            <filter id="woolroom-materials"/>
        </all>
        <not id="block-place-void-filter">
            <void/>
        </not>
        <any id="block-break-void-filter">
            <all>
                <any>
                    <material>log</material>
                    <material>log 2</material>
                    <material>leaves</material>
                    <material>leaves 2</material>
                    <material>long grass</material>
                    <material>yellow flower</material>
                    <material>red rose</material>
                    <material>double plant</material>
                    <material>water lily</material>
                    <material>vine</material>
                </any>
                <void/>
            </all>
            <filter id="block-place-void-filter"/>
        </any>
    </filters>
    <spawns>
        <default yaw="0" pitch="70">
            <region>
                <point>60.5,68,120.5</point>
            </region>
        </default>
        <spawn team="red-team" kit="spawn-kit" yaw="180">
            <region>
                <point>60.5,36,228.5</point>
            </region>
        </spawn>
        <spawn team="blue-team" kit="spawn-kit" yaw="0">
            <region>
                <point>59.5,36,11.5</point>
            </region>
        </spawn>
    </spawns>
    <regions>
        <cuboid min="52,36,224" max="68,52,232" id="red-spawn"/>
        <apply enter="only-red" region="red-spawn" message="You may not enter the enemy spawn!"/>
        <apply block="never" region="red-spawn" message="You may not build in a spawn!"/>
        <cuboid min="52,36,8" max="68,52,16" id="blue-spawn"/>
        <apply enter="only-blue" region="blue-spawn" message="You may not enter the enemy spawn!"/>
        <apply block="never" region="blue-spawn" message="You may not build in a spawn!"/>
        <block id="red-blue-monument">64,36,20</block>
        <cuboid min="16,37,160" max="28,46,168" id="red-room"/>
        <apply enter="not-red" region="red-room" message="You may not enter your own wool room!"/>
        <point id="red-wool-spawn">22.5,38,164.5</point>
        <block id="blue-red-monument">55,36,219</block>
        <cuboid min="92,37,72" max="104,46,80" id="blue-room"/>
        <apply enter="not-blue" region="blue-room" message="You may not enter your own wool room!"/>
        <point id="blue-wool-spawn">97.5,38,75.5</point>
        <block id="orange-blue-monument">55,36,20</block>
        <cuboid min="100,37,164" max="112,46,172" id="orange-room"/>
        <apply enter="not-red" region="orange-room" message="You may not enter your own wool room!"/>
        <point id="orange-wool-spawn">106.5,38,168.5</point>
        <block id="light_blue-red-monument">64,36,219</block>
        <cuboid min="8,37,68" max="20,46,76" id="light_blue-room"/>
        <apply enter="not-blue" region="light_blue-room" message="You may not enter your own wool room!"/>
        <point id="light_blue-wool-spawn">13.5,38,71.5</point>
        <cuboid min="59,33,119" max="61,35,121" id="golden-apple"/>
        <cuboid min="55,33,115" max="64,37,124" id="golden-apple-near"/>
        <union id="reds-woolrooms">
            <region id="red-room"/>
            <region id="orange-room"/>
        </union>
        <apply block="reds-woolrooms-filter" region="reds-woolrooms" message="You may not edit the wool room!"/>
        <union id="blues-woolrooms">
            <region id="blue-room"/>
            <region id="light_blue-room"/>
        </union>
        <apply block="blues-woolrooms-filter" region="blues-woolrooms" message="You may not edit the wool room!"/>
        <negative id="not-build-area">
            <rectangle min="44,96" max="76,144"/>
        </negative>
        <apply block-place="block-place-void-filter" block-break="block-break-void-filter" region="not-build-area" message="You may not edit the void!"/>
    </regions>
    <wools craftable="false">
        <wool team="blue-team" color="red" monument="red-blue-monument" location="22.5,37,164.5"/>
        <wool team="red-team" color="blue" monument="blue-red-monument" location="97.5,37,75.5"/>
        <wool team="blue-team" color="orange" monument="orange-blue-monument" location="106.5,37,168.5"/>
        <wool team="red-team" color="light blue" monument="light_blue-red-monument" location="13.5,37,71.5"/>
    </wools>
    <spawners>
        <spawner spawn-region="red-wool-spawn" player-region="red-room" delay="1.5s">
            <item material="wool" damage="14"/>
        </spawner>
        <spawner spawn-region="blue-wool-spawn" player-region="blue-room" delay="1.5s">
            <item material="wool" damage="11"/>
        </spawner>
        <spawner spawn-region="orange-wool-spawn" player-region="orange-room" delay="1.5s">
            <item material="wool" damage="1"/>
        </spawner>
        <spawner spawn-region="light_blue-wool-spawn" player-region="light_blue-room" delay="1.5s">
            <item material="wool" damage="3"/>
        </spawner>
        <spawner spawn-region="golden-apple" player-region="golden-apple-near" delay="45s" max-entities="1">
            <item material="golden apple"/>
        </spawner>
    </spawners>
    <maxbuildheight>60</maxbuildheight>
    <portals>
        <portal y="@-64" sound="false" observers="never">
            <region>
                <below y="6"/>
            </region>
        </portal>
    </portals>
    <time>25m</time>
    <block-drops>
        <rule>
            <filter>
                <material>wood</material>
            </filter>
            <drops>
                <item material="wood" chance="0"/>
            </drops>
        </rule>
    </block-drops>
    <itemkeep>
        <item>iron sword</item>
        <item>bow</item>
        <item>iron pickaxe</item>
        <item>iron axe</item>
        <item>shears</item>
        <item>wood</item>
        <item>golden apple</item>
        <item>arrow</item>
    </itemkeep>
    <itemremove>
        <item>leather helmet</item>
        <item>leather chestplate</item>
        <item>chainmail leggings</item>
        <item>iron boots</item>
        <item>sapling</item>
        <item>apple</item>
    </itemremove>
    <toolrepair>
        <tool>iron sword</tool>
        <tool>bow</tool>
        <tool>iron pickaxe</tool>
        <tool>iron axe</tool>
        <tool>shears</tool>
    </toolrepair>
    <kill-rewards>
        <kill-reward>
            <item material="wood" amount="16"/>
        </kill-reward>
    </kill-rewards>
    <hunger>
        <depletion>off</depletion>
    </hunger>
</map>

