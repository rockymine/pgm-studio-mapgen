<map proto="1.5.0">
    <name>Four Winds Compound</name>
    <version>1.0.0</version>
    <gamemode>ctw</gamemode>
    <objective>Capture the wool!</objective>
    <include id="gapple-kill-reward"/>
    <authors>
        <author uuid="0d05f1a5-0005-4005-8006-0000000c0mp1"/>
        <!-- Sonnet 5 -->
    </authors>
    <teams>
        <team id="red-team" color="red" max="24">Red</team>
        <team id="blue-team" color="blue" max="24">Blue</team>
        <team id="yellow-team" color="yellow" max="24">Yellow</team>
        <team id="green-team" color="green" max="24">Green</team>
    </teams>
    <kits>
        <kit id="spawn-kit">
            <clear/>
            <item slot="0" material="iron sword" unbreakable="true"/>
            <item slot="1" material="bow" unbreakable="true">
                <enchantment level="1">infinity</enchantment>
            </item>
            <item slot="2" material="iron pickaxe" unbreakable="true">
                <enchantment level="1">efficiency</enchantment>
            </item>
            <item slot="3" material="iron axe" unbreakable="true">
                <enchantment level="1">efficiency</enchantment>
            </item>
            <item slot="4" material="wood" amount="64"/>
            <item slot="5" material="stained clay" amount="32" team-color="true"/>
            <item slot="7" material="water bucket"/>
            <item slot="8" material="golden apple"/>
            <item slot="28" material="arrow"/>
            <item slot="29" material="shears" unbreakable="true"/>
            <item slot="30" material="iron spade" unbreakable="true"/>
            <helmet material="leather helmet" unbreakable="true" team-color="true">
                <enchantment level="1">projectile_protection</enchantment>
            </helmet>
            <chestplate material="leather chestplate" unbreakable="true" team-color="true">
                <enchantment level="1">projectile_protection</enchantment>
            </chestplate>
            <leggings material="chainmail leggings" unbreakable="true">
                <enchantment level="1">projectile_protection</enchantment>
            </leggings>
            <boots material="leather boots" unbreakable="true" team-color="true">
                <enchantment level="1">projectile_protection</enchantment>
            </boots>
            <effect duration="oo" amplifier="100">damage resistance</effect>
        </kit>
        <kit id="reset-resistance-kit" force="true">
            <effect duration="0" amplifier="0">damage resistance</effect>
        </kit>
    </kits>
    <spawns>
        <default region="observer-spawn"/>
        <spawn team="red-team" kit="spawn-kit" yaw="180" region="red-spawn-point"/>
        <spawn team="blue-team" kit="spawn-kit" yaw="270" region="blue-spawn-point"/>
        <spawn team="yellow-team" kit="spawn-kit" region="yellow-spawn-point"/>
        <spawn team="green-team" kit="spawn-kit" yaw="90" region="green-spawn-point"/>
    </spawns>
    <wools>
        <wool team="blue-team" color="red" location="0,10,60" monument="red-blue-monument"/>
        <wool team="yellow-team" color="red" location="0,10,60" monument="red-yellow-monument"/>
        <wool team="green-team" color="red" location="0,10,60" monument="red-green-monument"/>
        <wool team="red-team" color="blue" location="-60,10,0" monument="blue-red-monument"/>
        <wool team="yellow-team" color="blue" location="-60,10,0" monument="blue-yellow-monument"/>
        <wool team="green-team" color="blue" location="-60,10,0" monument="blue-green-monument"/>
        <wool team="red-team" color="yellow" location="0,10,-60" monument="yellow-red-monument"/>
        <wool team="blue-team" color="yellow" location="0,10,-60" monument="yellow-blue-monument"/>
        <wool team="green-team" color="yellow" location="0,10,-60" monument="yellow-green-monument"/>
        <wool team="red-team" color="green" location="60,10,0" monument="green-red-monument"/>
        <wool team="blue-team" color="green" location="60,10,0" monument="green-blue-monument"/>
        <wool team="yellow-team" color="green" location="60,10,0" monument="green-yellow-monument"/>
    </wools>
    <filters>
        <team id="only-green">green-team</team>
        <team id="only-yellow">yellow-team</team>
        <team id="only-blue">blue-team</team>
        <team id="only-red">red-team</team>
        <all id="yellows-woolrooms-filter">
            <filter id="not-yellow"/>
            <filter id="woolrooms-filter"/>
        </all>
        <not id="not-yellow">
            <filter id="only-yellow"/>
        </not>
        <all id="blues-woolrooms-filter">
            <filter id="not-blue"/>
            <filter id="woolrooms-filter"/>
        </all>
        <not id="not-blue">
            <filter id="only-blue"/>
        </not>
        <all id="reds-woolrooms-filter">
            <filter id="not-red"/>
            <filter id="woolrooms-filter"/>
        </all>
        <not id="not-red">
            <filter id="only-red"/>
        </not>
        <material id="chest-filter">chest</material>
        <any id="woolrooms-filter">
            <material>web</material>
            <material>stained glass</material>
            <material>stained glass pane</material>
            <material>wood</material>
            <material>stained clay</material>
            <all>
                <cause>player</cause>
                <any>
                    <material>water</material>
                    <material>stationary water</material>
                </any>
            </all>
        </any>
        <all id="greens-woolrooms-filter">
            <filter id="not-green"/>
            <filter id="woolrooms-filter"/>
        </all>
        <not id="not-green">
            <filter id="only-green"/>
        </not>
        <not id="no-void">
            <void/>
        </not>
        <material id="only-air">air</material>
        <material id="only-iron">iron block</material>
    </filters>
    <regions>
        <point id="green-spawn-point">90,13,-1</point>
        <point id="yellow-spawn-point">-1,13,-90</point>
        <point id="blue-spawn-point">-90,13,1</point>
        <point id="red-spawn-point">1,13,90</point>
        <point id="blue-wool-spawn">-60,10,0</point>
        <point id="red-wool-spawn">0,10,60</point>
        <point id="yellow-wool-spawn">0,10,-60</point>
        <point id="green-wool-spawn">60,10,0</point>
        <point id="observer-spawn">0,51,0</point>
        <block id="yellow-green-monument">92,14,-8</block>
        <block id="yellow-blue-monument">-88,14,7</block>
        <block id="yellow-red-monument">7,14,87</block>
        <block id="blue-green-monument">87,14,0</block>
        <block id="blue-yellow-monument">0,14,-88</block>
        <block id="blue-red-monument">-1,14,87</block>
        <block id="red-green-monument">87,14,-8</block>
        <block id="red-yellow-monument">-8,14,-88</block>
        <block id="red-blue-monument">-88,14,-1</block>
        <block id="green-red-monument">-1,14,92</block>
        <block id="green-blue-monument">-93,14,-1</block>
        <block id="green-yellow-monument">-8,14,-93</block>
        <rectangle id="green-spawn" min="85,-10" max="95,10"/>
        <rectangle id="yellow-spawn" min="-10,-95" max="10,-85"/>
        <rectangle id="blue-spawn" min="-95,-10" max="-85,10"/>
        <rectangle id="red-spawn" min="-10,85" max="10,95"/>
        <rectangle id="blue-wool" min="-65,-5" max="-55,5"/>
        <rectangle id="red-wool" min="-5,55" max="5,65"/>
        <rectangle id="yellow-wool" min="-5,-65" max="5,-55"/>
        <rectangle id="green-wool" min="55,-5" max="65,5"/>
        <union id="reds-woolrooms">
            <region id="red-wool"/>
        </union>
        <union id="blues-woolrooms">
            <region id="blue-wool"/>
        </union>
        <union id="yellows-woolrooms">
            <region id="yellow-wool"/>
        </union>
        <union id="greens-woolrooms">
            <region id="green-wool"/>
        </union>
        <union id="woolrooms">
            <region id="reds-woolrooms"/>
            <region id="blues-woolrooms"/>
            <region id="yellows-woolrooms"/>
            <region id="greens-woolrooms"/>
        </union>
        <union id="iron-cubes">
            <rectangle id="iron-cube-0" min="-7,88" max="-4,91"/>
            <rectangle id="iron-cube-1" min="-92,-7" max="-89,-4"/>
            <rectangle id="iron-cube-2" min="3,-92" max="6,-89"/>
            <rectangle id="iron-cube-3" min="88,3" max="91,6"/>
        </union>
        <negative id="not-spawns">
            <region id="spawns"/>
        </negative>
        <negative id="not-build-area">
            <union id="build-area">
                <rectangle id="build-area-1" min="-15,15" max="15,30"/>
                <rectangle id="build-area-2" min="-30,-15" max="-15,15"/>
                <rectangle id="build-area-3" min="-15,-30" max="15,-15"/>
                <rectangle id="build-area-4" min="15,-15" max="30,15"/>
            </union>
        </negative>
        <complement id="spawns">
            <union id="spawn-areas">
                <region id="red-spawn"/>
                <region id="blue-spawn"/>
                <region id="yellow-spawn"/>
                <region id="green-spawn"/>
            </union>
            <region id="red-blue-monument"/>
            <region id="red-yellow-monument"/>
            <region id="red-green-monument"/>
            <region id="blue-red-monument"/>
            <region id="blue-yellow-monument"/>
            <region id="blue-green-monument"/>
            <region id="yellow-red-monument"/>
            <region id="yellow-blue-monument"/>
            <region id="yellow-green-monument"/>
            <region id="green-red-monument"/>
            <region id="green-blue-monument"/>
            <region id="green-yellow-monument"/>
        </complement>
        <apply enter="only-red" region="red-spawn" message="You may not enter the enemy's spawn!"/>
        <apply enter="only-blue" region="blue-spawn" message="You may not enter the enemy's spawn!"/>
        <apply enter="only-yellow" region="yellow-spawn" message="You may not enter the enemy's spawn!"/>
        <apply enter="only-green" region="green-spawn" message="You may not enter the enemy's spawn!"/>
        <apply block="never" region="spawns" message="You may not block/break spawns!"/>
        <apply kit="reset-resistance-kit" region="not-spawns"/>
        <apply enter="not-red" region="reds-woolrooms" message="You may not enter your own wool room!"/>
        <apply block="reds-woolrooms-filter" region="reds-woolrooms" message="You may not edit the wool room!"/>
        <apply use="deny(all(only-red,chest-filter))" region="reds-woolrooms"/>
        <apply enter="not-blue" region="blues-woolrooms" message="You may not enter your own wool room!"/>
        <apply block="blues-woolrooms-filter" region="blues-woolrooms" message="You may not edit the wool room!"/>
        <apply use="deny(all(only-blue,chest-filter))" region="blues-woolrooms"/>
        <apply enter="not-yellow" region="yellows-woolrooms" message="You may not enter your own wool room!"/>
        <apply block="yellows-woolrooms-filter" region="yellows-woolrooms" message="You may not edit the wool room!"/>
        <apply use="deny(all(only-yellow,chest-filter))" region="yellows-woolrooms"/>
        <apply enter="not-green" region="greens-woolrooms" message="You may not enter your own wool room!"/>
        <apply block="greens-woolrooms-filter" region="greens-woolrooms" message="You may not edit the wool room!"/>
        <apply use="deny(all(only-green,chest-filter))" region="greens-woolrooms"/>
        <apply block="no-void" region="not-build-area" message="You may not edit the void!"/>
    </regions>
    <spawners>
        <spawner spawn-region="red-wool-spawn" player-region="red-wool" delay="1.5s">
            <item material="wool" damage="14"/>
        </spawner>
        <spawner spawn-region="blue-wool-spawn" player-region="blue-wool" delay="1.5s">
            <item material="wool" damage="11"/>
        </spawner>
        <spawner spawn-region="yellow-wool-spawn" player-region="yellow-wool" delay="1.5s">
            <item material="wool" damage="4"/>
        </spawner>
        <spawner spawn-region="green-wool-spawn" player-region="green-wool" delay="1.5s">
            <item material="wool" damage="13"/>
        </spawner>
    </spawners>
    <renewables>
        <renewable region="iron-cubes" renew-filter="only-iron" replace-filter="only-air" avoid-players="2"/>
    </renewables>
    <block-drops>
        <rule>
            <filter>
                <any>
                    <material>wood</material>
                    <material>stained clay</material>
                </any>
            </filter>
            <drops>
                <item material="wood" chance="0"/>
            </drops>
        </rule>
    </block-drops>
    <itemkeep>
        <item>iron sword</item>
        <item>bow</item>
        <item>iron pickaxe</item>
        <item>iron axe</item>
        <item>water bucket</item>
        <item>golden apple</item>
        <item>arrow</item>
        <item>shears</item>
        <item>iron spade</item>
        <item>wood</item>
        <item>stained clay</item>
    </itemkeep>
    <itemremove>
        <item>leather helmet</item>
        <item>leather chestplate</item>
        <item>chainmail leggings</item>
        <item>leather boots</item>
    </itemremove>
    <toolrepair>
        <tool>iron sword</tool>
        <tool>bow</tool>
        <tool>iron pickaxe</tool>
        <tool>iron axe</tool>
        <tool>shears</tool>
        <tool>iron spade</tool>
    </toolrepair>
    <kill-rewards>
        <kill-reward>
            <item material="wood" amount="16"/>
            <item material="stained clay" amount="8" team-color="true"/>
        </kill-reward>
    </kill-rewards>
    <hunger>
        <depletion>off</depletion>
    </hunger>
    <maxbuildheight>33</maxbuildheight>
</map>
