<map proto="1.5.0">
    <name>Blastworks</name>
    <version>1.0.0</version>
    <objective>Blow your way into the enemy's box, take their wool and bring it home.</objective>
    <gamemode>ctw</gamemode>
    <include id="gapple-kill-reward"/>
    <authors>
        <author>Claude (freeform generator, on pgmvox)</author>
    </authors>
    <kits>
        <kit id="spawn-kit">
            <item slot="0" material="stone sword" unbreakable="true"/>
            <item slot="1" material="bow" unbreakable="true"/>
            <item slot="2" material="iron pickaxe" unbreakable="true">
                <enchantment level="1">efficiency</enchantment>
            </item>
            <item slot="3" material="iron axe" unbreakable="true"/>
            <item slot="4" material="wood" amount="64"/>
            <item slot="5" material="tnt" amount="12"/>
            <item slot="6" material="glass" amount="32"/>
            <item slot="7" material="golden apple"/>
            <item slot="8" material="wood" amount="64"/>
            <item slot="28" material="arrow" amount="32"/>
            <helmet material="leather helmet" unbreakable="true" team-color="true"/>
            <chestplate material="leather chestplate" unbreakable="true" team-color="true"/>
            <leggings material="leather leggings" unbreakable="true" team-color="true"/>
            <boots material="leather boots" unbreakable="true" team-color="true"/>
        </kit>
    </kits>
    <teams>
        <team id="blue-team" color="blue" max="16">Blue</team>
        <team id="red-team" color="red" max="16">Red</team>
    </teams>
    <filters>
        <team id="only-blue">blue-team</team>
        <not id="not-blue">
            <team>blue-team</team>
        </not>
        <team id="only-red">red-team</team>
        <not id="not-red">
            <team>red-team</team>
        </not>
        <any id="woolroom-materials">
            <material>wood</material>
            <material>stained clay</material>
            <material>web</material>
            <all>
                <cause>player</cause>
                <any>
                    <material>water</material>
                    <material>stationary water</material>
                </any>
            </all>
        </any>
        <all id="blues-woolrooms-filter">
            <filter id="not-blue"/>
            <filter id="woolroom-materials"/>
        </all>
        <all id="reds-woolrooms-filter">
            <filter id="not-red"/>
            <filter id="woolroom-materials"/>
        </all>
        <any id="may-break">
            <material>wood</material>
            <material>tnt</material>
            <material>glass</material>
            <material>ladder</material>
            <all>
                <material>end stone</material>
                <cause>explosion</cause>
            </all>
        </any>
        <not id="block-place-void-filter">
            <void/>
        </not>
        <any id="block-break-void-filter">
            <all>
                <any>
                    <material>log</material>
                    <material>log 2</material>
                    <material>leaves</material>
                    <material>leaves 2</material>
                    <material>long grass</material>
                    <material>yellow flower</material>
                    <material>red rose</material>
                    <material>double plant</material>
                    <material>water lily</material>
                    <material>vine</material>
                </any>
                <void/>
            </all>
            <filter id="block-place-void-filter"/>
        </any>
    </filters>
    <spawns>
        <spawn team="blue-team" kit="spawn-kit" yaw="-90">
            <region>
                <cuboid min="-104,13,12" max="-99,14,16"/>
            </region>
        </spawn>
        <spawn team="red-team" kit="spawn-kit" yaw="90">
            <region>
                <cuboid min="99,13,-16" max="104,14,-12"/>
            </region>
        </spawn>
        <default yaw="90">
            <region>
                <point>1,30,1</point>
            </region>
        </default>
    </spawns>
    <regions>
        <union id="blue-spawn">
            <cuboid min="-105,13,11" max="-97,20,17"/>
            <cuboid min="-97,13,11" max="-96,20,12"/>
            <cuboid min="-97,13,13" max="-96,20,17"/>
        </union>
        <apply enter="only-blue" region="blue-spawn" message="You may not enter the enemy spawn!"/>
        <apply block="never" region="blue-spawn" message="You may not build in a spawn!"/>
        <union id="red-spawn">
            <cuboid min="97,13,-17" max="105,20,-11"/>
            <cuboid min="96,13,-12" max="97,20,-11"/>
            <cuboid min="96,13,-17" max="97,20,-13"/>
        </union>
        <apply enter="only-red" region="red-spawn" message="You may not enter the enemy spawn!"/>
        <apply block="never" region="red-spawn" message="You may not build in a spawn!"/>
        <block id="orange-blue-monument">-97,13,12</block>
        <cuboid min="79,2,8" max="95,15,20" id="orange-room"/>
        <apply enter="not-red" region="orange-room" message="You may not enter your own wool room!"/>
        <point id="orange-wool-spawn">90.5,6,14.5</point>
        <block id="lime-red-monument">96,13,-13</block>
        <cuboid min="-95,2,-20" max="-79,15,-8" id="lime-room"/>
        <apply enter="not-blue" region="lime-room" message="You may not enter your own wool room!"/>
        <point id="lime-wool-spawn">-90.5,6,-14.5</point>
        <cuboid min="-94,15,-19" max="-84,18,-9" id="blue-roof-door-region"/>
        <cuboid min="84,15,9" max="94,18,19" id="red-roof-door-region"/>
        <cuboid min="-79,2,-19" max="-76,12,-9" id="blue-side-door-region"/>
        <cuboid min="76,2,9" max="79,12,19" id="red-side-door-region"/>
        <cuboid min="-1,15,-1" max="1,16,1" id="tnt-spawner"/>
        <union id="blues-woolrooms">
            <region id="lime-room"/>
        </union>
        <apply block="blues-woolrooms-filter" region="blues-woolrooms" message="You may not edit the wool room!"/>
        <union id="reds-woolrooms">
            <region id="orange-room"/>
        </union>
        <apply block="reds-woolrooms-filter" region="reds-woolrooms" message="You may not edit the wool room!"/>
        <cuboid min="-96,19,-21" max="-83,41,-7" id="blue-box-top"/>
        <apply enter="not-blue" region="blue-box-top" message="You may not stand on your own wool's box!"/>
        <cuboid min="83,19,7" max="96,41,21" id="red-box-top"/>
        <apply enter="not-red" region="red-box-top" message="You may not stand on your own wool's box!"/>
        <apply block-break="may-break" message="Only what was built breaks, and the doors by a blast!"/>
        <negative id="not-build-area">
            <union>
                <rectangle min="-76,-21" max="-59,-7"/>
                <rectangle min="-76,-7" max="-68,-1"/>
                <rectangle min="-68,-1" max="-40,14"/>
                <rectangle min="-58,14" max="-50,21"/>
                <rectangle min="-26,-21" max="26,21"/>
                <rectangle min="59,7" max="76,21"/>
                <rectangle min="68,1" max="76,7"/>
                <rectangle min="40,-14" max="68,1"/>
                <rectangle min="50,-21" max="58,-14"/>
                <rectangle min="-26,-21" max="26,21"/>
            </union>
        </negative>
        <apply block-place="block-place-void-filter" block-break="block-break-void-filter" region="not-build-area" message="You may not edit the void!"/>
    </regions>
    <wools craftable="false">
        <wool team="blue-team" color="orange" monument="orange-blue-monument" location="90.5,5,14.5"/>
        <wool team="red-team" color="lime" monument="lime-red-monument" location="-90.5,5,-14.5"/>
    </wools>
    <spawners>
        <spawner spawn-region="orange-wool-spawn" player-region="orange-room" delay="1.5s">
            <item material="wool" damage="1"/>
        </spawner>
        <spawner spawn-region="lime-wool-spawn" player-region="lime-room" delay="1.5s">
            <item material="wool" damage="5"/>
        </spawner>
        <spawner spawn-region="tnt-spawner" delay="20s" max-entities="4">
            <item material="tnt" amount="2"/>
        </spawner>
    </spawners>
    <destroyables>
        <destroyable id="blue-roof-door" name="Roof Door" owner="blue-team" materials="end stone" completion="100%" mode-changes="true" required="false" region="blue-roof-door-region"/>
        <destroyable id="red-roof-door" name="Roof Door" owner="red-team" materials="end stone" completion="100%" mode-changes="true" required="false" region="red-roof-door-region"/>
        <destroyable id="blue-side-door" name="Side Door" owner="blue-team" materials="end stone" completion="100%" mode-changes="true" required="false" region="blue-side-door-region"/>
        <destroyable id="red-side-door" name="Side Door" owner="red-team" materials="end stone" completion="100%" mode-changes="true" required="false" region="red-side-door-region"/>
    </destroyables>
    <tnt>
        <instantignite>on</instantignite>
        <blockdamage>on</blockdamage>
    </tnt>
    <crafting>
        <disable>crafting table</disable>
    </crafting>
    <maxbuildheight>32</maxbuildheight>
    <block-drops>
        <rule>
            <filter>
                <any>
                    <material>wood</material>
                    <material>tnt</material>
                    <material>glass</material>
                </any>
            </filter>
            <drops>
                <item material="wood" chance="0"/>
            </drops>
        </rule>
    </block-drops>
    <itemkeep>
        <item>stone sword</item>
        <item>bow</item>
        <item>iron pickaxe</item>
        <item>iron axe</item>
        <item>golden apple</item>
        <item>wood</item>
        <item>tnt</item>
        <item>glass</item>
        <item>arrow</item>
    </itemkeep>
    <itemremove>
        <item>leather helmet</item>
        <item>leather chestplate</item>
        <item>leather leggings</item>
        <item>leather boots</item>
        <item>end stone</item>
        <item>sapling</item>
        <item>apple</item>
        <item>seeds</item>
        <item>long grass</item>
        <item>double plant</item>
    </itemremove>
    <toolrepair>
        <tool>stone sword</tool>
        <tool>bow</tool>
        <tool>iron pickaxe</tool>
        <tool>iron axe</tool>
    </toolrepair>
    <kill-rewards>
        <kill-reward>
            <item material="wood" amount="16"/>
            <item material="tnt" amount="16"/>
            <item material="glass" amount="16"/>
        </kill-reward>
    </kill-rewards>
    <hunger>
        <depletion>off</depletion>
    </hunger>
</map>

