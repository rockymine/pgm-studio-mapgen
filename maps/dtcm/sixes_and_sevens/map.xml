<map proto="1.5.0">
    <name>Sixes and Sevens</name>
    <version>1.0.0</version>
    <objective>Break the enemy's Reactor and Pump; keep your own.</objective>
    <gamemode>dtm</gamemode>
    <rules>
        <rule>Each team defends its Reactor, in the tall hall behind its door, and its Pump, in the yard beside it.</rule>
        <rule>The crevasses run down to lava. The mountains over the bunkers are out of bounds.</rule>
    </rules>
    <include id="gapple-kill-reward"/>
    <authors>
        <author>Claude (on pgmvox)</author>
    </authors>
    <contributors>
        <contributor contribution="the Bunker style and the brief">rockymine</contributor>
    </contributors>
    <kits>
        <kit id="spawn-kit">
            <item slot="0" material="iron sword" unbreakable="true"/>
            <item slot="1" material="bow" unbreakable="true">
                <enchantment level="1">infinity</enchantment>
            </item>
            <item slot="2" material="iron pickaxe" unbreakable="true">
                <enchantment level="1">efficiency</enchantment>
            </item>
            <item slot="3" material="iron axe" unbreakable="true">
                <enchantment level="1">efficiency</enchantment>
            </item>
            <item slot="4" material="wood" amount="64" damage="1"/>
            <item slot="5" material="glass" amount="32"/>
            <item slot="6" material="golden apple"/>
            <item slot="7" material="water bucket"/>
            <item slot="8" material="cooked beef" amount="16"/>
            <item slot="28" material="arrow"/>
            <item slot="31" material="wood" amount="64" damage="1"/>
            <helmet material="leather helmet" unbreakable="true" team-color="true"/>
            <chestplate material="iron chestplate" unbreakable="true"/>
            <leggings material="chainmail leggings" unbreakable="true"/>
            <boots material="leather boots" unbreakable="true" team-color="true"/>
        </kit>
    </kits>
    <teams>
        <team id="red-team" color="red" max="20">Red</team>
        <team id="blue-team" color="blue" max="20">Blue</team>
    </teams>
    <filters>
        <team id="only-red">red-team</team>
        <not id="not-red">
            <team>red-team</team>
        </not>
        <team id="only-blue">blue-team</team>
        <not id="not-blue">
            <team>blue-team</team>
        </not>
    </filters>
    <spawns>
        <spawn team="red-team" yaw="-90">
            <region>
                <point>-90.5,41,27.5</point>
            </region>
        </spawn>
        <spawn team="blue-team" yaw="90">
            <region>
                <point>90.5,41,-27.5</point>
            </region>
        </spawn>
        <default yaw="90">
            <region>
                <point>0.5,90,0.5</point>
            </region>
        </default>
    </spawns>
    <regions>
        <cuboid min="-95,41,23" max="-86,45,32" id="red-spawn"/>
        <apply enter="only-red" region="red-spawn" message="You may not enter the enemy spawn!"/>
        <apply block="never" region="red-spawn" message="You may not build in a spawn!"/>
        <cuboid min="86,41,-32" max="95,45,-23" id="blue-spawn"/>
        <apply enter="only-blue" region="blue-spawn" message="You may not enter the enemy spawn!"/>
        <apply block="never" region="blue-spawn" message="You may not build in a spawn!"/>
        <cuboid min="-60,45,1" max="-59,47,2" id="red-reactor-region"/>
        <cuboid min="59,45,-2" max="60,47,-1" id="blue-reactor-region"/>
        <cuboid min="-51,44,43" max="-50,46,44" id="red-pump-region"/>
        <cuboid min="50,44,-44" max="51,46,-43" id="blue-pump-region"/>
        <negative id="outside">
            <cuboid min="-140,0,-100" max="140,160,100"/>
        </negative>
        <apply enter="never" block="never" region="outside" message="You may not leave the map!"/>
        <cuboid min="-140,75,-100" max="-49,160,100" id="red-mountain"/>
        <apply enter="never" region="red-mountain" message="The mountain is out of bounds"/>
        <cuboid min="49,75,-100" max="140,160,100" id="blue-mountain"/>
        <apply enter="never" region="blue-mountain" message="The mountain is out of bounds"/>
    </regions>
    <destroyables>
        <destroyable id="red-reactor" name="Reactor" owner="red-team" materials="obsidian" completion="100%" mode-changes="true" region="red-reactor-region"/>
        <destroyable id="blue-reactor" name="Reactor" owner="blue-team" materials="obsidian" completion="100%" mode-changes="true" region="blue-reactor-region"/>
        <destroyable id="red-pump" name="Pump" owner="red-team" materials="obsidian" completion="100%" mode-changes="true" region="red-pump-region"/>
        <destroyable id="blue-pump" name="Pump" owner="blue-team" materials="obsidian" completion="100%" mode-changes="true" region="blue-pump-region"/>
    </destroyables>
    <gamerules>
        <doFireTick>false</doFireTick>
    </gamerules>
    <maxbuildheight>74</maxbuildheight>
    <time result="objectives">30m</time>
    <block-drops>
        <rule>
            <filter>
                <any>
                    <material>wood</material>
                    <material>glass</material>
                </any>
            </filter>
            <drops>
                <item material="wood" chance="0"/>
            </drops>
        </rule>
    </block-drops>
    <itemkeep>
        <item>iron sword</item>
        <item>bow</item>
        <item>iron pickaxe</item>
        <item>iron axe</item>
        <item>golden apple</item>
        <item>water bucket</item>
        <item>arrow</item>
        <item>wood</item>
        <item>glass</item>
        <item>cooked beef</item>
    </itemkeep>
    <itemremove>
        <item>leather helmet</item>
        <item>iron chestplate</item>
        <item>chainmail leggings</item>
        <item>leather boots</item>
        <item>obsidian</item>
        <item>flint</item>
        <item>gravel</item>
    </itemremove>
    <toolrepair>
        <tool>iron sword</tool>
        <tool>bow</tool>
        <tool>iron pickaxe</tool>
        <tool>iron axe</tool>
    </toolrepair>
    <kill-rewards>
        <kill-reward>
            <item material="wood" amount="16" damage="1"/>
            <item material="glass" amount="16"/>
        </kill-reward>
    </kill-rewards>
    <hunger>
        <depletion>off</depletion>
    </hunger>
</map>

