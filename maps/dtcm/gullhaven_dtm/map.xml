<map proto="1.5.0">
    <name>Gullhaven DTM</name>
    <version>0.1.0</version>
    <objective>Destroy both of the other team's gold monuments: one floating over the harbour, one over the beach.</objective>
    <gamemode>dtm</gamemode>
    <authors>
        <author>Claude (freeform generator)</author>
    </authors>
    <kits>
        <kit id="spawn-kit">
            <clear/>
            <item slot="0" material="iron sword" unbreakable="true"/>
            <item slot="1" material="bow" unbreakable="true"/>
            <item slot="2" material="iron pickaxe" unbreakable="true"/>
            <item slot="3" material="iron axe" unbreakable="true"/>
            <item slot="4" material="wood" amount="64"/>
            <item slot="5" material="golden apple" amount="2"/>
            <item slot="6" material="cooked beef" amount="16"/>
            <item slot="7" material="water bucket"/>
            <item slot="28" material="arrow" amount="32"/>
            <helmet material="leather helmet" unbreakable="true" team-color="true"/>
            <chestplate material="iron chestplate" unbreakable="true"/>
            <leggings material="chainmail leggings" unbreakable="true"/>
            <boots material="leather boots" unbreakable="true" team-color="true"/>
            <effect duration="5s" amplifier="5">damage resistance</effect>
        </kit>
    </kits>
    <teams>
        <team id="red-team" color="red" max="16">Red</team>
        <team id="blue-team" color="blue" max="16">Blue</team>
    </teams>
    <filters>
        <team id="only-red">red-team</team>
        <not id="not-red">
            <team>red-team</team>
        </not>
        <team id="only-blue">blue-team</team>
        <not id="not-blue">
            <team>blue-team</team>
        </not>
    </filters>
    <spawns>
        <default yaw="0">
            <region>
                <point>-18.5,60,57.5</point>
            </region>
        </default>
        <spawn team="red-team" kit="spawn-kit" yaw="0">
            <region>
                <point>16.5,37,-38.5</point>
            </region>
        </spawn>
        <spawn team="blue-team" kit="spawn-kit" yaw="180">
            <region>
                <point>-53.5,37,154.5</point>
            </region>
        </spawn>
    </spawns>
    <regions>
        <cuboid min="10,0,-40" max="23,256,-35" id="red-spawn"/>
        <apply enter="only-red" region="red-spawn" message="You may not enter the enemy spawn!"/>
        <apply block="never" region="red-spawn" message="You may not build in a spawn!"/>
        <cuboid min="-60,0,151" max="-47,256,156" id="blue-spawn"/>
        <apply enter="only-blue" region="blue-spawn" message="You may not enter the enemy spawn!"/>
        <apply block="never" region="blue-spawn" message="You may not build in a spawn!"/>
        <cuboid min="30,22,24" max="33,25,27" id="red-harbour-region"/>
        <cuboid min="-52,25,7" max="-49,28,10" id="red-beach-region"/>
        <cuboid min="-70,22,89" max="-67,25,92" id="blue-harbour-region"/>
        <cuboid min="12,25,106" max="15,28,109" id="blue-beach-region"/>
        <negative id="outside">
            <cuboid min="-96,0,-56" max="59,256,172"/>
        </negative>
        <apply enter="never" block="never" region="outside" message="The sea is too rough past here."/>
    </regions>
    <destroyables>
        <destroyable id="red-harbour" name="Red's Harbour Monument" owner="red-team" materials="gold block" completion="100%" mode-changes="true" region="red-harbour-region"/>
        <destroyable id="red-beach" name="Red's Beach Monument" owner="red-team" materials="gold block" completion="100%" mode-changes="true" region="red-beach-region"/>
        <destroyable id="blue-harbour" name="Blue's Harbour Monument" owner="blue-team" materials="gold block" completion="100%" mode-changes="true" region="blue-harbour-region"/>
        <destroyable id="blue-beach" name="Blue's Beach Monument" owner="blue-team" materials="gold block" completion="100%" mode-changes="true" region="blue-beach-region"/>
    </destroyables>
    <maxbuildheight>56</maxbuildheight>
    <respawn delay="5s"/>
    <world>
        <timeset>5000</timeset>
        <timelock>on</timelock>
    </world>
    <block-drops>
        <rule>
            <filter>
                <material>wood</material>
            </filter>
            <drops>
                <item material="wood" chance="0"/>
            </drops>
        </rule>
    </block-drops>
    <itemkeep>
        <item>iron sword</item>
        <item>bow</item>
        <item>iron pickaxe</item>
        <item>iron axe</item>
        <item>water bucket</item>
        <item>wood</item>
        <item>golden apple</item>
        <item>cooked beef</item>
        <item>arrow</item>
    </itemkeep>
    <itemremove>
        <item>leather helmet</item>
        <item>iron chestplate</item>
        <item>chainmail leggings</item>
        <item>leather boots</item>
        <item>gold block</item>
        <item>flint</item>
        <item>gravel</item>
        <item>sapling</item>
        <item>apple</item>
        <item>seeds</item>
        <item>long grass</item>
        <item>yellow flower</item>
        <item>red rose</item>
    </itemremove>
    <toolrepair>
        <tool>iron sword</tool>
        <tool>bow</tool>
        <tool>iron pickaxe</tool>
        <tool>iron axe</tool>
    </toolrepair>
    <kill-rewards>
        <kill-reward>
            <item material="arrow" amount="6"/>
            <item material="golden apple"/>
        </kill-reward>
    </kill-rewards>
    <hunger>
        <depletion>off</depletion>
    </hunger>
</map>

