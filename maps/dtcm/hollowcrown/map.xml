<map proto="1.5.0">
    <name>Hollowcrown</name>
    <version>0.1.0</version>
    <objective>Break both of the enemy's monuments: one atop the Eyrie on their mountain's north spur, one in the Hall of Echoes in the cavern beneath it.</objective>
    <gamemode>dtm</gamemode>
    <include id="gapple-kill-reward"/>
    <authors>
        <author>Claude (freeform generator)</author>
    </authors>
    <contributors>
        <contributor contribution="Built the oak and spruce trees (tree showcase)">rockymine</contributor>
    </contributors>
    <kits>
        <kit id="spawn-kit">
            <item slot="0" material="iron sword" unbreakable="true"/>
            <item slot="1" material="bow" unbreakable="true">
                <enchantment level="1">infinity</enchantment>
            </item>
            <item slot="2" material="diamond pickaxe" unbreakable="true"/>
            <item slot="3" material="iron axe" unbreakable="true"/>
            <item slot="4" material="wood" amount="64"/>
            <item slot="5" material="wool" amount="64" team-color="true"/>
            <item slot="27" material="wood" amount="64"/>
            <item slot="6" material="golden apple"/>
            <item slot="7" material="water bucket"/>
            <item slot="8" material="cooked beef" amount="16"/>
            <item slot="28" material="arrow"/>
            <helmet material="leather helmet" unbreakable="true" team-color="true"/>
            <chestplate material="iron chestplate" unbreakable="true"/>
            <leggings material="chainmail leggings" unbreakable="true"/>
            <boots material="leather boots" unbreakable="true" team-color="true"/>
        </kit>
    </kits>
    <teams>
        <team id="red-team" color="red" max="16">Red</team>
        <team id="blue-team" color="blue" max="16">Blue</team>
    </teams>
    <filters>
        <team id="only-red">red-team</team>
        <not id="not-red">
            <team>red-team</team>
        </not>
        <team id="only-blue">blue-team</team>
        <not id="not-blue">
            <team>blue-team</team>
        </not>
    </filters>
    <spawns>
        <default yaw="90">
            <region>
                <point>0.5,80,0.5</point>
            </region>
        </default>
        <spawn team="red-team" kit="spawn-kit" yaw="270">
            <region>
                <point>-83.5,99,-17.5</point>
            </region>
        </spawn>
        <spawn team="blue-team" kit="spawn-kit" yaw="90">
            <region>
                <point>83.5,99,17.5</point>
            </region>
        </spawn>
    </spawns>
    <regions>
        <union id="red-spawn">
            <cuboid min="-90,0,-24" max="-77,256,-11"/>
            <cuboid min="-118,0,-26" max="-103,256,-3"/>
        </union>
        <apply enter="only-red" region="red-spawn" message="You may not enter the enemy spawn!"/>
        <apply block="never" region="red-spawn" message="You may not build in a spawn!"/>
        <union id="blue-spawn">
            <cuboid min="77,0,11" max="90,256,24"/>
            <cuboid min="103,0,3" max="118,256,26"/>
        </union>
        <apply enter="only-blue" region="blue-spawn" message="You may not enter the enemy spawn!"/>
        <apply block="never" region="blue-spawn" message="You may not build in a spawn!"/>
        <cuboid min="-78,99,-27" max="-75,102,-24" id="red-lift-top"/>
        <cuboid min="75,99,24" max="78,102,27" id="blue-lift-top"/>
        <cuboid min="-115,22,-22" max="-112,25,-19" id="red-lift-low"/>
        <cuboid min="112,22,19" max="115,25,22" id="blue-lift-low"/>
        <cuboid min="-54,106,-70" max="-53,108,-69" id="red-eyrie-region"/>
        <cuboid min="53,106,69" max="54,108,70" id="blue-eyrie-region"/>
        <cuboid min="-66,23,16" max="-65,25,17" id="red-echoes-region"/>
        <cuboid min="65,23,-17" max="66,25,-16" id="blue-echoes-region"/>
    </regions>
    <portals>
        <portal region="red-lift-top" x="@-111.5" y="@22" z="@-13.5" yaw="@90" filter="only-red"/>
        <portal region="blue-lift-top" x="@111.5" y="@22" z="@13.5" yaw="@270" filter="only-blue"/>
        <portal region="red-lift-low" x="@-83.5" y="@99" z="@-17.5" yaw="@270" filter="only-red"/>
        <portal region="blue-lift-low" x="@83.5" y="@99" z="@17.5" yaw="@90" filter="only-blue"/>
    </portals>
    <destroyables>
        <destroyable id="red-eyrie" name="the Eyrie" owner="red-team" materials="obsidian" completion="100%" mode-changes="true" region="red-eyrie-region"/>
        <destroyable id="blue-eyrie" name="the Eyrie" owner="blue-team" materials="obsidian" completion="100%" mode-changes="true" region="blue-eyrie-region"/>
        <destroyable id="red-echoes" name="the Hall of Echoes" owner="red-team" materials="obsidian" completion="100%" mode-changes="true" region="red-echoes-region"/>
        <destroyable id="blue-echoes" name="the Hall of Echoes" owner="blue-team" materials="obsidian" completion="100%" mode-changes="true" region="blue-echoes-region"/>
    </destroyables>
    <maxbuildheight>112</maxbuildheight>
    <block-drops>
        <rule>
            <filter>
                <any>
                    <material>wood</material>
                    <material>wool</material>
                </any>
            </filter>
            <drops>
                <item material="wood" chance="0"/>
            </drops>
        </rule>
    </block-drops>
    <itemkeep>
        <item>iron sword</item>
        <item>bow</item>
        <item>diamond pickaxe</item>
        <item>iron axe</item>
        <item>golden apple</item>
        <item>water bucket</item>
        <item>arrow</item>
        <item>wood</item>
        <item>wool</item>
        <item>cooked beef</item>
    </itemkeep>
    <itemremove>
        <item>leather helmet</item>
        <item>iron chestplate</item>
        <item>chainmail leggings</item>
        <item>leather boots</item>
        <item>obsidian</item>
        <item>flint</item>
        <item>gravel</item>
        <item>sapling</item>
        <item>apple</item>
        <item>seeds</item>
        <item>long grass</item>
        <item>yellow flower</item>
        <item>red rose</item>
        <item>brown mushroom</item>
        <item>red mushroom</item>
        <item>sugar cane</item>
        <item>vine</item>
    </itemremove>
    <toolrepair>
        <tool>iron sword</tool>
        <tool>bow</tool>
        <tool>diamond pickaxe</tool>
        <tool>iron axe</tool>
    </toolrepair>
    <kill-rewards>
        <kill-reward>
            <item material="wood" amount="16"/>
            <item material="wool" amount="8" team-color="true"/>
        </kill-reward>
    </kill-rewards>
    <hunger>
        <depletion>off</depletion>
    </hunger>
</map>

