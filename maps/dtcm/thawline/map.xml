<map proto="1.5.0">
    <name>Thawline</name>
    <version>1.0.0</version>
    <objective>Leak the enemy's Heart and break their Lantern.</objective>
    <gamemode>dtc</gamemode>
    <gamemode>dtm</gamemode>
    <include id="gapple-kill-reward"/>
    <authors>
        <author>Claude Opus 5.5 (freeform generator, on pgmvox)</author>
    </authors>
    <kits>
        <kit id="spawn-kit">
            <item slot="0" material="iron sword" unbreakable="true"/>
            <item slot="1" material="bow" unbreakable="true">
                <enchantment level="1">infinity</enchantment>
            </item>
            <item slot="2" material="diamond pickaxe" unbreakable="true">
                <enchantment level="2">efficiency</enchantment>
            </item>
            <item slot="3" material="iron axe" unbreakable="true">
                <enchantment level="1">efficiency</enchantment>
            </item>
            <item slot="4" material="wood" amount="64" damage="1"/>
            <item slot="5" material="stained clay" amount="64" team-color="true"/>
            <item slot="6" material="golden apple"/>
            <item slot="7" material="water bucket"/>
            <item slot="8" material="cooked beef" amount="16"/>
            <item slot="28" material="arrow"/>
            <item slot="29" material="shears" unbreakable="true"/>
            <item slot="30" material="stained glass" amount="32" team-color="true"/>
            <item slot="31" material="wood" amount="64" damage="1"/>
            <helmet material="leather helmet" unbreakable="true" team-color="true"/>
            <chestplate material="leather chestplate" unbreakable="true" team-color="true"/>
            <leggings material="chainmail leggings" unbreakable="true"/>
            <boots material="leather boots" unbreakable="true" team-color="true"/>
        </kit>
    </kits>
    <teams>
        <team id="frost-team" color="aqua" max="20">Frost</team>
        <team id="ember-team" color="gold" max="20">Ember</team>
    </teams>
    <filters>
        <team id="only-frost">frost-team</team>
        <not id="not-frost">
            <team>frost-team</team>
        </not>
        <team id="only-ember">ember-team</team>
        <not id="not-ember">
            <team>ember-team</team>
        </not>
        <not id="block-place-void-filter">
            <void/>
        </not>
        <any id="block-break-void-filter">
            <all>
                <any>
                    <material>log</material>
                    <material>log 2</material>
                    <material>leaves</material>
                    <material>leaves 2</material>
                    <material>long grass</material>
                    <material>yellow flower</material>
                    <material>red rose</material>
                    <material>double plant</material>
                    <material>water lily</material>
                    <material>vine</material>
                </any>
                <void/>
            </all>
            <filter id="block-place-void-filter"/>
        </any>
    </filters>
    <spawns>
        <spawn team="frost-team" kit="spawn-kit" yaw="0">
            <region>
                <point>0.5,54,-81.5</point>
            </region>
        </spawn>
        <spawn team="ember-team" kit="spawn-kit" yaw="180">
            <region>
                <point>-0.5,54,81.5</point>
            </region>
        </spawn>
        <default yaw="90">
            <region>
                <point>0.5,92,0.5</point>
            </region>
        </default>
    </spawns>
    <regions>
        <cuboid min="-13,54,-93" max="13,63,-78" id="frost-spawn"/>
        <apply enter="only-frost" region="frost-spawn" message="You may not enter the enemy spawn!"/>
        <apply block="never" region="frost-spawn" message="You may not build in a spawn!"/>
        <cuboid min="-13,54,78" max="13,63,93" id="ember-spawn"/>
        <apply enter="only-ember" region="ember-spawn" message="You may not enter the enemy spawn!"/>
        <apply block="never" region="ember-spawn" message="You may not build in a spawn!"/>
        <cuboid min="-38,48,-58" max="-33,53,-53" id="frost-heart-region"/>
        <cuboid min="33,48,53" max="38,53,58" id="ember-heart-region"/>
        <cuboid min="31,52,-55" max="32,55,-54" id="frost-lantern-region"/>
        <cuboid min="-32,52,54" max="-31,55,55" id="ember-lantern-region"/>
        <apply block-place="block-place-void-filter" block-break="block-break-void-filter" message="You may not edit the void!"/>
    </regions>
    <cores>
        <core id="frost-heart" name="Frost Heart" team="frost-team" leak="5" mode-changes="true" region="frost-heart-region"/>
        <core id="ember-heart" name="Ember Heart" team="ember-team" leak="5" mode-changes="true" region="ember-heart-region"/>
    </cores>
    <destroyables>
        <destroyable id="frost-lantern" name="Frost Lantern" owner="frost-team" materials="obsidian" completion="100%" mode-changes="true" region="frost-lantern-region"/>
        <destroyable id="ember-lantern" name="Ember Lantern" owner="ember-team" materials="obsidian" completion="100%" mode-changes="true" region="ember-lantern-region"/>
    </destroyables>
    <gamerules>
        <doFireTick>false</doFireTick>
    </gamerules>
    <maxbuildheight>82</maxbuildheight>
    <portals>
        <portal y="@-64" sound="false" observers="never">
            <region>
                <below y="28"/>
            </region>
        </portal>
    </portals>
    <block-drops>
        <rule>
            <filter>
                <any>
                    <material>wood</material>
                    <material>stained clay</material>
                    <material>stained glass</material>
                </any>
            </filter>
            <drops>
                <item material="wood" chance="0"/>
            </drops>
        </rule>
    </block-drops>
    <itemkeep>
        <item>iron sword</item>
        <item>bow</item>
        <item>diamond pickaxe</item>
        <item>iron axe</item>
        <item>golden apple</item>
        <item>water bucket</item>
        <item>arrow</item>
        <item>shears</item>
        <item>wood</item>
        <item>stained clay</item>
        <item>cooked beef</item>
        <item>stained glass</item>
    </itemkeep>
    <itemremove>
        <item>leather helmet</item>
        <item>leather chestplate</item>
        <item>chainmail leggings</item>
        <item>leather boots</item>
        <item>obsidian</item>
        <item>flint</item>
        <item>gravel</item>
        <item>sapling</item>
        <item>apple</item>
        <item>seeds</item>
        <item>long grass</item>
        <item>brown mushroom</item>
        <item>red mushroom</item>
        <item>pumpkin</item>
    </itemremove>
    <toolrepair>
        <tool>iron sword</tool>
        <tool>bow</tool>
        <tool>diamond pickaxe</tool>
        <tool>iron axe</tool>
        <tool>shears</tool>
    </toolrepair>
    <kill-rewards>
        <kill-reward>
            <item material="wood" amount="16" damage="1"/>
            <item material="stained clay" amount="8" team-color="true"/>
            <item material="stained glass" amount="8" team-color="true"/>
        </kill-reward>
    </kill-rewards>
    <hunger>
        <depletion>off</depletion>
    </hunger>
</map>

