<map proto="1.5.0">
    <name>Sonnet Holdfast</name>
    <version>1.0.0</version>
    <gamemode>ctw</gamemode>
    <objective>Capture the enemies' wools!</objective>
    <include id="gapple-kill-reward"/>
    <teams>
        <team id="red-team" color="red" max="16">Red</team>
        <team id="blue-team" color="blue" max="16">Blue</team>
    </teams>
    <kits>
        <kit id="spawn-kit">
            <item slot="0" material="iron sword" unbreakable="true"/>
            <item slot="1" material="bow" unbreakable="true">
                <enchantment level="1">infinity</enchantment>
            </item>
            <item slot="2" material="iron pickaxe" unbreakable="true">
                <enchantment level="1">efficiency</enchantment>
            </item>
            <item slot="3" material="iron axe" unbreakable="true">
                <enchantment level="1">efficiency</enchantment>
            </item>
            <item slot="4" material="wood" amount="64"/>
            <item slot="5" material="stained clay" amount="32" team-color="true"/>
            <item slot="7" material="water bucket"/>
            <item slot="8" material="golden apple"/>
            <item slot="28" material="arrow"/>
            <item slot="29" material="shears" unbreakable="true"/>
            <item slot="30" material="iron spade" unbreakable="true"/>
            <helmet material="leather helmet" unbreakable="true" team-color="true">
                <enchantment level="1">projectile_protection</enchantment>
            </helmet>
            <chestplate material="leather chestplate" unbreakable="true" team-color="true">
                <enchantment level="1">projectile_protection</enchantment>
            </chestplate>
            <leggings material="chainmail leggings" unbreakable="true">
                <enchantment level="1">projectile_protection</enchantment>
            </leggings>
            <boots material="leather boots" unbreakable="true" team-color="true">
                <enchantment level="1">projectile_protection</enchantment>
            </boots>
            <effect duration="oo" amplifier="100">damage resistance</effect>
        </kit>
        <kit id="reset-resistance-kit" force="true">
            <effect duration="0" amplifier="0">damage resistance</effect>
        </kit>
    </kits>
    <spawns>
        <default region="observer-spawn"/>
        <spawn team="red-team" kit="spawn-kit" region="red-spawn-point"/>
        <spawn team="blue-team" kit="spawn-kit" yaw="180" region="blue-spawn-point"/>
    </spawns>
    <destroyables>
        <destroyable id="holdfast-cairn" name="Holdfast Cairn" owner="red-team" materials="ender stone" region="holdfast-cairn-region"/>
        <destroyable id="holdfast-cairn-2" name="Holdfast Cairn" owner="blue-team" materials="ender stone" region="holdfast-cairn-2-region"/>
    </destroyables>
    <filters>
        <team id="only-red">red-team</team>
        <team id="only-blue">blue-team</team>
        <not id="no-void">
            <void/>
        </not>
    </filters>
    <regions>
        <point id="red-spawn-point">0,11,-165</point>
        <point id="blue-spawn-point">0,11,165</point>
        <point id="observer-spawn">0,25,0</point>
        <rectangle id="red-spawn" min="-30,-180" max="30,-150"/>
        <rectangle id="blue-spawn" min="-30,150" max="30,180"/>
        <cuboid id="holdfast-cairn-region" min="-1,13,-66" max="2,16,-63"/>
        <cuboid id="holdfast-cairn-2-region" min="-1,13,64" max="2,16,67"/>
        <union id="spawns">
            <region id="red-spawn"/>
            <region id="blue-spawn"/>
        </union>
        <negative id="not-spawns">
            <region id="spawns"/>
        </negative>
        <negative id="not-build-area">
            <union id="build-area">
                <rectangle id="build-area-1" min="20,-55" max="80,-35"/>
                <rectangle id="build-area-2" min="-80,35" max="-20,55"/>
            </union>
        </negative>
        <apply enter="only-red" region="red-spawn" message="You may not enter the enemy's spawn!"/>
        <apply enter="only-blue" region="blue-spawn" message="You may not enter the enemy's spawn!"/>
        <apply block="never" region="spawns" message="You may not block/break spawns!"/>
        <apply kit="reset-resistance-kit" region="not-spawns"/>
        <apply block="no-void" region="not-build-area" message="You may not edit the void!"/>
    </regions>
    <block-drops>
        <rule>
            <filter>
                <any>
                    <material>wood</material>
                    <material>stained clay</material>
                </any>
            </filter>
            <drops>
                <item material="wood" chance="0"/>
            </drops>
        </rule>
    </block-drops>
    <itemkeep>
        <item>iron sword</item>
        <item>bow</item>
        <item>iron pickaxe</item>
        <item>iron axe</item>
        <item>water bucket</item>
        <item>golden apple</item>
        <item>arrow</item>
        <item>shears</item>
        <item>iron spade</item>
        <item>wood</item>
        <item>stained clay</item>
    </itemkeep>
    <itemremove>
        <item>leather helmet</item>
        <item>leather chestplate</item>
        <item>chainmail leggings</item>
        <item>leather boots</item>
    </itemremove>
    <toolrepair>
        <tool>iron sword</tool>
        <tool>bow</tool>
        <tool>iron pickaxe</tool>
        <tool>iron axe</tool>
        <tool>shears</tool>
        <tool>iron spade</tool>
    </toolrepair>
    <kill-rewards>
        <kill-reward>
            <item material="wood" amount="16"/>
            <item material="stained clay" amount="8" team-color="true"/>
        </kill-reward>
    </kill-rewards>
    <hunger>
        <depletion>off</depletion>
    </hunger>
    <maxbuildheight>20</maxbuildheight>
</map>
