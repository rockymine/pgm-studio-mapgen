<map proto="1.5.0">
    <name>Interchange</name>
    <version>1.0.0</version>
    <gamemode>dtm</gamemode>
    <objective>Destroy the enemy's monuments!</objective>
    <include id="gapple-kill-reward"/>
    <authors>
        <author>Opus 5</author>
    </authors>
    <teams>
        <team id="red-team" color="red" max="24">Red</team>
        <team id="blue-team" color="blue" max="24">Blue</team>
    </teams>
    <kits>
        <kit id="spawn-kit">
            <clear/>
            <item slot="0" material="iron sword" unbreakable="true"/>
            <item slot="1" material="bow" unbreakable="true">
                <enchantment level="1">infinity</enchantment>
            </item>
            <item slot="2" material="diamond pickaxe" unbreakable="true">
                <enchantment level="1">efficiency</enchantment>
            </item>
            <item slot="3" material="iron axe" unbreakable="true">
                <enchantment level="1">efficiency</enchantment>
            </item>
            <item slot="4" material="wood" amount="64"/>
            <item slot="5" material="stained clay" amount="32" team-color="true"/>
            <item slot="7" material="water bucket"/>
            <item slot="8" material="golden apple"/>
            <item slot="28" material="arrow"/>
            <item slot="29" material="shears" unbreakable="true"/>
            <item slot="30" material="iron spade" unbreakable="true"/>
            <helmet material="leather helmet" unbreakable="true" team-color="true">
                <enchantment level="1">projectile_protection</enchantment>
            </helmet>
            <chestplate material="leather chestplate" unbreakable="true" team-color="true">
                <enchantment level="1">projectile_protection</enchantment>
            </chestplate>
            <leggings material="chainmail leggings" unbreakable="true">
                <enchantment level="1">projectile_protection</enchantment>
            </leggings>
            <boots material="leather boots" unbreakable="true" team-color="true">
                <enchantment level="1">projectile_protection</enchantment>
            </boots>
            <effect duration="oo" amplifier="100">damage resistance</effect>
        </kit>
        <kit id="reset-resistance-kit" force="true">
            <effect duration="0" amplifier="0">damage resistance</effect>
        </kit>
    </kits>
    <spawns>
        <default region="observer-spawn"/>
        <spawn team="red-team" kit="spawn-kit" yaw="180" region="red-spawn-point"/>
        <spawn team="blue-team" kit="spawn-kit" region="blue-spawn-point"/>
    </spawns>
    <destroyables>
        <destroyable id="the-deep-end" name="The Deep End" owner="red-team" materials="obsidian" region="the-deep-end-region"/>
        <destroyable id="the-catwalk" name="The Catwalk" owner="red-team" materials="obsidian" region="the-catwalk-region"/>
        <destroyable id="the-back-office" name="The Back Office" owner="red-team" materials="obsidian" region="the-back-office-region"/>
        <destroyable id="level-4" name="Level 4" owner="red-team" materials="obsidian" region="level-4-region"/>
        <destroyable id="the-court" name="The Court" owner="red-team" materials="obsidian" region="the-court-region"/>
        <destroyable id="the-deep-end-2" name="The Deep End" owner="blue-team" materials="obsidian" region="the-deep-end-2-region"/>
        <destroyable id="the-catwalk-2" name="The Catwalk" owner="blue-team" materials="obsidian" region="the-catwalk-2-region"/>
        <destroyable id="the-back-office-2" name="The Back Office" owner="blue-team" materials="obsidian" region="the-back-office-2-region"/>
        <destroyable id="level-4-2" name="Level 4" owner="blue-team" materials="obsidian" region="level-4-2-region"/>
        <destroyable id="the-court-2" name="The Court" owner="blue-team" materials="obsidian" region="the-court-2-region"/>
    </destroyables>
    <filters>
        <team id="only-blue">blue-team</team>
        <team id="only-red">red-team</team>
    </filters>
    <regions>
        <point id="blue-spawn-point">0,18,-120</point>
        <point id="red-spawn-point">0,18,120</point>
        <point id="observer-spawn">0,34,0</point>
        <rectangle id="blue-spawn" min="-8,-124" max="8,-112"/>
        <rectangle id="red-spawn" min="-8,112" max="8,124"/>
        <cuboid id="the-deep-end-region" min="30,6,78" max="31,7,79"/>
        <cuboid id="the-catwalk-region" min="-38,28,68" max="-37,30,69"/>
        <cuboid id="the-back-office-region" min="34,22,62" max="35,23,63"/>
        <cuboid id="level-4-region" min="-26,42,50" max="-25,44,51"/>
        <cuboid id="the-court-region" min="24,22,90" max="25,24,91"/>
        <cuboid id="the-deep-end-2-region" min="-31,6,-79" max="-30,7,-78"/>
        <cuboid id="the-catwalk-2-region" min="37,28,-69" max="38,30,-68"/>
        <cuboid id="the-back-office-2-region" min="-35,22,-63" max="-34,23,-62"/>
        <cuboid id="level-4-2-region" min="25,42,-51" max="26,44,-50"/>
        <cuboid id="the-court-2-region" min="-25,22,-91" max="-24,24,-90"/>
        <union id="spawns">
            <region id="red-spawn"/>
            <region id="blue-spawn"/>
        </union>
        <negative id="not-spawns">
            <region id="spawns"/>
        </negative>
        <everywhere id="void-enforcement-area"/>
        <apply enter="only-red" region="red-spawn" message="You may not enter the enemy's spawn!"/>
        <apply enter="only-blue" region="blue-spawn" message="You may not enter the enemy's spawn!"/>
        <apply block="never" region="spawns" message="You may not block/break spawns!"/>
        <apply kit="reset-resistance-kit" region="not-spawns"/>
        <apply block-place="deny(void)" region="void-enforcement-area" message="You may not edit the void!"/>
    </regions>
    <block-drops>
        <rule>
            <filter>
                <any>
                    <material>wood</material>
                    <material>stained clay</material>
                </any>
            </filter>
            <drops>
                <item material="wood" chance="0"/>
            </drops>
        </rule>
    </block-drops>
    <itemkeep>
        <item>iron sword</item>
        <item>bow</item>
        <item>diamond pickaxe</item>
        <item>iron axe</item>
        <item>water bucket</item>
        <item>golden apple</item>
        <item>arrow</item>
        <item>shears</item>
        <item>iron spade</item>
        <item>wood</item>
        <item>stained clay</item>
    </itemkeep>
    <itemremove>
        <item>leather helmet</item>
        <item>leather chestplate</item>
        <item>chainmail leggings</item>
        <item>leather boots</item>
    </itemremove>
    <toolrepair>
        <tool>iron sword</tool>
        <tool>bow</tool>
        <tool>diamond pickaxe</tool>
        <tool>iron axe</tool>
        <tool>shears</tool>
        <tool>iron spade</tool>
    </toolrepair>
    <kill-rewards>
        <kill-reward>
            <item material="wood" amount="16"/>
            <item material="stained clay" amount="8" team-color="true"/>
        </kill-reward>
    </kill-rewards>
    <hunger>
        <depletion>off</depletion>
    </hunger>
    <maxbuildheight>58</maxbuildheight>
</map>
