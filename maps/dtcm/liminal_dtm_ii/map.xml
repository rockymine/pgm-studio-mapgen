<map proto="1.5.0">
    <name>Liminal DTM II</name>
    <version>1.0.0</version>
    <gamemode>dtm</gamemode>
    <objective>Destroy the enemy's monuments!</objective>
    <created>2026-08-26</created>
    <phase>development</phase>
    <include id="gapple-kill-reward"/>
    <authors>
        <author>Opus 5</author>
    </authors>
    <teams>
        <team id="red-team" color="red" max="24">Red</team>
        <team id="blue-team" color="blue" max="24">Blue</team>
    </teams>
    <kits>
        <kit id="spawn-kit">
            <clear/>
            <item slot="0" material="iron sword" unbreakable="true"/>
            <item slot="1" material="bow" unbreakable="true">
                <enchantment level="1">infinity</enchantment>
            </item>
            <item slot="2" material="diamond pickaxe" unbreakable="true">
                <enchantment level="1">efficiency</enchantment>
            </item>
            <item slot="3" material="iron axe" unbreakable="true">
                <enchantment level="1">efficiency</enchantment>
            </item>
            <item slot="4" material="wood" amount="64"/>
            <item slot="5" material="stained clay" amount="32" team-color="true"/>
            <item slot="7" material="water bucket"/>
            <item slot="8" material="golden apple"/>
            <item slot="28" material="arrow"/>
            <item slot="29" material="shears" unbreakable="true"/>
            <item slot="30" material="iron spade" unbreakable="true"/>
            <helmet material="leather helmet" unbreakable="true" team-color="true">
                <enchantment level="1">projectile_protection</enchantment>
            </helmet>
            <chestplate material="leather chestplate" unbreakable="true" team-color="true">
                <enchantment level="1">projectile_protection</enchantment>
            </chestplate>
            <leggings material="chainmail leggings" unbreakable="true">
                <enchantment level="1">projectile_protection</enchantment>
            </leggings>
            <boots material="leather boots" unbreakable="true" team-color="true">
                <enchantment level="1">projectile_protection</enchantment>
            </boots>
            <effect duration="oo" amplifier="100">damage resistance</effect>
        </kit>
        <kit id="reset-resistance-kit" force="true">
            <effect duration="0" amplifier="0">damage resistance</effect>
        </kit>
    </kits>
    <spawns>
        <default region="observer-spawn"/>
        <spawn team="red-team" kit="spawn-kit" yaw="90" region="red-spawn-point"/>
        <spawn team="blue-team" kit="spawn-kit" yaw="270" region="blue-spawn-point"/>
    </spawns>
    <destroyables>
        <destroyable id="the-desert-well" name="The Desert Well" owner="red-team" materials="obsidian" region="the-desert-well-region"/>
        <destroyable id="the-deep-end" name="The Deep End" owner="red-team" materials="obsidian" region="the-deep-end-region"/>
        <destroyable id="the-floating-garden" name="The Floating Garden" owner="red-team" materials="obsidian" region="the-floating-garden-region"/>
        <destroyable id="the-desert-well-2" name="The Desert Well" owner="blue-team" materials="obsidian" region="the-desert-well-2-region"/>
        <destroyable id="the-deep-end-2" name="The Deep End" owner="blue-team" materials="obsidian" region="the-deep-end-2-region"/>
        <destroyable id="the-floating-garden-2" name="The Floating Garden" owner="blue-team" materials="obsidian" region="the-floating-garden-2-region"/>
    </destroyables>
    <filters>
        <team id="only-blue">blue-team</team>
        <team id="only-red">red-team</team>
    </filters>
    <regions>
        <point id="blue-spawn-point">-112,36,-70</point>
        <point id="red-spawn-point">112,36,70</point>
        <point id="observer-spawn">0,75,0</point>
        <rectangle id="blue-spawn" min="-124,-80" max="-104,-60"/>
        <rectangle id="red-spawn" min="104,60" max="124,80"/>
        <cuboid id="the-desert-well-region" min="56,40,32" max="57,42,33"/>
        <cuboid id="the-deep-end-region" min="80,15,8" max="81,17,9"/>
        <cuboid id="the-floating-garden-region" min="74,56,22" max="75,58,23"/>
        <cuboid id="the-desert-well-2-region" min="-57,40,-33" max="-56,42,-32"/>
        <cuboid id="the-deep-end-2-region" min="-81,15,-9" max="-80,17,-8"/>
        <cuboid id="the-floating-garden-2-region" min="-75,56,-23" max="-74,58,-22"/>
        <union id="spawns">
            <region id="red-spawn"/>
            <region id="blue-spawn"/>
        </union>
        <negative id="not-spawns">
            <region id="spawns"/>
        </negative>
        <everywhere id="void-enforcement-area"/>
        <apply enter="only-red" region="red-spawn" message="You may not enter the enemy's spawn!"/>
        <apply enter="only-blue" region="blue-spawn" message="You may not enter the enemy's spawn!"/>
        <apply block="never" region="spawns" message="You may not block/break spawns!"/>
        <apply kit="reset-resistance-kit" region="not-spawns"/>
        <apply block-place="deny(void)" region="void-enforcement-area" message="You may not edit the void!"/>
    </regions>
    <block-drops>
        <rule>
            <filter>
                <any>
                    <material>wood</material>
                    <material>stained clay</material>
                </any>
            </filter>
            <drops>
                <item material="wood" chance="0"/>
            </drops>
        </rule>
    </block-drops>
    <itemkeep>
        <item>iron sword</item>
        <item>bow</item>
        <item>diamond pickaxe</item>
        <item>iron axe</item>
        <item>water bucket</item>
        <item>golden apple</item>
        <item>arrow</item>
        <item>shears</item>
        <item>iron spade</item>
        <item>wood</item>
        <item>stained clay</item>
    </itemkeep>
    <itemremove>
        <item>leather helmet</item>
        <item>leather chestplate</item>
        <item>chainmail leggings</item>
        <item>leather boots</item>
    </itemremove>
    <toolrepair>
        <tool>iron sword</tool>
        <tool>bow</tool>
        <tool>diamond pickaxe</tool>
        <tool>iron axe</tool>
        <tool>shears</tool>
        <tool>iron spade</tool>
    </toolrepair>
    <kill-rewards>
        <kill-reward>
            <item material="wood" amount="16"/>
            <item material="stained clay" amount="8" team-color="true"/>
        </kill-reward>
    </kill-rewards>
    <hunger>
        <depletion>off</depletion>
    </hunger>
    <maxbuildheight>74</maxbuildheight>
</map>
