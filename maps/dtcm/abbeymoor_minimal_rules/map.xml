<map proto="1.5.0">
    <name>Abbeymoor</name>
    <version>1.0.0</version>
    <gamemode>dtm</gamemode>
    <objective>Destroy the enemy's monuments!</objective>
    <created>2026-10-10</created>
    <phase>development</phase>
    <include id="gapple-kill-reward"/>
    <authors>
        <author>Claude Sonnet 5.5</author>
    </authors>
    <contributors>
        <contributor uuid="fe3608b7-d105-4029-8800-34b3147065b6" contribution="Original builder of the copied trees"/>
        <!-- rockymine -->
    </contributors>
    <teams>
        <team id="red-team" color="red" max="16">Red</team>
        <team id="blue-team" color="blue" max="16">Blue</team>
    </teams>
    <kits>
        <kit id="spawn-kit">
            <clear/>
            <item slot="0" material="iron sword" unbreakable="true"/>
            <item slot="1" material="bow" unbreakable="true">
                <enchantment level="1">infinity</enchantment>
            </item>
            <item slot="2" material="diamond pickaxe" unbreakable="true">
                <enchantment level="1">efficiency</enchantment>
            </item>
            <item slot="3" material="iron axe" unbreakable="true">
                <enchantment level="1">efficiency</enchantment>
            </item>
            <item slot="4" material="wood" amount="64"/>
            <item slot="5" material="stained clay" amount="32" team-color="true"/>
            <item slot="7" material="water bucket"/>
            <item slot="8" material="golden apple"/>
            <item slot="28" material="arrow"/>
            <item slot="29" material="shears" unbreakable="true"/>
            <item slot="30" material="iron spade" unbreakable="true"/>
            <helmet material="leather helmet" unbreakable="true" team-color="true">
                <enchantment level="1">projectile_protection</enchantment>
            </helmet>
            <chestplate material="leather chestplate" unbreakable="true" team-color="true">
                <enchantment level="1">projectile_protection</enchantment>
            </chestplate>
            <leggings material="chainmail leggings" unbreakable="true">
                <enchantment level="1">projectile_protection</enchantment>
            </leggings>
            <boots material="leather boots" unbreakable="true" team-color="true">
                <enchantment level="1">projectile_protection</enchantment>
            </boots>
            <effect duration="oo" amplifier="100">damage resistance</effect>
        </kit>
        <kit id="reset-resistance-kit" force="true">
            <effect duration="0" amplifier="0">damage resistance</effect>
        </kit>
    </kits>
    <spawns>
        <default region="observer-spawn"/>
        <spawn team="red-team" kit="spawn-kit" yaw="270" region="red-spawn-point"/>
        <spawn team="blue-team" kit="spawn-kit" yaw="90" region="blue-spawn-point"/>
    </spawns>
    <modes>
        <mode id="mode-gold-block" after="15m" material="gold block"/>
        <mode id="mode-glass" after="20m" material="glass"/>
    </modes>
    <destroyables>
        <destroyable id="abbey-stone" name="Abbey Stone" owner="red-team" materials="obsidian" repairable="false" mode-changes="true" region="abbey-stone-region"/>
        <destroyable id="market-cross" name="Market Cross" owner="red-team" materials="gold block" repairable="false" mode-changes="true" region="market-cross-region"/>
        <destroyable id="abbey-stone-2" name="Abbey Stone" owner="blue-team" materials="obsidian" repairable="false" mode-changes="true" region="abbey-stone-2-region"/>
        <destroyable id="market-cross-2" name="Market Cross" owner="blue-team" materials="gold block" repairable="false" mode-changes="true" region="market-cross-2-region"/>
    </destroyables>
    <filters>
        <team id="only-blue">blue-team</team>
        <team id="only-red">red-team</team>
    </filters>
    <regions>
        <point id="blue-spawn-point">114,23,-4</point>
        <point id="red-spawn-point">-114,23,4</point>
        <point id="observer-spawn">0,38,0</point>
        <rectangle id="blue-spawn" min="104,-16" max="124,8"/>
        <rectangle id="red-spawn" min="-124,-8" max="-104,16"/>
        <cuboid id="abbey-stone-region" min="-74,39,-30" max="-73,42,-29"/>
        <cuboid id="market-cross-region" min="-61,24,27" max="-58,27,30"/>
        <cuboid id="abbey-stone-2-region" min="73,39,29" max="74,42,30"/>
        <cuboid id="market-cross-2-region" min="58,24,-30" max="61,27,-27"/>
        <union id="spawns">
            <region id="red-spawn"/>
            <region id="blue-spawn"/>
        </union>
        <negative id="not-spawns">
            <region id="spawns"/>
        </negative>
        <apply enter="only-red" region="red-spawn" message="You may not enter the enemy's spawn!"/>
        <apply enter="only-blue" region="blue-spawn" message="You may not enter the enemy's spawn!"/>
        <apply block="never" region="spawns" message="You may not block/break spawns!"/>
        <apply kit="reset-resistance-kit" region="not-spawns"/>
    </regions>
    <block-drops>
        <rule>
            <filter>
                <any>
                    <material>wood</material>
                    <material>stained clay</material>
                </any>
            </filter>
            <drops>
                <item material="wood" chance="0"/>
            </drops>
        </rule>
    </block-drops>
    <itemkeep>
        <item>iron sword</item>
        <item>bow</item>
        <item>diamond pickaxe</item>
        <item>iron axe</item>
        <item>water bucket</item>
        <item>golden apple</item>
        <item>arrow</item>
        <item>shears</item>
        <item>iron spade</item>
        <item>wood</item>
        <item>stained clay</item>
    </itemkeep>
    <itemremove>
        <item>leather helmet</item>
        <item>leather chestplate</item>
        <item>chainmail leggings</item>
        <item>leather boots</item>
        <item>obsidian</item>
        <item>gold block</item>
        <item>glass</item>
    </itemremove>
    <toolrepair>
        <tool>iron sword</tool>
        <tool>bow</tool>
        <tool>diamond pickaxe</tool>
        <tool>iron axe</tool>
        <tool>shears</tool>
        <tool>iron spade</tool>
    </toolrepair>
    <kill-rewards>
        <kill-reward>
            <item material="wood" amount="16"/>
            <item material="stained clay" amount="8" team-color="true"/>
        </kill-reward>
    </kill-rewards>
    <hunger>
        <depletion>off</depletion>
    </hunger>
    <maxbuildheight>44</maxbuildheight>
</map>
