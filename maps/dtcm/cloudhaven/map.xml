<map proto="1.5.0">
    <name>Cloudhaven</name>
    <version>0.1.0</version>
    <objective>Break both of the enemy's monuments: one under the gazebo on Lantern Isle, one in the sunken garden of the Hanging Gardens.</objective>
    <gamemode>dtm</gamemode>
    <include id="gapple-kill-reward"/>
    <authors>
        <author>Claude (freeform generator)</author>
    </authors>
    <contributors>
        <contributor contribution="Built the willow and dense oak trees (tree showcase)">rockymine</contributor>
    </contributors>
    <kits>
        <kit id="spawn-kit">
            <item slot="0" material="iron sword" unbreakable="true"/>
            <item slot="1" material="bow" unbreakable="true">
                <enchantment level="1">infinity</enchantment>
            </item>
            <item slot="2" material="diamond pickaxe" unbreakable="true"/>
            <item slot="3" material="iron axe" unbreakable="true"/>
            <item slot="4" material="wood" amount="64"/>
            <item slot="5" material="wool" amount="64" team-color="true"/>
            <item slot="27" material="wood" amount="64"/>
            <item slot="6" material="golden apple"/>
            <item slot="7" material="water bucket"/>
            <item slot="8" material="cooked beef" amount="16"/>
            <item slot="28" material="arrow"/>
            <helmet material="leather helmet" unbreakable="true" team-color="true"/>
            <chestplate material="iron chestplate" unbreakable="true"/>
            <leggings material="chainmail leggings" unbreakable="true"/>
            <boots material="leather boots" unbreakable="true" team-color="true"/>
        </kit>
    </kits>
    <teams>
        <team id="red-team" color="red" max="16">Red</team>
        <team id="blue-team" color="blue" max="16">Blue</team>
    </teams>
    <filters>
        <team id="only-red">red-team</team>
        <not id="not-red">
            <team>red-team</team>
        </not>
        <team id="only-blue">blue-team</team>
        <not id="not-blue">
            <team>blue-team</team>
        </not>
    </filters>
    <spawns>
        <default yaw="90">
            <region>
                <point>0.5,100,0.5</point>
            </region>
        </default>
        <spawn team="red-team" kit="spawn-kit" yaw="270">
            <region>
                <point>-109.5,94,0.5</point>
            </region>
        </spawn>
        <spawn team="blue-team" kit="spawn-kit" yaw="90">
            <region>
                <point>109.5,94,-0.5</point>
            </region>
        </spawn>
    </spawns>
    <regions>
        <cuboid min="-117,0,-7" max="-102,256,8" id="red-spawn"/>
        <apply enter="only-red" region="red-spawn" message="You may not enter the enemy spawn!"/>
        <apply block="never" region="red-spawn" message="You may not build in a spawn!"/>
        <cuboid min="102,0,-8" max="117,256,7" id="blue-spawn"/>
        <apply enter="only-blue" region="blue-spawn" message="You may not enter the enemy spawn!"/>
        <apply block="never" region="blue-spawn" message="You may not build in a spawn!"/>
        <cuboid min="-72,83,-60" max="-71,85,-59" id="red-lantern-region"/>
        <cuboid min="71,83,59" max="72,85,60" id="blue-lantern-region"/>
        <cuboid min="-71,63,59" max="-70,65,60" id="red-gardens-region"/>
        <cuboid min="70,63,-60" max="71,65,-59" id="blue-gardens-region"/>
    </regions>
    <destroyables>
        <destroyable id="red-lantern" name="Lantern Isle" owner="red-team" materials="obsidian" completion="100%" mode-changes="true" region="red-lantern-region"/>
        <destroyable id="blue-lantern" name="Lantern Isle" owner="blue-team" materials="obsidian" completion="100%" mode-changes="true" region="blue-lantern-region"/>
        <destroyable id="red-gardens" name="Hanging Gardens" owner="red-team" materials="obsidian" completion="100%" mode-changes="true" region="red-gardens-region"/>
        <destroyable id="blue-gardens" name="Hanging Gardens" owner="blue-team" materials="obsidian" completion="100%" mode-changes="true" region="blue-gardens-region"/>
    </destroyables>
    <maxbuildheight>116</maxbuildheight>
    <block-drops>
        <rule>
            <filter>
                <any>
                    <material>wood</material>
                    <material>wool</material>
                </any>
            </filter>
            <drops>
                <item material="wood" chance="0"/>
            </drops>
        </rule>
    </block-drops>
    <itemkeep>
        <item>iron sword</item>
        <item>bow</item>
        <item>diamond pickaxe</item>
        <item>iron axe</item>
        <item>golden apple</item>
        <item>water bucket</item>
        <item>arrow</item>
        <item>wood</item>
        <item>wool</item>
        <item>cooked beef</item>
    </itemkeep>
    <itemremove>
        <item>leather helmet</item>
        <item>iron chestplate</item>
        <item>chainmail leggings</item>
        <item>leather boots</item>
        <item>obsidian</item>
    </itemremove>
    <toolrepair>
        <tool>iron sword</tool>
        <tool>bow</tool>
        <tool>diamond pickaxe</tool>
        <tool>iron axe</tool>
    </toolrepair>
    <kill-rewards>
        <kill-reward>
            <item material="wood" amount="16"/>
            <item material="wool" amount="8" team-color="true"/>
        </kill-reward>
    </kill-rewards>
    <hunger>
        <depletion>off</depletion>
    </hunger>
</map>

