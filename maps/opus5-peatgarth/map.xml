<map proto="1.5.0">
    <name>Peatgarth</name>
    <version>1.0.0</version>
    <gamemode>dtm</gamemode>
    <objective>Destroy the enemy's monument!</objective>
    <created>2026-09-14</created>
    <phase>development</phase>
    <include id="gapple-kill-reward"/>
    <authors>
        <author>Opus 5</author>
    </authors>
    <teams>
        <team id="red-team" color="red" max="20">Red</team>
        <team id="blue-team" color="blue" max="20">Blue</team>
    </teams>
    <kits>
        <kit id="spawn-kit">
            <clear/>
            <item slot="0" material="iron sword" unbreakable="true"/>
            <item slot="1" material="bow" unbreakable="true">
                <enchantment level="1">infinity</enchantment>
            </item>
            <item slot="2" material="iron pickaxe" unbreakable="true">
                <enchantment level="1">efficiency</enchantment>
            </item>
            <item slot="3" material="iron axe" unbreakable="true">
                <enchantment level="1">efficiency</enchantment>
            </item>
            <item slot="4" material="wood" amount="64"/>
            <item slot="5" material="stained clay" amount="32" team-color="true"/>
            <item slot="7" material="water bucket"/>
            <item slot="8" material="golden apple"/>
            <item slot="28" material="arrow"/>
            <item slot="29" material="shears" unbreakable="true"/>
            <item slot="30" material="iron spade" unbreakable="true"/>
            <helmet material="leather helmet" unbreakable="true" team-color="true">
                <enchantment level="1">projectile_protection</enchantment>
            </helmet>
            <chestplate material="leather chestplate" unbreakable="true" team-color="true">
                <enchantment level="1">projectile_protection</enchantment>
            </chestplate>
            <leggings material="chainmail leggings" unbreakable="true">
                <enchantment level="1">projectile_protection</enchantment>
            </leggings>
            <boots material="leather boots" unbreakable="true" team-color="true">
                <enchantment level="1">projectile_protection</enchantment>
            </boots>
            <effect duration="oo" amplifier="100">damage resistance</effect>
        </kit>
        <kit id="reset-resistance-kit" force="true">
            <effect duration="0" amplifier="0">damage resistance</effect>
        </kit>
    </kits>
    <spawns>
        <default region="observer-spawn"/>
        <spawn team="red-team" kit="spawn-kit" yaw="180" region="red-spawn-point"/>
        <spawn team="blue-team" kit="spawn-kit" region="blue-spawn-point"/>
    </spawns>
    <modes>
        <mode id="mode-gold-block" after="15m" material="gold block"/>
        <mode id="mode-glass" after="20m" material="glass"/>
    </modes>
    <destroyables>
        <destroyable id="peat-store" name="Peat Store" owner="red-team" materials="emerald block" repairable="false" mode-changes="true" region="peat-store-region"/>
        <destroyable id="peat-store-2" name="Peat Store" owner="blue-team" materials="emerald block" repairable="false" mode-changes="true" region="peat-store-2-region"/>
    </destroyables>
    <filters>
        <team id="only-blue">blue-team</team>
        <team id="only-red">red-team</team>
        <any id="block-break-void-filter">
            <all>
                <any>
                    <material>log</material>
                    <material>log 2</material>
                    <material>leaves</material>
                    <material>leaves 2</material>
                    <material>long grass</material>
                    <material>yellow flower</material>
                    <material>red rose</material>
                    <material>double plant</material>
                    <material>water lily</material>
                    <material>vine</material>
                </any>
                <void/>
            </all>
            <filter id="block-place-void-filter"/>
        </any>
        <not id="block-place-void-filter">
            <void/>
        </not>
        <material id="only-air">air</material>
        <material id="only-iron">iron block</material>
        <all id="only-iron-cause-world">
            <material>iron block</material>
            <cause>world</cause>
        </all>
    </filters>
    <regions>
        <point id="blue-spawn-point">0,14,-92</point>
        <point id="red-spawn-point">0,14,92</point>
        <point id="observer-spawn">0,57,0</point>
        <rectangle id="blue-spawn" min="-15,-100" max="15,-80"/>
        <rectangle id="red-spawn" min="-15,80" max="15,100"/>
        <cuboid id="peat-store-region" min="-13,23,51" max="-10,26,54"/>
        <cuboid id="peat-store-2-region" min="10,23,-54" max="13,26,-51"/>
        <union id="spawns">
            <region id="red-spawn"/>
            <region id="blue-spawn"/>
        </union>
        <union id="iron-cubes">
            <rectangle id="iron-cube-0" min="2,81" max="4,83"/>
            <rectangle id="iron-cube-1" min="-5,-84" max="-3,-82"/>
        </union>
        <negative id="not-spawns">
            <region id="spawns"/>
        </negative>
        <negative id="not-build-area">
            <rectangle id="build-area-1" min="-40,-10" max="40,10"/>
        </negative>
        <everywhere id="void-enforcement-area"/>
        <apply enter="only-red" region="red-spawn" message="You may not enter the enemy's spawn!"/>
        <apply enter="only-blue" region="blue-spawn" message="You may not enter the enemy's spawn!"/>
        <apply kit="reset-resistance-kit" region="not-spawns"/>
        <apply block-place="deny(void)" region="void-enforcement-area" message="You may not edit the void!"/>
        <apply block-place="only-iron-cause-world" block-break="only-iron" region="spawns" message="You may not edit spawn!"/>
        <apply block-place="block-place-void-filter" block-break="block-break-void-filter" region="not-build-area" message="You may not edit the void!"/>
    </regions>
    <renewables>
        <renewable region="iron-cubes" renew-filter="only-iron" replace-filter="only-air" avoid-players="2"/>
    </renewables>
    <block-drops>
        <rule>
            <filter>
                <any>
                    <material>wood</material>
                    <material>stained clay</material>
                </any>
            </filter>
            <drops>
                <item material="wood" chance="0"/>
            </drops>
        </rule>
    </block-drops>
    <itemkeep>
        <item>iron sword</item>
        <item>bow</item>
        <item>iron pickaxe</item>
        <item>iron axe</item>
        <item>water bucket</item>
        <item>golden apple</item>
        <item>arrow</item>
        <item>shears</item>
        <item>iron spade</item>
        <item>wood</item>
        <item>stained clay</item>
    </itemkeep>
    <itemremove>
        <item>leather helmet</item>
        <item>leather chestplate</item>
        <item>chainmail leggings</item>
        <item>leather boots</item>
        <item>emerald block</item>
        <item>gold block</item>
        <item>glass</item>
    </itemremove>
    <toolrepair>
        <tool>iron sword</tool>
        <tool>bow</tool>
        <tool>iron pickaxe</tool>
        <tool>iron axe</tool>
        <tool>shears</tool>
        <tool>iron spade</tool>
    </toolrepair>
    <kill-rewards>
        <kill-reward>
            <item material="wood" amount="16"/>
            <item material="stained clay" amount="8" team-color="true"/>
        </kill-reward>
    </kill-rewards>
    <hunger>
        <depletion>off</depletion>
    </hunger>
    <maxbuildheight>49</maxbuildheight>
</map>
