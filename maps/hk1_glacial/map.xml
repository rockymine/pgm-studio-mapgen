<map proto="1.5.0">
    <name>Glacial</name>
    <version>1.0.0</version>
    <gamemode>ctw</gamemode>
    <objective>Frozen monuments stand on an icy plateau. Shatter the enemy's stone.</objective>
    <authors>
        <author>haiku</author>
    </authors>
    <teams>
        <team id="red-team" color="red" max="15">Red</team>
        <team id="blue-team" color="blue" max="15">Blue</team>
    </teams>
    <kits>
        <kit id="spawn-kit">
            <item slot="0" material="iron sword" unbreakable="true"/>
            <item slot="1" material="bow" unbreakable="true">
                <enchantment level="1">infinity</enchantment>
            </item>
            <item slot="2" material="iron pickaxe" unbreakable="true">
                <enchantment level="1">efficiency</enchantment>
            </item>
            <item slot="3" material="iron axe" unbreakable="true">
                <enchantment level="1">efficiency</enchantment>
            </item>
            <item slot="4" material="wood" amount="64"/>
            <item slot="5" material="stained clay" amount="32" team-color="true"/>
            <item slot="7" material="water bucket"/>
            <item slot="8" material="golden apple"/>
            <item slot="28" material="arrow"/>
            <item slot="29" material="shears" unbreakable="true"/>
            <item slot="30" material="iron spade" unbreakable="true"/>
            <helmet material="leather helmet" unbreakable="true" team-color="true">
                <enchantment level="1">projectile_protection</enchantment>
            </helmet>
            <chestplate material="leather chestplate" unbreakable="true" team-color="true">
                <enchantment level="1">projectile_protection</enchantment>
            </chestplate>
            <leggings material="chainmail leggings" unbreakable="true">
                <enchantment level="1">projectile_protection</enchantment>
            </leggings>
            <boots material="leather boots" unbreakable="true" team-color="true">
                <enchantment level="1">projectile_protection</enchantment>
            </boots>
            <effect duration="oo" amplifier="100">damage resistance</effect>
        </kit>
        <kit id="reset-resistance-kit" force="true">
            <effect duration="0" amplifier="0">damage resistance</effect>
        </kit>
    </kits>
    <spawns>
        <default region="observer-spawn"/>
        <spawn team="red-team" kit="spawn-kit" yaw="180" region="red-spawn-point"/>
        <spawn team="blue-team" kit="spawn-kit" region="blue-spawn-point"/>
    </spawns>
    <destroyables>
        <destroyable id="red-monument" name="Red Monument" owner="red-team" materials="obsidian" region="red-monument-region"/>
        <destroyable id="red-monument-2" name="Red Monument 2" owner="red-team" materials="obsidian" region="red-monument-2-region"/>
        <destroyable id="blue-monument" name="Blue Monument" owner="blue-team" materials="obsidian" region="blue-monument-region"/>
        <destroyable id="blue-monument-2" name="Blue Monument 2" owner="blue-team" materials="obsidian" region="blue-monument-2-region"/>
    </destroyables>
    <filters>
        <team id="only-red">red-team</team>
        <team id="only-blue">blue-team</team>
        <not id="no-void">
            <void/>
        </not>
    </filters>
    <regions>
        <point id="red-spawn-point">-50,14,70</point>
        <point id="blue-spawn-point">50,14,-70</point>
        <point id="observer-spawn">0,25,0</point>
        <rectangle id="red-spawn" min="-60,60" max="-40,80"/>
        <rectangle id="blue-spawn" min="40,-80" max="60,-60"/>
        <cuboid id="red-monument-region" min="20,12,110" max="21,15,111"/>
        <cuboid id="red-monument-2-region" min="50,12,60" max="51,15,61"/>
        <cuboid id="blue-monument-region" min="-20,12,-110" max="-19,15,-109"/>
        <cuboid id="blue-monument-2-region" min="-50,12,-60" max="-49,15,-59"/>
        <union id="spawns">
            <region id="red-spawn"/>
            <region id="blue-spawn"/>
        </union>
        <negative id="not-spawns">
            <region id="spawns"/>
        </negative>
        <negative id="not-build-area">
            <rectangle id="build-area-1" min="-20,-10" max="20,10"/>
        </negative>
        <apply enter="only-red" region="red-spawn" message="You may not enter the enemy's spawn!"/>
        <apply enter="only-blue" region="blue-spawn" message="You may not enter the enemy's spawn!"/>
        <apply block="never" region="spawns" message="You may not block/break spawns!"/>
        <apply kit="reset-resistance-kit" region="not-spawns"/>
        <apply block="no-void" region="not-build-area" message="You may not edit the void!"/>
    </regions>
    <maxbuildheight>20</maxbuildheight>
</map>
