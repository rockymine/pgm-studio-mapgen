<map proto="1.5.0">
    <name>Quadrangle</name>
    <version>1.0.0</version>
    <gamemode>ctw</gamemode>
    <objective>Capture the enemies' wools!</objective>
    <created>2026-09-16</created>
    <phase>development</phase>
    <include id="gapple-kill-reward"/>
    <authors>
        <author>Opus 5</author>
    </authors>
    <teams>
        <team id="red-team" color="red" max="20">Red</team>
        <team id="blue-team" color="blue" max="20">Blue</team>
        <team id="yellow-team" color="yellow" max="20">Yellow</team>
        <team id="green-team" color="green" max="20">Green</team>
    </teams>
    <kits>
        <kit id="spawn-kit">
            <clear/>
            <item slot="0" material="iron sword" unbreakable="true"/>
            <item slot="1" material="bow" unbreakable="true">
                <enchantment level="1">infinity</enchantment>
            </item>
            <item slot="2" material="iron pickaxe" unbreakable="true">
                <enchantment level="1">efficiency</enchantment>
            </item>
            <item slot="3" material="iron axe" unbreakable="true">
                <enchantment level="1">efficiency</enchantment>
            </item>
            <item slot="4" material="wood" amount="64"/>
            <item slot="5" material="stained clay" amount="32" team-color="true"/>
            <item slot="7" material="water bucket"/>
            <item slot="8" material="golden apple"/>
            <item slot="28" material="arrow"/>
            <item slot="29" material="shears" unbreakable="true"/>
            <item slot="30" material="iron spade" unbreakable="true"/>
            <helmet material="leather helmet" unbreakable="true" team-color="true">
                <enchantment level="1">projectile_protection</enchantment>
            </helmet>
            <chestplate material="leather chestplate" unbreakable="true" team-color="true">
                <enchantment level="1">projectile_protection</enchantment>
            </chestplate>
            <leggings material="chainmail leggings" unbreakable="true">
                <enchantment level="1">projectile_protection</enchantment>
            </leggings>
            <boots material="leather boots" unbreakable="true" team-color="true">
                <enchantment level="1">projectile_protection</enchantment>
            </boots>
            <effect duration="oo" amplifier="100">damage resistance</effect>
        </kit>
        <kit id="reset-resistance-kit" force="true">
            <effect duration="0" amplifier="0">damage resistance</effect>
        </kit>
    </kits>
    <spawns>
        <default region="observer-spawn"/>
        <spawn team="red-team" kit="spawn-kit" yaw="90" region="red-spawn-point"/>
        <spawn team="blue-team" kit="spawn-kit" yaw="180" region="blue-spawn-point"/>
        <spawn team="yellow-team" kit="spawn-kit" yaw="270" region="yellow-spawn-point"/>
        <spawn team="green-team" kit="spawn-kit" region="green-spawn-point"/>
    </spawns>
    <wools>
        <wool team="blue-team" color="red" location="35,12,80" monument="red-blue-monument"/>
        <wool team="yellow-team" color="red" location="35,12,80" monument="red-yellow-monument"/>
        <wool team="green-team" color="red" location="35,12,80" monument="red-green-monument"/>
        <wool team="blue-team" color="orange" location="70,9,40" monument="orange-blue-monument"/>
        <wool team="yellow-team" color="orange" location="70,9,40" monument="orange-yellow-monument"/>
        <wool team="green-team" color="orange" location="70,9,40" monument="orange-green-monument"/>
        <wool team="red-team" color="blue" location="-80,12,35" monument="blue-red-monument"/>
        <wool team="yellow-team" color="blue" location="-80,12,35" monument="blue-yellow-monument"/>
        <wool team="green-team" color="blue" location="-80,12,35" monument="blue-green-monument"/>
        <wool team="red-team" color="light_blue" location="-40,9,70" monument="light_blue-red-monument"/>
        <wool team="yellow-team" color="light_blue" location="-40,9,70" monument="light_blue-yellow-monument"/>
        <wool team="green-team" color="light_blue" location="-40,9,70" monument="light_blue-green-monument"/>
        <wool team="red-team" color="yellow" location="-35,12,-80" monument="yellow-red-monument"/>
        <wool team="blue-team" color="yellow" location="-35,12,-80" monument="yellow-blue-monument"/>
        <wool team="green-team" color="yellow" location="-35,12,-80" monument="yellow-green-monument"/>
        <wool team="red-team" color="pink" location="-70,9,-40" monument="pink-red-monument"/>
        <wool team="blue-team" color="pink" location="-70,9,-40" monument="pink-blue-monument"/>
        <wool team="green-team" color="pink" location="-70,9,-40" monument="pink-green-monument"/>
        <wool team="red-team" color="green" location="80,12,-35" monument="green-red-monument"/>
        <wool team="blue-team" color="green" location="80,12,-35" monument="green-blue-monument"/>
        <wool team="yellow-team" color="green" location="80,12,-35" monument="green-yellow-monument"/>
        <wool team="red-team" color="lime" location="40,9,-70" monument="lime-red-monument"/>
        <wool team="blue-team" color="lime" location="40,9,-70" monument="lime-blue-monument"/>
        <wool team="yellow-team" color="lime" location="40,9,-70" monument="lime-yellow-monument"/>
    </wools>
    <filters>
        <team id="only-green">green-team</team>
        <team id="only-yellow">yellow-team</team>
        <team id="only-blue">blue-team</team>
        <team id="only-red">red-team</team>
        <all id="yellows-woolrooms-filter">
            <filter id="not-yellow"/>
            <filter id="woolrooms-filter"/>
        </all>
        <not id="not-yellow">
            <filter id="only-yellow"/>
        </not>
        <all id="blues-woolrooms-filter">
            <filter id="not-blue"/>
            <filter id="woolrooms-filter"/>
        </all>
        <not id="not-blue">
            <filter id="only-blue"/>
        </not>
        <all id="reds-woolrooms-filter">
            <filter id="not-red"/>
            <filter id="woolrooms-filter"/>
        </all>
        <not id="not-red">
            <filter id="only-red"/>
        </not>
        <material id="chest-filter">chest</material>
        <any id="woolrooms-filter">
            <material>web</material>
            <material>stained glass</material>
            <material>stained glass pane</material>
            <material>wood</material>
            <material>stained clay</material>
            <all>
                <cause>player</cause>
                <any>
                    <material>water</material>
                    <material>stationary water</material>
                </any>
            </all>
        </any>
        <all id="greens-woolrooms-filter">
            <filter id="not-green"/>
            <filter id="woolrooms-filter"/>
        </all>
        <not id="not-green">
            <filter id="only-green"/>
        </not>
        <any id="block-break-void-filter">
            <all>
                <any>
                    <material>log</material>
                    <material>log 2</material>
                    <material>leaves</material>
                    <material>leaves 2</material>
                    <material>long grass</material>
                    <material>yellow flower</material>
                    <material>red rose</material>
                    <material>double plant</material>
                    <material>water lily</material>
                    <material>vine</material>
                </any>
                <void/>
            </all>
            <filter id="block-place-void-filter"/>
        </any>
        <not id="block-place-void-filter">
            <void/>
        </not>
    </filters>
    <regions>
        <point id="green-spawn-point">61,11,-70</point>
        <point id="yellow-spawn-point">-70,11,-61</point>
        <point id="blue-spawn-point">-61,11,70</point>
        <point id="red-spawn-point">70,11,61</point>
        <point id="light_blue-wool-spawn">-40,9,70</point>
        <point id="blue-wool-spawn">-80,12,35</point>
        <point id="orange-wool-spawn">70,9,40</point>
        <point id="red-wool-spawn">35,12,80</point>
        <point id="yellow-wool-spawn">-35,12,-80</point>
        <point id="pink-wool-spawn">-70,9,-40</point>
        <point id="green-wool-spawn">80,12,-35</point>
        <point id="lime-wool-spawn">40,9,-70</point>
        <point id="observer-spawn">0,61,0</point>
        <block id="yellow-red-monument">72,12,57</block>
        <block id="light_blue-green-monument">62,12,-73</block>
        <block id="light_blue-yellow-monument">-73,12,-58</block>
        <block id="light_blue-red-monument">67,12,62</block>
        <block id="blue-green-monument">57,12,-73</block>
        <block id="blue-yellow-monument">-73,12,-63</block>
        <block id="blue-red-monument">67,12,57</block>
        <block id="orange-green-monument">62,12,-68</block>
        <block id="orange-yellow-monument">-68,12,-58</block>
        <block id="orange-blue-monument">-58,12,67</block>
        <block id="red-green-monument">57,12,-68</block>
        <block id="red-yellow-monument">-68,12,-63</block>
        <block id="red-blue-monument">-63,12,67</block>
        <block id="yellow-blue-monument">-63,12,72</block>
        <block id="yellow-green-monument">58,12,-73</block>
        <block id="pink-red-monument">72,12,62</block>
        <block id="pink-blue-monument">-58,12,72</block>
        <block id="pink-green-monument">59,12,-73</block>
        <block id="green-red-monument">72,12,58</block>
        <block id="green-blue-monument">-62,12,72</block>
        <block id="green-yellow-monument">-73,12,-62</block>
        <block id="lime-red-monument">72,12,59</block>
        <block id="lime-blue-monument">-61,12,72</block>
        <block id="lime-yellow-monument">-73,12,-61</block>
        <rectangle id="green-spawn" min="55,-75" max="65,-65"/>
        <rectangle id="yellow-spawn" min="-75,-65" max="-65,-55"/>
        <rectangle id="blue-spawn" min="-65,65" max="-55,75"/>
        <rectangle id="red-spawn" min="65,55" max="75,65"/>
        <rectangle id="light_blue-wool" min="-45,65" max="-35,75"/>
        <rectangle id="blue-wool" min="-85,30" max="-75,40"/>
        <rectangle id="orange-wool" min="65,35" max="75,45"/>
        <rectangle id="red-wool" min="30,75" max="40,85"/>
        <rectangle id="yellow-wool" min="-40,-85" max="-30,-75"/>
        <rectangle id="pink-wool" min="-75,-45" max="-65,-35"/>
        <rectangle id="green-wool" min="75,-40" max="85,-30"/>
        <rectangle id="lime-wool" min="35,-75" max="45,-65"/>
        <union id="reds-woolrooms">
            <region id="red-wool"/>
            <region id="orange-wool"/>
        </union>
        <union id="blues-woolrooms">
            <region id="blue-wool"/>
            <region id="light_blue-wool"/>
        </union>
        <union id="yellows-woolrooms">
            <region id="yellow-wool"/>
            <region id="pink-wool"/>
        </union>
        <union id="greens-woolrooms">
            <region id="green-wool"/>
            <region id="lime-wool"/>
        </union>
        <union id="woolrooms">
            <region id="reds-woolrooms"/>
            <region id="blues-woolrooms"/>
            <region id="yellows-woolrooms"/>
            <region id="greens-woolrooms"/>
        </union>
        <negative id="not-spawns">
            <region id="spawns"/>
        </negative>
        <negative id="not-build-area">
            <union id="build-area">
                <rectangle id="build-area-1" min="-10,-60" max="10,60"/>
                <rectangle id="build-area-2" min="-60,-10" max="60,10"/>
            </union>
        </negative>
        <complement id="spawns">
            <union id="spawn-areas">
                <region id="red-spawn"/>
                <region id="blue-spawn"/>
                <region id="yellow-spawn"/>
                <region id="green-spawn"/>
            </union>
            <region id="red-blue-monument"/>
            <region id="red-yellow-monument"/>
            <region id="red-green-monument"/>
            <region id="orange-blue-monument"/>
            <region id="orange-yellow-monument"/>
            <region id="orange-green-monument"/>
            <region id="blue-red-monument"/>
            <region id="blue-yellow-monument"/>
            <region id="blue-green-monument"/>
            <region id="light_blue-red-monument"/>
            <region id="light_blue-yellow-monument"/>
            <region id="light_blue-green-monument"/>
            <region id="yellow-red-monument"/>
            <region id="yellow-blue-monument"/>
            <region id="yellow-green-monument"/>
            <region id="pink-red-monument"/>
            <region id="pink-blue-monument"/>
            <region id="pink-green-monument"/>
            <region id="green-red-monument"/>
            <region id="green-blue-monument"/>
            <region id="green-yellow-monument"/>
            <region id="lime-red-monument"/>
            <region id="lime-blue-monument"/>
            <region id="lime-yellow-monument"/>
        </complement>
        <everywhere id="void-enforcement-area"/>
        <apply enter="only-red" region="red-spawn" message="You may not enter the enemy's spawn!"/>
        <apply enter="only-blue" region="blue-spawn" message="You may not enter the enemy's spawn!"/>
        <apply enter="only-yellow" region="yellow-spawn" message="You may not enter the enemy's spawn!"/>
        <apply enter="only-green" region="green-spawn" message="You may not enter the enemy's spawn!"/>
        <apply block="never" region="spawns" message="You may not block/break spawns!"/>
        <apply kit="reset-resistance-kit" region="not-spawns"/>
        <apply enter="not-red" region="reds-woolrooms" message="You may not enter your own wool room!"/>
        <apply block="reds-woolrooms-filter" region="reds-woolrooms" message="You may not edit the wool room!"/>
        <apply use="deny(all(only-red,chest-filter))" region="reds-woolrooms"/>
        <apply enter="not-blue" region="blues-woolrooms" message="You may not enter your own wool room!"/>
        <apply block="blues-woolrooms-filter" region="blues-woolrooms" message="You may not edit the wool room!"/>
        <apply use="deny(all(only-blue,chest-filter))" region="blues-woolrooms"/>
        <apply enter="not-yellow" region="yellows-woolrooms" message="You may not enter your own wool room!"/>
        <apply block="yellows-woolrooms-filter" region="yellows-woolrooms" message="You may not edit the wool room!"/>
        <apply use="deny(all(only-yellow,chest-filter))" region="yellows-woolrooms"/>
        <apply enter="not-green" region="greens-woolrooms" message="You may not enter your own wool room!"/>
        <apply block="greens-woolrooms-filter" region="greens-woolrooms" message="You may not edit the wool room!"/>
        <apply use="deny(all(only-green,chest-filter))" region="greens-woolrooms"/>
        <apply block-place="deny(void)" region="void-enforcement-area" message="You may not edit the void!"/>
        <apply block-place="block-place-void-filter" block-break="block-break-void-filter" region="not-build-area" message="You may not edit the void!"/>
    </regions>
    <spawners>
        <spawner spawn-region="red-wool-spawn" player-region="red-wool" delay="1.5s">
            <item material="wool" damage="14"/>
        </spawner>
        <spawner spawn-region="orange-wool-spawn" player-region="orange-wool" delay="1.5s">
            <item material="wool" damage="1"/>
        </spawner>
        <spawner spawn-region="blue-wool-spawn" player-region="blue-wool" delay="1.5s">
            <item material="wool" damage="11"/>
        </spawner>
        <spawner spawn-region="light_blue-wool-spawn" player-region="light_blue-wool" delay="1.5s">
            <item material="wool" damage="3"/>
        </spawner>
        <spawner spawn-region="yellow-wool-spawn" player-region="yellow-wool" delay="1.5s">
            <item material="wool" damage="4"/>
        </spawner>
        <spawner spawn-region="pink-wool-spawn" player-region="pink-wool" delay="1.5s">
            <item material="wool" damage="6"/>
        </spawner>
        <spawner spawn-region="green-wool-spawn" player-region="green-wool" delay="1.5s">
            <item material="wool" damage="13"/>
        </spawner>
        <spawner spawn-region="lime-wool-spawn" player-region="lime-wool" delay="1.5s">
            <item material="wool" damage="5"/>
        </spawner>
    </spawners>
    <block-drops>
        <rule>
            <filter>
                <any>
                    <material>wood</material>
                    <material>stained clay</material>
                </any>
            </filter>
            <drops>
                <item material="wood" chance="0"/>
            </drops>
        </rule>
    </block-drops>
    <itemkeep>
        <item>iron sword</item>
        <item>bow</item>
        <item>iron pickaxe</item>
        <item>iron axe</item>
        <item>water bucket</item>
        <item>golden apple</item>
        <item>arrow</item>
        <item>shears</item>
        <item>iron spade</item>
        <item>wood</item>
        <item>stained clay</item>
    </itemkeep>
    <itemremove>
        <item>leather helmet</item>
        <item>leather chestplate</item>
        <item>chainmail leggings</item>
        <item>leather boots</item>
    </itemremove>
    <toolrepair>
        <tool>iron sword</tool>
        <tool>bow</tool>
        <tool>iron pickaxe</tool>
        <tool>iron axe</tool>
        <tool>shears</tool>
        <tool>iron spade</tool>
    </toolrepair>
    <kill-rewards>
        <kill-reward>
            <item material="wood" amount="16"/>
            <item material="stained clay" amount="8" team-color="true"/>
        </kill-reward>
    </kill-rewards>
    <hunger>
        <depletion>off</depletion>
    </hunger>
    <maxbuildheight>41</maxbuildheight>
</map>
