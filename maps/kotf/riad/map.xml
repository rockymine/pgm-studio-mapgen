<map proto="1.5.0">
<name>Riad</name>
<version>0.1.0</version>
<objective>Hold the flag for 200 seconds. While your team holds it, your dead wait.</objective>
<gamemode>kotf</gamemode>
<authors>
    <author>Claude (freeform generator)</author>
</authors>
<!-- written out in full from PublicMaps' conquest and kotf includes, so the map needs neither -->
<teams>
    <team id="red-team" color="red" max="16">Red</team>
    <team id="blue-team" color="blue" max="16">Blue</team>
</teams>
<kits>
    <kit id="spawn-kit">
        <clear/>
        <item slot="0" unbreakable="true" material="stone sword"/>
        <item slot="1" unbreakable="true" material="bow"/>
        <item slot="2" material="golden apple"/>
        <item slot="3" material="compass"/>
        <item slot="8" amount="12" material="arrow"/>
        <helmet unbreakable="true" team-color="true" material="leather helmet"/>
        <chestplate unbreakable="true" team-color="true" material="leather chestplate"/>
        <leggings unbreakable="true" material="chainmail leggings">
            <enchantment level="3">projectile_protection</enchantment>
        </leggings>
        <boots unbreakable="true" material="iron boots"/>
        <effect duration="7.5s" amplifier="5">resistance</effect>
        <game-mode>adventure</game-mode>
    </kit>
    <!-- the carrier: four hearts, slowed, a moment of absorption -->
    <kit id="flag-kit" force="true">
        <action>
            <enchant-item ignore-metadata="true" enchantment="projectile_protection" level="2">
                <find material="chainmail leggings"/>
            </enchant-item>
        </action>
        <max-health>8</max-health>
        <effect duration="3s" amplifier="2">absorption</effect>
        <effect>slowness</effect>
    </kit>
    <!-- on the drop: health back, slowness off, and every living player regenerates -->
    <kit id="reset-health" force="true">
        <action>
            <enchant-item ignore-metadata="true" enchantment="projectile_protection" level="3">
                <find material="chainmail leggings"/>
            </enchant-item>
        </action>
        <max-health>20</max-health>
        <effect duration="0s" amplifier="0">slowness</effect>
        <effect duration="2s" amplifier="10">regeneration</effect>
        <action>
            <switch-scope inner="match">
                <switch-scope inner="player" filter="all(alive,not(flag-carrier))">
                    <kit>
                        <effect duration="4s" amplifier="3">regeneration</effect>
                    </kit>
                </switch-scope>
            </switch-scope>
        </action>
    </kit>
</kits>
<filters>
    <!-- a team may respawn unless one of its own is carrying the flag -->
    <any id="has-flag">
        <carrying-flag id="flag-carrier">flag</carrying-flag>
        <not>
            <same-team>
                <filter id="flag-carrier"/>
            </same-team>
        </not>
    </any>
    <team id="only-red">red-team</team>
    <team id="only-blue">blue-team</team>
</filters>
<spawns>
    <default yaw="90">
        <region><point>0.5,40,0.5</point></region>
    </default>
    <spawn team="red-team" kit="spawn-kit" filter="has-flag" yaw="0">
        <region><point>0.5,23,-51.5</point></region>
    </spawn>
    <spawn team="blue-team" kit="spawn-kit" filter="has-flag" yaw="180">
        <region><point>0.5,23,52.5</point></region>
    </spawn>
</spawns>
<respawn delay="3s" auto="true" spectate="true">
    <message>
        {"translate":"death.respawn.confirmed.waiting.flagDropped"}
    </message>
</respawn>
<regions>
    <!-- the spawn terraces: two over the back garden, so nobody climbs back; the enemy may not enter either -->
    <cuboid id="red-spawn" min="-10,22,-56" max="11,30,-45"/>
    <cuboid id="blue-spawn" min="-10,22,46" max="11,30,57"/>
    <apply enter="only-red" region="red-spawn" message="You may not enter the enemy spawn!"/>
    <apply enter="only-blue" region="blue-spawn" message="You may not enter the enemy spawn!"/>
    <apply block="never" use="never"/>
</regions>
<flags>
    <flag id="flag" name="Flag" color="purple" shared="true" points-rate="1"
          pickup-kit="flag-kit" drop-kit="reset-health" flag-proximity-metric="none" show-respawn-on-pickup="false">
        <post return-time="0s" respawn-time="15s">
            <post name="the Cistern">0.5,25,0.5</post>
            <post name="the Mirador" yaw="90">-41.5,25,0.5</post>
            <post name="the Minaret" yaw="-90">30.5,23,0.5</post>
        </post>
    </flag>
</flags>
<compass show-distance="true">
    <player filter="flag-carrier" show-player="true" name="Flag Carrier"/>
</compass>
<score>
    <limit>200</limit>
</score>
<toolrepair>
    <tool>stone sword</tool>
    <tool>bow</tool>
    <tool>compass</tool>
</toolrepair>
<itemkeep>
    <item>stone sword</item>
    <item>bow</item>
    <item>golden apple</item>
    <item>arrow</item>
    <item>compass</item>
</itemkeep>
<itemremove>
    <item>leather helmet</item>
    <item>leather chestplate</item>
    <item>chainmail leggings</item>
    <item>iron boots</item>
    <item>banner</item>
</itemremove>
<kill-rewards>
    <kill-reward>
        <item amount="6" material="arrow"/>
    </kill-reward>
</kill-rewards>
<hunger>
    <depletion>off</depletion>
</hunger>
<world>
    <timeset>6000</timeset>
    <timelock>on</timelock>
</world>
</map>
