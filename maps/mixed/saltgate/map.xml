<map proto="1.5.0">
    <name>Saltgate</name>
    <version>0.1.0</version>
    <objective>Attackers: take the Sea Gate, blow both powder stores, and carry the city's banner down to the Sea Gate. Defenders: hold out for 15 minutes.</objective>
    <gamemode>ad</gamemode>
    <authors>
        <author>Claude (freeform generator)</author>
    </authors>
    <kits>
        <kit id="base-kit">
            <clear/>
            <item slot="0" material="iron sword" unbreakable="true"/>
            <item slot="1" material="bow" unbreakable="true"/>
            <item slot="2" material="golden apple" amount="2"/>
            <item slot="3" material="cooked beef" amount="16"/>
            <helmet material="leather helmet" unbreakable="true" team-color="true"/>
            <chestplate material="chainmail chestplate" unbreakable="true"/>
            <leggings material="iron leggings" unbreakable="true"/>
            <boots material="iron boots" unbreakable="true">
                <enchantment level="2">feather_falling</enchantment>
            </boots>
            <effect duration="3s" amplifier="255">resistance</effect>
            <game-mode>survival</game-mode>
        </kit>
        <kit id="attacker-kit" parents="base-kit">
            <item slot="4" material="diamond pickaxe" unbreakable="true">
                <enchantment level="2">efficiency</enchantment>
            </item>
            <item slot="8" material="arrow" amount="24"/>
        </kit>
        <kit id="defender-kit" parents="base-kit">
            <item slot="8" material="arrow" amount="40"/>
        </kit>
    </kits>
    <teams>
        <team id="attackers" color="red" max="16">Attackers</team>
        <team id="defenders" color="blue" max="16">Defenders</team>
    </teams>
    <filters>
        <team id="only-attackers">attackers</team>
        <not id="not-attackers">
            <team>attackers</team>
        </not>
        <team id="only-defenders">defenders</team>
        <not id="not-defenders">
            <team>defenders</team>
        </not>
        <after duration="20s" id="warmup-over">
            <match-started/>
        </after>
        <completed id="sea-gate-taken">sea-gate</completed>
        <all id="stores-blown">
            <completed>west-store</completed>
            <completed>east-store</completed>
        </all>
        <not id="stage-1">
            <filter id="sea-gate-taken"/>
        </not>
        <all id="stage-2">
            <filter id="sea-gate-taken"/>
            <not>
                <filter id="stores-blown"/>
            </not>
        </all>
        <all id="stage-3">
            <filter id="sea-gate-taken"/>
            <filter id="stores-blown"/>
        </all>
        <any id="breakable">
            <material>obsidian</material>
            <material>wool:10</material>
        </any>
    </filters>
    <spawns>
        <default yaw="0">
            <region>
                <point>0.5,50,-40.5</point>
            </region>
        </default>
        <spawn team="attackers" kit="attacker-kit" filter="stage-1" yaw="0">
            <region>
                <point>-0.5,25,-60.5</point>
            </region>
        </spawn>
        <spawn team="attackers" kit="attacker-kit" filter="stage-2" yaw="0">
            <region>
                <point>0.5,23,-27.5</point>
            </region>
        </spawn>
        <spawn team="attackers" kit="attacker-kit" filter="stage-3" yaw="0">
            <region>
                <point>0.5,31,13.5</point>
            </region>
        </spawn>
        <spawn team="defenders" kit="defender-kit" filter="stage-1" yaw="180">
            <region>
                <point>0.5,27,0.5</point>
            </region>
        </spawn>
        <spawn team="defenders" kit="defender-kit" filter="stage-2" yaw="180">
            <region>
                <point>0.5,31,20.5</point>
            </region>
        </spawn>
        <spawn team="defenders" kit="defender-kit" filter="stage-3" yaw="180">
            <region>
                <point>-20.5,35,50.5</point>
            </region>
        </spawn>
    </spawns>
    <regions>
        <cuboid min="-6,22,-26" max="6,28,-20" id="sea-gate-capture"/>
        <cuboid min="-6,22,-26" max="6,23,-20" id="sea-gate-ring"/>
        <cuboid min="-18,30,0" max="-17,32,1" id="west-store-region"/>
        <cuboid min="18,34,15" max="19,36,16" id="east-store-region"/>
        <block id="purple-attackers-monument">0,23,-23</block>
        <apply block-place="always" region="purple-attackers-monument"/>
        <block id="purple-wool-block">0,35,54</block>
        <apply block-place="always" region="purple-wool-block"/>
        <union id="posterns">
            <cuboid min="36,30,23" max="38,36,26"/>
            <cuboid min="-38,30,23" max="-36,36,26"/>
        </union>
        <apply enter="only-defenders" region="posterns" message="Only the defenders know the postern's key."/>
        <cuboid min="-6,24,-66" max="6,40,-55" id="flagship"/>
        <apply enter="only-attackers" region="flagship" message="You may not board the enemy's flagship!"/>
        <union id="fill-1">
            <cuboid min="-27,25,-55" max="-24,27,-54"/>
            <cuboid min="-2,25,-55" max="1,27,-54"/>
            <cuboid min="24,25,-55" max="27,27,-54"/>
        </union>
        <union id="fill-2">
            <cuboid min="-19,27,-4" max="-16,30,-3"/>
            <cuboid min="-19,27,5" max="-16,30,6"/>
            <cuboid min="17,31,11" max="20,34,12"/>
            <cuboid min="17,31,20" max="20,34,21"/>
        </union>
        <union id="fill-3">
            <cuboid min="-3,31,22" max="3,36,23"/>
            <cuboid min="-2,35,44" max="2,39,45"/>
            <cuboid min="11,35,51" max="12,38,54"/>
        </union>
        <apply block-break="breakable" block-place="never" message="The town's stones will not move."/>
    </regions>
    <control-points>
        <control-point id="sea-gate" name="the Sea Gate" capture="sea-gate-capture" progress="sea-gate-ring" captured="sea-gate-ring" initial-owner="defenders" capture-filter="only-attackers" permanent="true" capture-time="15s" show-progress="true"/>
    </control-points>
    <destroyables>
        <destroyable id="west-store" name="West Powder Store" owner="defenders" materials="obsidian" completion="100%" mode-changes="true" region="west-store-region"/>
        <destroyable id="east-store" name="East Powder Store" owner="defenders" materials="obsidian" completion="100%" mode-changes="true" region="east-store-region"/>
    </destroyables>
    <wools craftable="false">
        <wool team="attackers" color="purple" monument="purple-attackers-monument" location="0.5,35,54.5"/>
    </wools>
    <block-drops>
        <rule region="purple-wool-block">
            <drops>
                <item material="wool" damage="10"/>
            </drops>
            <replacement>wool:10</replacement>
        </rule>
    </block-drops>
    <actions>
        <trigger filter="warmup-over" scope="match">
            <action>
                <fill region="fill-1" material="air"/>
            </action>
        </trigger>
        <trigger filter="sea-gate-taken" scope="match">
            <action>
                <fill region="fill-2" material="air"/>
                <message text="`c`lThe Sea Gate has fallen! `7The powder stores' doors are open and the spawns move up."/>
            </action>
        </trigger>
        <trigger filter="stores-blown" scope="match">
            <action>
                <fill region="fill-3" material="air"/>
                <message text="`c`lBoth powder stores are blown! `7The citadel's gate and the keep's doors are open."/>
            </action>
        </trigger>
    </actions>
    <time result="defenders">15m</time>
    <broadcasts>
        <tip after="2s" filter="only-attackers">Your gangplanks open after 20 seconds. Take the Sea Gate!</tip>
        <tip after="2s" filter="only-defenders">Man the sea wall. The attackers land in 20 seconds.</tip>
    </broadcasts>
    <respawn delay="4s"/>
    <world>
        <timeset>3000</timeset>
        <timelock>on</timelock>
    </world>
    <itemkeep>
        <item>iron sword</item>
        <item>bow</item>
        <item>diamond pickaxe</item>
        <item>golden apple</item>
        <item>cooked beef</item>
        <item>arrow</item>
    </itemkeep>
    <itemremove>
        <item>leather helmet</item>
        <item>chainmail chestplate</item>
        <item>iron leggings</item>
        <item>iron boots</item>
        <item>obsidian</item>
        <item>flint</item>
        <item>gravel</item>
        <item>sapling</item>
        <item>apple</item>
    </itemremove>
    <toolrepair>
        <tool>iron sword</tool>
        <tool>bow</tool>
        <tool>diamond pickaxe</tool>
    </toolrepair>
    <kill-rewards>
        <kill-reward>
            <item material="arrow" amount="4"/>
        </kill-reward>
    </kill-rewards>
    <hunger>
        <depletion>off</depletion>
    </hunger>
</map>

