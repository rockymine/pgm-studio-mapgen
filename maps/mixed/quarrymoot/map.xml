<map proto="1.5.0">
    <name>Quarrymoot</name>
    <version>1.0.0</version>
    <gamemode>koth</gamemode>
    <objective>Hold the hills!</objective>
    <created>2026-09-28</created>
    <phase>development</phase>
    <include id="gapple-kill-reward"/>
    <authors>
        <author>Opus 5.5</author>
    </authors>
    <contributors>
        <contributor uuid="fe3608b7-d105-4029-8800-34b3147065b6" contribution="Original builder of the copied trees"/>
        <!-- rockymine -->
        <contributor contribution="Built with the PGM Studio authoring API at https://pgmstudio.de">PGM Studio (pgmstudio.de)</contributor>
    </contributors>
    <teams>
        <team id="red-team" color="red" max="16">Red</team>
        <team id="blue-team" color="blue" max="16">Blue</team>
    </teams>
    <kits>
        <kit id="spawn-kit">
            <clear/>
            <item slot="0" material="iron sword" unbreakable="true"/>
            <item slot="1" material="bow" unbreakable="true">
                <enchantment level="1">infinity</enchantment>
            </item>
            <item slot="2" material="iron pickaxe" unbreakable="true">
                <enchantment level="1">efficiency</enchantment>
            </item>
            <item slot="3" material="iron axe" unbreakable="true">
                <enchantment level="1">efficiency</enchantment>
            </item>
            <item slot="4" material="wood" amount="64"/>
            <item slot="5" material="stained clay" amount="32" team-color="true"/>
            <item slot="7" material="water bucket"/>
            <item slot="8" material="golden apple"/>
            <item slot="28" material="arrow"/>
            <item slot="29" material="shears" unbreakable="true"/>
            <item slot="30" material="iron spade" unbreakable="true"/>
            <helmet material="leather helmet" unbreakable="true" team-color="true">
                <enchantment level="1">projectile_protection</enchantment>
            </helmet>
            <chestplate material="leather chestplate" unbreakable="true" team-color="true">
                <enchantment level="1">projectile_protection</enchantment>
            </chestplate>
            <leggings material="chainmail leggings" unbreakable="true">
                <enchantment level="1">projectile_protection</enchantment>
            </leggings>
            <boots material="leather boots" unbreakable="true" team-color="true">
                <enchantment level="1">projectile_protection</enchantment>
            </boots>
            <effect duration="oo" amplifier="100">damage resistance</effect>
        </kit>
        <kit id="reset-resistance-kit" force="true">
            <effect duration="0" amplifier="0">damage resistance</effect>
        </kit>
    </kits>
    <spawns>
        <default region="observer-spawn"/>
        <spawn team="red-team" kit="spawn-kit" yaw="180" region="red-spawn-point"/>
        <spawn team="blue-team" kit="spawn-kit" region="blue-spawn-point"/>
    </spawns>
    <king>
        <hills>
            <hill id="crusher" name="Crusher" capture-time="5s" incremental="true" time-multiplier="0" neutral-state="true" points="2" show-progress="true" required="false" capture-region="crusher-capture" progress-display-region="crusher-pad" owner-display-region="crusher-marker"/>
            <hill id="west-bench" name="West Bench" capture-time="5s" incremental="true" time-multiplier="0" neutral-state="true" points="1" show-progress="true" required="false" capture-region="west-bench-capture" progress-display-region="west-bench-pad" owner-display-region="west-bench-marker"/>
            <hill id="east-bench" name="East Bench" capture-time="5s" incremental="true" time-multiplier="0" neutral-state="true" points="1" show-progress="true" required="false" capture-region="east-bench-capture" progress-display-region="east-bench-pad" owner-display-region="east-bench-marker"/>
        </hills>
    </king>
    <score>
        <limit>750</limit>
    </score>
    <filters>
        <team id="only-blue">blue-team</team>
        <team id="only-red">red-team</team>
    </filters>
    <regions>
        <point id="blue-spawn-point">0,22,-82</point>
        <point id="red-spawn-point">0,22,82</point>
        <point id="observer-spawn">0,47,0</point>
        <rectangle id="blue-spawn" min="-12,-88" max="12,-72"/>
        <rectangle id="red-spawn" min="-12,72" max="12,88"/>
        <cuboid id="crusher-capture" min="-3,13,-3" max="4,16,4"/>
        <cuboid id="crusher-pad" min="-3,13,-3" max="4,14,4"/>
        <cuboid id="crusher-marker" min="-1,43,-1" max="2,46,2"/>
        <cuboid id="west-bench-capture" min="-45,17,-3" max="-38,20,4"/>
        <cuboid id="west-bench-pad" min="-45,17,-3" max="-38,18,4"/>
        <cuboid id="west-bench-marker" min="-43,43,-1" max="-40,46,2"/>
        <cuboid id="east-bench-capture" min="38,17,-4" max="45,20,3"/>
        <cuboid id="east-bench-pad" min="38,17,-4" max="45,18,3"/>
        <cuboid id="east-bench-marker" min="40,43,-2" max="43,46,1"/>
        <union id="spawns">
            <region id="red-spawn"/>
            <region id="blue-spawn"/>
        </union>
        <negative id="not-spawns">
            <region id="spawns"/>
        </negative>
        <apply enter="only-red" region="red-spawn" message="You may not enter the enemy's spawn!"/>
        <apply enter="only-blue" region="blue-spawn" message="You may not enter the enemy's spawn!"/>
        <apply block="never" region="spawns" message="You may not block/break spawns!"/>
        <apply kit="reset-resistance-kit" region="not-spawns"/>
    </regions>
    <block-drops>
        <rule>
            <filter>
                <any>
                    <material>wood</material>
                    <material>stained clay</material>
                </any>
            </filter>
            <drops>
                <item material="wood" chance="0"/>
            </drops>
        </rule>
    </block-drops>
    <itemkeep>
        <item>iron sword</item>
        <item>bow</item>
        <item>iron pickaxe</item>
        <item>iron axe</item>
        <item>water bucket</item>
        <item>golden apple</item>
        <item>arrow</item>
        <item>shears</item>
        <item>iron spade</item>
        <item>wood</item>
        <item>stained clay</item>
    </itemkeep>
    <itemremove>
        <item>leather helmet</item>
        <item>leather chestplate</item>
        <item>chainmail leggings</item>
        <item>leather boots</item>
    </itemremove>
    <toolrepair>
        <tool>iron sword</tool>
        <tool>bow</tool>
        <tool>iron pickaxe</tool>
        <tool>iron axe</tool>
        <tool>shears</tool>
        <tool>iron spade</tool>
    </toolrepair>
    <kill-rewards>
        <kill-reward>
            <item material="wood" amount="16"/>
            <item material="stained clay" amount="8" team-color="true"/>
        </kill-reward>
    </kill-rewards>
    <hunger>
        <depletion>off</depletion>
    </hunger>
    <maxbuildheight>38</maxbuildheight>
</map>
