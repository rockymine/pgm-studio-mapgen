<map proto="1.5.0">
<name>Curio Square</name>
<version>1.0.0</version>
<objective>Hide from the seekers until the time runs out!</objective>
<gamemode>arcade</gamemode>
<rules><rule>Fall damage is disabled.</rule><rule>Hiders' name tags are hidden.</rule><rule>Every minute six of the fair's curiosities vanish.</rule></rules>
<teams>
    <team id="hiders" color="green" show-name-tags="false" max="50" plural="true">Hiders</team>
    <team id="seekers" color="dark aqua" max="3" max-overfill="3" plural="true">Seekers</team>
</teams>
<time result="hiders">7m</time>
<blitz filter="only-hiders"/>
<kits>
    <kit id="seeker-blind"><effect>blindness</effect><game-mode>adventure</game-mode></kit>
    <kit id="seeker" force="true">
        <clear effects="true"/>
        <game-mode>adventure</game-mode>
        <item slot="0" material="iron sword" unbreakable="true" locked="true"/>
        <helmet material="diamond helmet" unbreakable="true" locked="true"/>
        <chestplate material="diamond chestplate" unbreakable="true" locked="true"/>
        <leggings material="diamond leggings" unbreakable="true" locked="true"/>
        <boots material="diamond boots" unbreakable="true" locked="true"/>
        <effect>speed</effect>
    </kit>
    <kit id="hider">
        <game-mode>adventure</game-mode>
        <item slot="0" material="compass" locked="true"/>
        <item material="potion" name="`rPotion of Invisibility `7(15s)"><effect duration="15s">invisibility</effect></item>
    </kit>
    <kit id="hider-potion" deduct-items="false">
        <item material="potion" name="`rPotion of Invisibility `7(15s)"><effect duration="15s">invisibility</effect></item>
    </kit>
    <give kit="hider-potion" filter="potion-1"/>
    <give kit="hider-potion" filter="potion-3"/>
    <give kit="hider-potion" filter="potion-5"/>
    <give kit="seeker" filter="seekers-out"/>
</kits>
<spawns>
    <spawn team="hiders" kit="hider" safe="true">
        <regions>
            <cuboid min="-8,64,-8" max="9,65,-6"/>
            <cuboid min="-8,64,7" max="9,65,9"/>
            <cuboid min="-8,64,-6" max="-6,65,7"/>
            <cuboid min="7,64,-6" max="9,65,7"/>
        </regions>
    </spawn>
    <spawn team="seekers" kit="seeker-blind" filter="not(seekers-released)"><region><point>0.5,79,0.5</point></region></spawn>
    <spawn team="seekers" kit="seeker" filter="seekers-released"><region><point>0.5,64,7.5</point></region></spawn>
    <default yaw="180" pitch="35"><region><point>0.5,94,60.5</point></region></default>
</spawns>
<filters>
    <team id="only-hiders">hiders</team>
    <team id="only-seekers">seekers</team>
    <after id="seekers-released" duration="25s" filter="match-started" message="`3`lSeekers`r will be released in {0}"/>
    <all id="seekers-out"><filter id="seekers-released"/><team>seekers</team></all>
    <time id="round-1">85s</time>
    <time id="round-2">145s</time>
    <time id="round-3">205s</time>
    <time id="round-4">265s</time>
    <time id="round-5">325s</time>
    <time id="round-6">385s</time>
    <all id="potion-1"><time>85s</time><team>hiders</team></all>
    <all id="potion-3"><time>205s</time><team>hiders</team></all>
    <all id="potion-5"><time>325s</time><team>hiders</team></all>
    <deny id="not-players"><any><cause>player</cause><cause>explosion</cause></any></deny>
</filters>
