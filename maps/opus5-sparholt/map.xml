<map proto="1.5.0">
    <name>Sparholt</name>
    <version>1.0.0</version>
    <gamemode>koth</gamemode>
    <objective>Hold the hills!</objective>
    <created>2026-09-14</created>
    <phase>development</phase>
    <include id="gapple-kill-reward"/>
    <authors>
        <author>Opus 5</author>
    </authors>
    <teams>
        <team id="red-team" color="red" max="24">Red</team>
        <team id="blue-team" color="blue" max="24">Blue</team>
    </teams>
    <kits>
        <kit id="spawn-kit">
            <clear/>
            <item slot="0" material="iron sword" unbreakable="true"/>
            <item slot="1" material="bow" unbreakable="true">
                <enchantment level="1">infinity</enchantment>
            </item>
            <item slot="2" material="iron pickaxe" unbreakable="true">
                <enchantment level="1">efficiency</enchantment>
            </item>
            <item slot="3" material="iron axe" unbreakable="true">
                <enchantment level="1">efficiency</enchantment>
            </item>
            <item slot="4" material="wood" amount="64"/>
            <item slot="5" material="stained clay" amount="32" team-color="true"/>
            <item slot="7" material="water bucket"/>
            <item slot="8" material="golden apple"/>
            <item slot="28" material="arrow"/>
            <item slot="29" material="shears" unbreakable="true"/>
            <item slot="30" material="iron spade" unbreakable="true"/>
            <helmet material="leather helmet" unbreakable="true" team-color="true">
                <enchantment level="1">projectile_protection</enchantment>
            </helmet>
            <chestplate material="leather chestplate" unbreakable="true" team-color="true">
                <enchantment level="1">projectile_protection</enchantment>
            </chestplate>
            <leggings material="chainmail leggings" unbreakable="true">
                <enchantment level="1">projectile_protection</enchantment>
            </leggings>
            <boots material="leather boots" unbreakable="true" team-color="true">
                <enchantment level="1">projectile_protection</enchantment>
            </boots>
            <effect duration="oo" amplifier="100">damage resistance</effect>
        </kit>
        <kit id="reset-resistance-kit" force="true">
            <effect duration="0" amplifier="0">damage resistance</effect>
        </kit>
    </kits>
    <spawns>
        <default region="observer-spawn"/>
        <spawn team="red-team" kit="spawn-kit" yaw="180" region="red-spawn-point"/>
        <spawn team="blue-team" kit="spawn-kit" region="blue-spawn-point"/>
    </spawns>
    <king>
        <hills>
            <hill id="the-cutting-shed" name="The Cutting Shed" capture-time="5s" incremental="true" time-multiplier="0" neutral-state="true" points="2" show-progress="true" required="false" capture-region="the-cutting-shed-capture" progress-display-region="the-cutting-shed-pad" owner-display-region="the-cutting-shed-marker"/>
            <hill id="west-sawpit" name="West Sawpit" capture-time="5s" incremental="true" time-multiplier="0" neutral-state="true" points="1" show-progress="true" required="false" capture-region="west-sawpit-capture" progress-display-region="west-sawpit-pad" owner-display-region="west-sawpit-marker"/>
            <hill id="east-sawpit" name="East Sawpit" capture-time="5s" incremental="true" time-multiplier="0" neutral-state="true" points="1" show-progress="true" required="false" capture-region="east-sawpit-capture" progress-display-region="east-sawpit-pad" owner-display-region="east-sawpit-marker"/>
        </hills>
    </king>
    <score>
        <limit>750</limit>
    </score>
    <filters>
        <team id="only-blue">blue-team</team>
        <team id="only-red">red-team</team>
        <material id="only-air">air</material>
        <material id="only-iron">iron block</material>
        <all id="only-iron-cause-world">
            <material>iron block</material>
            <cause>world</cause>
        </all>
    </filters>
    <regions>
        <point id="blue-spawn-point">0,26,-67</point>
        <point id="red-spawn-point">0,26,67</point>
        <point id="observer-spawn">0,66,0</point>
        <rectangle id="blue-spawn" min="-15,-75" max="15,-60"/>
        <rectangle id="red-spawn" min="-15,60" max="15,75"/>
        <cuboid id="the-cutting-shed-capture" min="-4,25,-4" max="5,28,5"/>
        <cuboid id="the-cutting-shed-pad" min="-4,25,-4" max="5,26,5"/>
        <cuboid id="the-cutting-shed-marker" min="-1,62,-1" max="2,65,2"/>
        <cuboid id="west-sawpit-capture" min="-30,15,-3" max="-23,18,4"/>
        <cuboid id="west-sawpit-pad" min="-30,15,-3" max="-23,16,4"/>
        <cuboid id="west-sawpit-marker" min="-28,62,-1" max="-25,65,2"/>
        <cuboid id="east-sawpit-capture" min="24,15,-3" max="31,18,4"/>
        <cuboid id="east-sawpit-pad" min="24,15,-3" max="31,16,4"/>
        <cuboid id="east-sawpit-marker" min="26,62,-1" max="29,65,2"/>
        <union id="spawns">
            <region id="red-spawn"/>
            <region id="blue-spawn"/>
        </union>
        <union id="iron-cubes">
            <rectangle id="iron-cube-0" min="-15,66" max="-13,68"/>
            <rectangle id="iron-cube-1" min="12,66" max="14,68"/>
            <rectangle id="iron-cube-2" min="12,-69" max="14,-67"/>
            <rectangle id="iron-cube-3" min="-15,-69" max="-13,-67"/>
        </union>
        <negative id="not-spawns">
            <region id="spawns"/>
        </negative>
        <apply enter="only-red" region="red-spawn" message="You may not enter the enemy's spawn!"/>
        <apply enter="only-blue" region="blue-spawn" message="You may not enter the enemy's spawn!"/>
        <apply kit="reset-resistance-kit" region="not-spawns"/>
        <apply block-place="only-iron-cause-world" block-break="only-iron" region="spawns" message="You may not edit spawn!"/>
    </regions>
    <renewables>
        <renewable region="iron-cubes" renew-filter="only-iron" replace-filter="only-air" avoid-players="2"/>
    </renewables>
    <block-drops>
        <rule>
            <filter>
                <any>
                    <material>wood</material>
                    <material>stained clay</material>
                </any>
            </filter>
            <drops>
                <item material="wood" chance="0"/>
            </drops>
        </rule>
    </block-drops>
    <itemkeep>
        <item>iron sword</item>
        <item>bow</item>
        <item>iron pickaxe</item>
        <item>iron axe</item>
        <item>water bucket</item>
        <item>golden apple</item>
        <item>arrow</item>
        <item>shears</item>
        <item>iron spade</item>
        <item>wood</item>
        <item>stained clay</item>
    </itemkeep>
    <itemremove>
        <item>leather helmet</item>
        <item>leather chestplate</item>
        <item>chainmail leggings</item>
        <item>leather boots</item>
    </itemremove>
    <toolrepair>
        <tool>iron sword</tool>
        <tool>bow</tool>
        <tool>iron pickaxe</tool>
        <tool>iron axe</tool>
        <tool>shears</tool>
        <tool>iron spade</tool>
    </toolrepair>
    <kill-rewards>
        <kill-reward>
            <item material="wood" amount="16"/>
            <item material="stained clay" amount="8" team-color="true"/>
        </kill-reward>
    </kill-rewards>
    <hunger>
        <depletion>off</depletion>
    </hunger>
    <maxbuildheight>57</maxbuildheight>
</map>
