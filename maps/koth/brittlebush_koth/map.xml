        <not id="not-red">
            <team>red-team</team>
        </not>
        <team id="only-blue">blue-team</team>
        <not id="not-blue">
            <team>blue-team</team>
        </not>
        <team id="only-green">green-team</team>
        <not id="not-green">
            <team>green-team</team>
        </not>
        <team id="only-yellow">yellow-team</team>
        <not id="not-yellow">
            <team>yellow-team</team>
        </not>
        <not id="not-void">
            <void/>
        </not>
    </filters>
    <spawns>
