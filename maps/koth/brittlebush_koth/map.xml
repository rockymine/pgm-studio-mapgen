<map proto="1.5.0">
    <name>Brittlebush KotH</name>
    <version>1.0.0</version>
    <objective>Hold the hills: the Dais in the middle, and the islands between the spawns.</objective>
    <gamemode>koth</gamemode>
    <authors>
        <author>Claude (freeform generator, pgmvox)</author>
    </authors>
