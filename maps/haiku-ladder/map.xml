<map proto="1.5.0">
    <name>Ochre Ladder</name>
    <version>1.0.0</version>
    <gamemode>dtm</gamemode>
    <gamemode>dtc</gamemode>
    <objective>Destroy the enemy's monument and leak the enemy's core!</objective>
    <include id="gapple-kill-reward"/>
    <authors>
        <author uuid="0d05f1a5-0005-4005-8005-000000000hk4"/>
        <!-- Haiku 4.5 -->
    </authors>
    <teams>
        <team id="red-team" color="red" max="16">Red</team>
        <team id="blue-team" color="blue" max="16">Blue</team>
    </teams>
    <kits>
        <kit id="spawn-kit">
            <clear/>
            <item slot="0" material="iron sword" unbreakable="true"/>
            <item slot="1" material="bow" unbreakable="true">
                <enchantment level="1">infinity</enchantment>
            </item>
            <item slot="2" material="diamond pickaxe" unbreakable="true">
                <enchantment level="1">efficiency</enchantment>
            </item>
            <item slot="3" material="iron axe" unbreakable="true">
                <enchantment level="1">efficiency</enchantment>
            </item>
            <item slot="4" material="wood" amount="64"/>
            <item slot="5" material="stained clay" amount="32" team-color="true"/>
            <item slot="7" material="water bucket"/>
            <item slot="8" material="golden apple"/>
            <item slot="28" material="arrow"/>
            <item slot="29" material="shears" unbreakable="true"/>
            <item slot="30" material="iron spade" unbreakable="true"/>
            <helmet material="leather helmet" unbreakable="true" team-color="true">
                <enchantment level="1">projectile_protection</enchantment>
            </helmet>
            <chestplate material="leather chestplate" unbreakable="true" team-color="true">
                <enchantment level="1">projectile_protection</enchantment>
            </chestplate>
            <leggings material="chainmail leggings" unbreakable="true">
                <enchantment level="1">projectile_protection</enchantment>
            </leggings>
            <boots material="leather boots" unbreakable="true" team-color="true">
                <enchantment level="1">projectile_protection</enchantment>
            </boots>
            <effect duration="oo" amplifier="100">damage resistance</effect>
        </kit>
        <kit id="reset-resistance-kit" force="true">
            <effect duration="0" amplifier="0">damage resistance</effect>
        </kit>
    </kits>
    <spawns>
        <default region="observer-spawn"/>
        <spawn team="red-team" kit="spawn-kit" yaw="180" region="red-spawn-point"/>
        <spawn team="blue-team" kit="spawn-kit" region="blue-spawn-point"/>
    </spawns>
    <destroyables>
        <destroyable id="pyre" name="Pyre" owner="red-team" materials="obsidian" region="pyre-region"/>
        <destroyable id="pyre-2" name="Pyre" owner="blue-team" materials="obsidian" region="pyre-2-region"/>
    </destroyables>
    <cores>
        <core id="ore" name="Ore" team="red-team" leak="4" region="ore-region"/>
        <core id="ore-2" name="Ore" team="blue-team" leak="4" region="ore-2-region"/>
    </cores>
    <filters>
        <team id="only-blue">blue-team</team>
        <team id="only-red">red-team</team>
        <material id="only-air">air</material>
        <material id="only-iron">iron block</material>
    </filters>
    <regions>
        <point id="blue-spawn-point">6,8,-75</point>
        <point id="red-spawn-point">-6,8,75</point>
        <point id="observer-spawn">0,51,0</point>
        <rectangle id="blue-spawn" min="-10,-85" max="10,-70"/>
        <rectangle id="red-spawn" min="-10,70" max="10,85"/>
        <cuboid id="pyre-region" min="-16,11,29" max="-13,14,32"/>
        <cuboid id="pyre-2-region" min="13,11,-32" max="16,14,-29"/>
        <cuboid id="ore-region" min="-12,15,58" max="-7,20,63"/>
        <cuboid id="ore-2-region" min="7,15,-63" max="12,20,-58"/>
        <union id="spawns">
            <region id="red-spawn"/>
            <region id="blue-spawn"/>
        </union>
        <union id="iron-cubes">
            <rectangle id="iron-cube-0" min="-2,73" max="1,76"/>
            <rectangle id="iron-cube-1" min="-2,-77" max="1,-74"/>
        </union>
        <negative id="not-spawns">
            <region id="spawns"/>
        </negative>
        <apply enter="only-red" region="red-spawn" message="You may not enter the enemy's spawn!"/>
        <apply enter="only-blue" region="blue-spawn" message="You may not enter the enemy's spawn!"/>
        <apply block="never" region="spawns" message="You may not block/break spawns!"/>
        <apply kit="reset-resistance-kit" region="not-spawns"/>
    </regions>
    <renewables>
        <renewable region="iron-cubes" renew-filter="only-iron" replace-filter="only-air" avoid-players="2"/>
    </renewables>
    <block-drops>
        <rule>
            <filter>
                <any>
                    <material>wood</material>
                    <material>stained clay</material>
                </any>
            </filter>
            <drops>
                <item material="wood" chance="0"/>
            </drops>
        </rule>
    </block-drops>
    <itemkeep>
        <item>iron sword</item>
        <item>bow</item>
        <item>diamond pickaxe</item>
        <item>iron axe</item>
        <item>water bucket</item>
        <item>golden apple</item>
        <item>arrow</item>
        <item>shears</item>
        <item>iron spade</item>
        <item>wood</item>
        <item>stained clay</item>
    </itemkeep>
    <itemremove>
        <item>leather helmet</item>
        <item>leather chestplate</item>
        <item>chainmail leggings</item>
        <item>leather boots</item>
    </itemremove>
    <toolrepair>
        <tool>iron sword</tool>
        <tool>bow</tool>
        <tool>diamond pickaxe</tool>
        <tool>iron axe</tool>
        <tool>shears</tool>
        <tool>iron spade</tool>
    </toolrepair>
    <kill-rewards>
        <kill-reward>
            <item material="wood" amount="16"/>
            <item material="stained clay" amount="8" team-color="true"/>
        </kill-reward>
    </kill-rewards>
    <hunger>
        <depletion>off</depletion>
    </hunger>
    <maxbuildheight>34</maxbuildheight>
</map>
