# One line-ending policy for all machines. Repo stores LF; the working tree is LF
# everywhere (Windows VS and the Linux VM share these files on disk, so they must
# agree). eol=lf overrides each machine's core.autocrlf.
* text=auto eol=lf

*.png binary

# Minecraft world data: Anvil region files and gzipped NBT. The eol=lf rule above must never
# reach these — a normalised byte inside a compressed chunk is silent corruption.
*.mca binary
*.dat binary
