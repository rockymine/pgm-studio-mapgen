<map proto="1.5.0">
    <name>Stratum</name>
    <version>0.1.0</version>
    <objective>Leak the core hung in the enemy's Reactor, and break the monument on their Obelisk's balcony.</objective>
    <gamemode>dtm</gamemode>
    <gamemode>dtc</gamemode>
    <include id="gapple-kill-reward"/>
    <authors>
        <author>Claude (freeform generator)</author>
    </authors>
    <contributors>
        <contributor contribution="Built the oak and birch trees (tree showcase)">rockymine</contributor>
    </contributors>
    <kits>
        <kit id="spawn-kit">
            <item slot="0" material="iron sword" unbreakable="true"/>
            <item slot="1" material="bow" unbreakable="true">
                <enchantment level="1">infinity</enchantment>
            </item>
            <item slot="2" material="diamond pickaxe" unbreakable="true"/>
            <item slot="3" material="iron axe" unbreakable="true"/>
            <item slot="4" material="wood" amount="64"/>
            <item slot="5" material="wool" amount="64" team-color="true"/>
            <item slot="6" material="golden apple"/>
            <item slot="7" material="shears" unbreakable="true"/>
            <item slot="8" material="cooked beef" amount="16"/>
            <item slot="27" material="wood" amount="64"/>
            <item slot="28" material="arrow"/>
            <helmet material="leather helmet" unbreakable="true" team-color="true"/>
            <chestplate material="iron chestplate" unbreakable="true"/>
            <leggings material="chainmail leggings" unbreakable="true"/>
            <boots material="leather boots" unbreakable="true" team-color="true"/>
        </kit>
        <kit id="fall-kill" force="true">
            <effect duration="1" amplifier="5">instant damage</effect>
        </kit>
    </kits>
    <teams>
        <team id="red-team" color="red" max="16">Red</team>
        <team id="blue-team" color="blue" max="16">Blue</team>
    </teams>
    <filters>
        <team id="only-red">red-team</team>
        <not id="not-red">
            <team>red-team</team>
        </not>
        <team id="only-blue">blue-team</team>
        <not id="not-blue">
            <team>blue-team</team>
        </not>
    </filters>
    <spawns>
        <default yaw="90">
            <region>
                <point>0.5,100,0.5</point>
            </region>
        </default>
        <spawn team="red-team" kit="spawn-kit" yaw="270">
            <region>
                <point>-79.5,81,0.5</point>
            </region>
        </spawn>
        <spawn team="blue-team" kit="spawn-kit" yaw="90">
            <region>
                <point>79.5,81,0.5</point>
            </region>
        </spawn>
    </spawns>
    <regions>
        <cuboid min="-93,0,-13" max="-66,256,14" id="red-spawn"/>
        <apply enter="only-red" region="red-spawn" message="You may not enter the enemy spawn!"/>
        <apply block="never" region="red-spawn" message="You may not build in a spawn!"/>
        <cuboid min="66,0,-13" max="93,256,14" id="blue-spawn"/>
        <apply enter="only-blue" region="blue-spawn" message="You may not enter the enemy spawn!"/>
        <apply block="never" region="blue-spawn" message="You may not build in a spawn!"/>
        <cuboid min="-57,81,47" max="-54,84,50" id="red-core-region"/>
        <cuboid min="54,81,47" max="57,84,50" id="blue-core-region"/>
        <cuboid min="-55,100,-50" max="-54,102,-49" id="red-obelisk-region"/>
        <cuboid min="54,100,-50" max="55,102,-49" id="blue-obelisk-region"/>
        <below y="58" id="the-fall"/>
        <apply kit="fall-kill" region="the-fall"/>
    </regions>
    <cores>
        <core id="red-core" name="the Reactor" team="red-team" leak="10" mode-changes="true" region="red-core-region"/>
        <core id="blue-core" name="the Reactor" team="blue-team" leak="10" mode-changes="true" region="blue-core-region"/>
    </cores>
    <destroyables>
        <destroyable id="red-obelisk" name="the Obelisk" owner="red-team" materials="obsidian" completion="100%" mode-changes="true" region="red-obelisk-region"/>
        <destroyable id="blue-obelisk" name="the Obelisk" owner="blue-team" materials="obsidian" completion="100%" mode-changes="true" region="blue-obelisk-region"/>
    </destroyables>
    <maxbuildheight>122</maxbuildheight>
    <block-drops>
        <rule>
            <filter>
                <any>
                    <material>wood</material>
                    <material>wool</material>
                </any>
            </filter>
            <drops>
                <item material="wood" chance="0"/>
            </drops>
        </rule>
    </block-drops>
    <itemkeep>
        <item>iron sword</item>
        <item>bow</item>
        <item>diamond pickaxe</item>
        <item>iron axe</item>
        <item>golden apple</item>
        <item>shears</item>
        <item>arrow</item>
        <item>wood</item>
        <item>wool</item>
        <item>cooked beef</item>
    </itemkeep>
    <itemremove>
        <item>leather helmet</item>
        <item>iron chestplate</item>
        <item>chainmail leggings</item>
        <item>leather boots</item>
        <item>obsidian</item>
    </itemremove>
    <toolrepair>
        <tool>iron sword</tool>
        <tool>bow</tool>
        <tool>diamond pickaxe</tool>
        <tool>iron axe</tool>
        <tool>shears</tool>
    </toolrepair>
    <kill-rewards>
        <kill-reward>
            <item material="wood" amount="16"/>
            <item material="wool" amount="8" team-color="true"/>
        </kill-reward>
    </kill-rewards>
    <hunger>
        <depletion>off</depletion>
    </hunger>
</map>

