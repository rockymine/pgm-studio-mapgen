<map proto="1.5.0">
<name>Loomfall</name>
<version>1.0.0</version>
<objective>Keep running: the carpet falls away under every step. Be the last one flying.</objective>
<gamemode>arcade</gamemode>
<rules><rule>Wool you step on turns white and falls.</rule><rule>No fall damage, no fighting: only snowball grenades.</rule><rule>Below the last carpet you are out.</rule></rules>
<players min="2" max="40" colors="true"/>
<world><timeset>18000</timeset><timelock>on</timelock></world>
<kits>
    <kit id="flyer">
        <clear/>
        <game-mode>adventure</game-mode>
        <item slot="0" amount="5" material="snow ball" grenade="true" grenade-power="1"/>
    </kit>
    <kit id="out" force="true"><effect amplifier="100" duration="5">harm</effect></kit>
</kits>
<spawns>
    <spawn kit="flyer" safe="true"><region><cuboid min="-8,197,-6" max="8,197,6"/></region></spawn>
    <default pitch="60"><region><point>0.5,216,-40.5</point></region></default>
</spawns>
<filters>
    <not id="only-falling-wool"><all><cause>world</cause><material>wool:0</material></all></not>
    <match-running id="running"/>
    <entity id="falling-wool">falling block</entity>
</filters>
<regions>
    <apply block="only-falling-wool"/>
    <apply kit="out"><region><below y="116"/></region></apply>
</regions>
<block-drops>
    <rule trample="true"><filter><material>wool</material></filter><replacement>wool:0</replacement></rule>
</block-drops>
<falling-blocks>
    <rule delay="10"><filter><material>wool:0</material></filter><sticky><never/></sticky></rule>
</falling-blocks>
<actions>
    <trigger scope="match"><filter><pulse duration="0.25s" period="0.5s" filter="running"/></filter>
        <action><kill-entities filter="falling-wool"/></action></trigger>
</actions>
<damage><allow><cause>void</cause></allow><allow><cause>potion</cause></allow><not><cause>player</cause></not></damage>
<disabledamage><damage>fall</damage></disabledamage>
<hunger><depletion>off</depletion></hunger>
<blitz><lives>1</lives></blitz>
<time>10m</time>
<itemremove><item>wool</item><item>snow ball</item></itemremove>
</map>
