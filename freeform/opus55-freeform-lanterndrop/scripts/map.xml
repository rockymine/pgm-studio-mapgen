<map proto="1.5.0">
<name>Lantern Drop</name>
<version>1.0.0</version>
<objective>Drop down the broken pass and hold the most hills when the clock runs out.</objective>
<gamemode>arcade</gamemode>
<rules><rule>A drop of nineteen kills unless it ends in water: a cistern, the paddies, the harbour or your bucket.</rule><rule>Touch a hill to take it; it scores for you until someone else touches it, even after you die.</rule><rule>The slipway in the harbour takes you back to the bell court.</rule></rules>
<players min="1" max="40" colors="true"/>
<kits>
    <kit id="players">
        <clear/>
        <item slot="0" locked="true" name="`b`lWater Drop" material="water bucket"/>
        <item slot="1" locked="true" name="`b`lWater Drop" material="water bucket"/>
        <item slot="2" locked="true" name="`b`lWater Drop" material="water bucket"/>
        <effect duration="3s" amplifier="5">resistance</effect>
        <effect duration="oo" amplifier="-2">health boost</effect>
        <game-mode>survival</game-mode>
    </kit>
</kits>
<spawns>
    <spawn kit="players" yaw="0"><region><cuboid min="-5,241,7" max="6,241,14"/></region></spawn>
    <default yaw="0"><region><cuboid min="-5,241,7" max="6,241,14"/></region></default>
</spawns>
<filters>
    <any id="water"><material>water</material><material>stationary water</material></any>
    <any id="water-source"><material>water:0</material><material>stationary water:0</material></any>
    <not id="holding-hill-1"><objective>hill-1</objective></not>
    <not id="holding-hill-2"><objective>hill-2</objective></not>
    <not id="holding-hill-3"><objective>hill-3</objective></not>
