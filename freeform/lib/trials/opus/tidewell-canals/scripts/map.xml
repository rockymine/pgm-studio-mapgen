<map proto="1.5.0">
    <name>Tidewell Canals</name>
    <version>1.0.0</version>
    <objective>Hold the markets: the Campo is worth two points a second, each fish market one.</objective>
    <gamemode>koth</gamemode>
    <authors>
        <author>Claude (pgmvox trial)</author>
    </authors>
    <teams>
        <team id="red-team" color="red" max="16">Red</team>
        <team id="blue-team" color="blue" max="16">Blue</team>
    </teams>
    <filters>
        <team id="only-red">red-team</team>
        <not id="not-red">
            <team>red-team</team>
        </not>
        <team id="only-blue">blue-team</team>
        <not id="not-blue">
            <team>blue-team</team>
        </not>
    </filters>
    <spawns>
        <spawn team="red-team" kit="spawn-kit" yaw="-90">
            <region>
                <point>-69.5,41,-0.5</point>
            </region>
        </spawn>
        <spawn team="blue-team" kit="spawn-kit" yaw="90">
            <region>
                <point>69.5,41,0.5</point>
            </region>
        </spawn>
        <default yaw="90">
            <region>
                <point>0.5,70,0.5</point>
            </region>
        </default>
    </spawns>
    <regions>
        <cuboid min="-72,41,-9" max="-63,47,9" id="red-spawn"/>
        <apply enter="only-red" region="red-spawn" message="You may not enter the enemy spawn!"/>
        <apply block="never" region="red-spawn" message="You may not build in a spawn!"/>
        <cuboid min="63,41,-9" max="72,47,9" id="blue-spawn"/>
        <apply enter="only-blue" region="blue-spawn" message="You may not enter the enemy spawn!"/>
        <apply block="never" region="blue-spawn" message="You may not build in a spawn!"/>
        <cuboid min="-4,40,-4" max="4,45,4" id="campo-capture"/>
        <cuboid min="-4,40,-4" max="4,41,4" id="campo-pad"/>
        <cuboid min="-4,40,-54" max="4,45,-46" id="north-market-capture"/>
        <cuboid min="-4,40,-54" max="4,41,-46" id="north-market-pad"/>
        <cuboid min="-4,40,46" max="4,45,54" id="south-market-capture"/>
        <cuboid min="-4,40,46" max="4,41,54" id="south-market-pad"/>
        <union id="campo-progress">
            <cuboid min="-3,40,-3" max="3,41,-2"/>
            <cuboid min="-3,40,2" max="3,41,3"/>
            <cuboid min="-3,40,-2" max="-2,41,2"/>
            <cuboid min="2,40,-2" max="3,41,2"/>
        </union>
        <union id="north-market-progress">
            <cuboid min="-3,40,-53" max="3,41,-52"/>
            <cuboid min="-3,40,-48" max="3,41,-47"/>
            <cuboid min="-3,40,-52" max="-2,41,-48"/>
            <cuboid min="2,40,-52" max="3,41,-48"/>
        </union>
        <union id="south-market-progress">
            <cuboid min="-3,40,47" max="3,41,48"/>
            <cuboid min="-3,40,52" max="3,41,53"/>
            <cuboid min="-3,40,48" max="-2,41,52"/>
            <cuboid min="2,40,48" max="3,41,52"/>
        </union>
        <apply block="never" message="The quarter is not yours to build on!"/>
    </regions>
    <king>
        <hills required="false" neutral-state="true" incremental="true" show-progress="true" time-multiplier="0" permanent="false">
            <hill id="campo" name="the Campo" capture-region="campo-capture" progress-display-region="campo-progress" owner-display-region="campo-pad" capture-time="10s" points="2"/>
            <hill id="north-market" name="the North Fish Market" capture-region="north-market-capture" progress-display-region="north-market-progress" owner-display-region="north-market-pad" capture-time="10s" points="1"/>
            <hill id="south-market" name="the South Fish Market" capture-region="south-market-capture" progress-display-region="south-market-progress" owner-display-region="south-market-pad" capture-time="10s" points="1"/>
        </hills>
    </king>
    <score>
        <limit>1000</limit>
    </score>
    <kits>
        <kit id="spawn-kit">
            <item slot="0" material="iron sword" unbreakable="true"/>
            <item slot="1" material="bow" unbreakable="true">
                <enchantment level="1">infinity</enchantment>
            </item>
            <item slot="2" material="iron pickaxe" unbreakable="true">
                <enchantment level="1">efficiency</enchantment>
            </item>
            <item slot="3" material="iron axe" unbreakable="true"/>
            <item slot="4" material="wood" amount="0"/>
            <item slot="5" material="stained clay" amount="48" team-color="true"/>
            <item slot="6" material="golden apple"/>
            <item slot="7" material="water bucket"/>
            <item slot="8" material="cooked beef" amount="16"/>
            <item slot="28" material="arrow"/>
            <helmet material="leather helmet" unbreakable="true" team-color="true"/>
            <chestplate material="iron chestplate" unbreakable="true"/>
            <leggings material="chainmail leggings" unbreakable="true"/>
            <boots material="leather boots" unbreakable="true" team-color="true"/>
        </kit>
    </kits>
    <time>15m</time>
    <hunger>
        <depletion>off</depletion>
    </hunger>
</map>

