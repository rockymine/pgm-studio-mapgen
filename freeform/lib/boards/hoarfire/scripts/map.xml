<map proto="1.5.0">
    <name>Hoarfire</name>
    <version>1.0.0</version>
    <objective>Leak the enemy's Ember Core in the autumn wood and break their Rime Monument on the snow.</objective>
    <gamemode>dtc</gamemode>
    <gamemode>dtm</gamemode>
    <include id="gapple-kill-reward"/>
    <authors>
        <author>Claude Opus 5.5 (freeform, on pgmvox)</author>
    </authors>
    <kits>
        <kit id="spawn-kit">
            <item slot="0" material="iron sword" unbreakable="true"/>
            <item slot="1" material="bow" unbreakable="true">
                <enchantment level="1">infinity</enchantment>
            </item>
            <item slot="2" material="diamond pickaxe" unbreakable="true">
                <enchantment level="2">efficiency</enchantment>
            </item>
            <item slot="3" material="iron axe" unbreakable="true">
                <enchantment level="1">efficiency</enchantment>
            </item>
            <item slot="4" material="wood" amount="64" damage="1"/>
            <item slot="5" material="stained clay" amount="64" team-color="true"/>
            <item slot="6" material="golden apple"/>
            <item slot="7" material="water bucket"/>
            <item slot="8" material="cooked beef" amount="16"/>
            <item slot="28" material="arrow"/>
            <item slot="31" material="wood" amount="64" damage="1"/>
            <helmet material="leather helmet" unbreakable="true" team-color="true"/>
            <chestplate material="leather chestplate" unbreakable="true" team-color="true"/>
            <leggings material="chainmail leggings" unbreakable="true"/>
            <boots material="leather boots" unbreakable="true" team-color="true"/>
        </kit>
    </kits>
    <teams>
        <team id="red-team" color="red" max="20">Rowan</team>
        <team id="blue-team" color="blue" max="20">Sloe</team>
    </teams>
    <filters>
        <team id="only-red">red-team</team>
        <not id="not-red">
            <team>red-team</team>
        </not>
        <team id="only-blue">blue-team</team>
        <not id="not-blue">
            <team>blue-team</team>
        </not>
        <not id="block-place-void-filter">
            <void/>
        </not>
        <any id="block-break-void-filter">
            <all>
                <any>
                    <material>log</material>
                    <material>log 2</material>
                    <material>leaves</material>
                    <material>leaves 2</material>
                    <material>long grass</material>
                    <material>yellow flower</material>
                    <material>red rose</material>
                    <material>double plant</material>
                    <material>water lily</material>
                    <material>vine</material>
                </any>
                <void/>
            </all>
            <filter id="block-place-void-filter"/>
        </any>
    </filters>
    <spawns>
        <spawn team="red-team" kit="spawn-kit" yaw="0">
            <region>
                <cuboid min="-6,57,-91" max="7,58,-87"/>
            </region>
        </spawn>
        <spawn team="blue-team" kit="spawn-kit" yaw="180">
            <region>
                <cuboid min="-6,57,87" max="7,58,91"/>
            </region>
        </spawn>
        <default yaw="90">
            <region>
                <point>0.5,88,0.5</point>
            </region>
        </default>
    </spawns>
    <regions>
        <cuboid min="-11,49,-96" max="12,80,-81" id="red-spawn"/>
        <apply enter="only-red" region="red-spawn" message="You may not enter the enemy spawn!"/>
        <apply block="never" region="red-spawn" message="You may not build in a spawn!"/>
        <cuboid min="-11,49,81" max="12,80,96" id="blue-spawn"/>
        <apply enter="only-blue" region="blue-spawn" message="You may not enter the enemy spawn!"/>
        <apply block="never" region="blue-spawn" message="You may not build in a spawn!"/>
        <cuboid min="-37,55,-52" max="-34,60,-49" id="red-rime-region"/>
        <cuboid min="-37,55,49" max="-34,60,52" id="blue-rime-region"/>
        <cuboid min="36,54,-52" max="40,58,-48" id="red-ember-region"/>
        <cuboid min="36,54,48" max="40,58,52" id="blue-ember-region"/>
        <negative id="not-build-area">
            <rectangle min="-72,-16" max="72,16"/>
        </negative>
        <apply block-place="block-place-void-filter" block-break="block-break-void-filter" region="not-build-area" message="You may not edit the void!"/>
    </regions>
    <destroyables>
        <destroyable id="red-rime" name="Rowan Rime Monument" owner="red-team" materials="packed ice" completion="100%" mode-changes="true" region="red-rime-region"/>
        <destroyable id="blue-rime" name="Sloe Rime Monument" owner="blue-team" materials="packed ice" completion="100%" mode-changes="true" region="blue-rime-region"/>
    </destroyables>
    <cores>
        <core id="red-ember" name="Rowan Ember Core" team="red-team" leak="5" mode-changes="true" region="red-ember-region"/>
        <core id="blue-ember" name="Sloe Ember Core" team="blue-team" leak="5" mode-changes="true" region="blue-ember-region"/>
    </cores>
    <gamerules>
        <doFireTick>false</doFireTick>
        <randomTickSpeed>0</randomTickSpeed>
    </gamerules>
    <maxbuildheight>92</maxbuildheight>
    <portals>
        <portal y="@-64" sound="false" observers="never">
            <region>
                <below y="30"/>
            </region>
        </portal>
    </portals>
    <world>
        <timeset>10000</timeset>
        <timelock>on</timelock>
    </world>
    <block-drops>
        <rule>
            <filter>
                <any>
                    <material>wood</material>
                    <material>stained clay</material>
                </any>
            </filter>
            <drops>
                <item material="wood" chance="0"/>
            </drops>
        </rule>
    </block-drops>
    <itemkeep>
        <item>iron sword</item>
        <item>bow</item>
        <item>diamond pickaxe</item>
        <item>iron axe</item>
        <item>golden apple</item>
        <item>water bucket</item>
        <item>arrow</item>
        <item>wood</item>
        <item>stained clay</item>
        <item>cooked beef</item>
    </itemkeep>
    <itemremove>
        <item>leather helmet</item>
        <item>leather chestplate</item>
        <item>chainmail leggings</item>
        <item>leather boots</item>
        <item>packed ice</item>
        <item>obsidian</item>
        <item>flint</item>
        <item>gravel</item>
        <item>sapling</item>
        <item>apple</item>
        <item>seeds</item>
        <item>long grass</item>
        <item>red rose</item>
        <item>pumpkin</item>
    </itemremove>
    <toolrepair>
        <tool>iron sword</tool>
        <tool>bow</tool>
        <tool>diamond pickaxe</tool>
        <tool>iron axe</tool>
    </toolrepair>
    <kill-rewards>
        <kill-reward>
            <item material="wood" amount="16" damage="1"/>
            <item material="stained clay" amount="8" team-color="true"/>
        </kill-reward>
    </kill-rewards>
    <hunger>
        <depletion>off</depletion>
    </hunger>
</map>

