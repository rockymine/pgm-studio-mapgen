<map proto="1.5.0">
    <name>Coldbore</name>
    <version>0.2.0</version>
    <objective>Leak the enemy's reactor in the hall inside its mountain, then take the wool from the vault the leak opens across the station.</objective>
    <gamemode>ctw</gamemode>
    <gamemode>dtc</gamemode>
    <rules>
        <rule>A reactor's leak opens its vault's blast door: its wool cannot be reached before.</rule>
        <rule>The vault's shell is blast-proof.</rule>
    </rules>
    <include id="gapple-kill-reward"/>
    <authors>
        <author>Claude (freeform generator)</author>
    </authors>
    <contributors>
        <contributor contribution="The idea: a bunker in a cliff, a fissure, a reactor and a vault apart">rockymine</contributor>
    </contributors>
    <kits>
        <kit id="spawn-kit">
            <item slot="0" material="iron sword" unbreakable="true"/>
            <item slot="1" material="bow" unbreakable="true"/>
            <item slot="2" material="diamond pickaxe" unbreakable="true"/>
            <item slot="3" material="iron axe" unbreakable="true"/>
            <item slot="4" material="stained clay" amount="64" team-color="true"/>
            <item slot="5" material="wood" amount="48"/>
            <item slot="6" material="golden apple"/>
            <item slot="7" material="water bucket"/>
            <item slot="8" material="cooked beef" amount="16"/>
            <item slot="28" material="arrow" amount="48"/>
            <helmet material="leather helmet" unbreakable="true" team-color="true"/>
            <chestplate material="iron chestplate" unbreakable="true"/>
            <leggings material="chainmail leggings" unbreakable="true"/>
            <boots material="leather boots" unbreakable="true" team-color="true"/>
        </kit>
    </kits>
    <teams>
        <team id="red-team" color="red" max="20">Red</team>
        <team id="blue-team" color="blue" max="20">Blue</team>
    </teams>
    <filters>
        <team id="only-red">red-team</team>
        <not id="not-red">
            <team>red-team</team>
        </not>
        <team id="only-blue">blue-team</team>
        <not id="not-blue">
            <team>blue-team</team>
        </not>
        <any id="spawn-minable">
            <material>iron block</material>
        </any>
        <all id="spawn-minable-regrowth">
            <filter id="spawn-minable"/>
            <cause>world</cause>
        </all>
        <any id="woolroom-materials">
            <material>wood</material>
            <material>stained clay</material>
            <material>web</material>
            <all>
                <cause>player</cause>
                <any>
                    <material>water</material>
                    <material>stationary water</material>
                </any>
            </all>
        </any>
        <all id="reds-woolrooms-filter">
            <filter id="not-red"/>
            <filter id="woolroom-materials"/>
        </all>
        <all id="blues-woolrooms-filter">
            <filter id="not-blue"/>
            <filter id="woolroom-materials"/>
        </all>
        <deny id="block-rule">
            <all>
                <any>
                    <material>lava</material>
                    <material>stationary lava</material>
                </any>
                <cause>player</cause>
            </all>
        </deny>
    </filters>
    <spawns>
        <default yaw="90">
            <region>
                <point>0.5,116,-0.5</point>
            </region>
        </default>
        <spawn team="red-team" kit="spawn-kit" yaw="90">
            <region>
                <point>24.5,72,86.5</point>
            </region>
        </spawn>
        <spawn team="blue-team" kit="spawn-kit" yaw="270">
            <region>
                <point>-24.5,72,-86.5</point>
            </region>
        </spawn>
    </spawns>
    <regions>
        <cuboid min="14,72,76" max="38,81,93" id="red-spawn"/>
        <apply enter="only-red" region="red-spawn" message="You may not enter the enemy spawn!"/>
        <apply block-place="spawn-minable-regrowth" block-break="spawn-minable" region="red-spawn" message="You may not edit the spawn!"/>
        <cuboid min="-38,72,-93" max="-14,81,-76" id="blue-spawn"/>
        <apply enter="only-blue" region="blue-spawn" message="You may not enter the enemy spawn!"/>
        <apply block-place="spawn-minable-regrowth" block-break="spawn-minable" region="blue-spawn" message="You may not edit the spawn!"/>
        <cuboid min="-4,62,69" max="3,69,76" id="red-core-region"/>
        <cuboid min="-3,62,-76" max="4,69,-69" id="blue-core-region"/>
        <block id="orange-blue-monument">-6,73,-84</block>
        <cuboid min="26,44,70" max="45,58,89" id="orange-room"/>
        <apply enter="not-red" region="orange-room" message="You may not enter your own wool room!"/>
        <point id="orange-wool-spawn">40.5,45,84.5</point>
        <block id="cyan-red-monument">5,73,83</block>
        <cuboid min="-45,44,-89" max="-26,58,-70" id="cyan-room"/>
        <apply enter="not-blue" region="cyan-room" message="You may not enter your own wool room!"/>
        <point id="cyan-wool-spawn">-40.5,45,-84.5</point>
        <union id="red-vault-shell">
            <cuboid min="24,38,68" max="47,44,91"/>
            <cuboid min="24,44,68" max="26,60,91"/>
            <cuboid min="45,44,68" max="47,60,91"/>
            <cuboid min="26,44,68" max="45,60,70"/>
            <cuboid min="26,44,89" max="45,60,91"/>
            <cuboid min="26,58,70" max="45,60,89"/>
        </union>
        <apply region="red-vault-shell" block-place="never" block-break="never" message="The vault's shell is blast-proof: leak the reactor above it."/>
        <union id="blue-vault-shell">
            <cuboid min="-47,38,-91" max="-24,44,-68"/>
            <cuboid min="-26,44,-91" max="-24,60,-68"/>
            <cuboid min="-47,44,-91" max="-45,60,-68"/>
            <cuboid min="-45,44,-70" max="-26,60,-68"/>
            <cuboid min="-45,44,-91" max="-26,60,-89"/>
            <cuboid min="-45,58,-89" max="-26,60,-70"/>
        </union>
        <apply region="blue-vault-shell" block-place="never" block-break="never" message="The vault's shell is blast-proof: leak the reactor above it."/>
        <union id="reds-woolrooms">
            <region id="orange-room"/>
        </union>
        <apply block="reds-woolrooms-filter" region="reds-woolrooms" message="You may not edit the wool room!"/>
        <union id="blues-woolrooms">
            <region id="cyan-room"/>
        </union>
        <apply block="blues-woolrooms-filter" region="blues-woolrooms" message="You may not edit the wool room!"/>
        <union id="fill-1">
            <cuboid min="-4,62,69" max="3,69,76"/>
            <cuboid min="-5,58,68" max="4,70,77"/>
            <cuboid min="-5,50,68" max="4,58,77"/>
        </union>
        <cuboid min="25,44,76" max="26,51,80" id="fill-2"/>
        <union id="fill-3">
            <cuboid min="-3,62,-76" max="4,69,-69"/>
            <cuboid min="-4,58,-77" max="5,70,-68"/>
            <cuboid min="-4,50,-77" max="5,58,-68"/>
        </union>
        <cuboid min="-26,44,-80" max="-25,51,-76" id="fill-4"/>
        <apply block="block-rule" message="Lava may not be placed or taken."/>
    </regions>
    <renewables>
        <renewable region="red-spawn" renew-filter="spawn-minable"/>
        <renewable region="blue-spawn" renew-filter="spawn-minable"/>
    </renewables>
    <cores>
        <core id="red-core" name="Reactor" team="red-team" leak="5" mode-changes="true" region="red-core-region"/>
        <core id="blue-core" name="Reactor" team="blue-team" leak="5" mode-changes="true" region="blue-core-region"/>
    </cores>
    <wools craftable="false">
        <wool team="blue-team" color="orange" monument="orange-blue-monument" location="40.5,44,84.5"/>
        <wool team="red-team" color="cyan" monument="cyan-red-monument" location="-40.5,44,-84.5"/>
    </wools>
    <spawners>
        <spawner spawn-region="orange-wool-spawn" player-region="orange-room" delay="3s">
            <item material="wool" damage="1"/>
        </spawner>
        <spawner spawn-region="cyan-wool-spawn" player-region="cyan-room" delay="3s">
            <item material="wool" damage="9"/>
        </spawner>
    </spawners>
    <actions>
        <trigger scope="match">
            <filter>
                <completed>red-core</completed>
            </filter>
            <action>
                <fill region="fill-1" material="air"/>
                <fill region="fill-2" material="air"/>
                <message text="Red's reactor has leaked and its vault stands open: go and get the orange wool!"/>
            </action>
        </trigger>
        <trigger scope="match">
            <filter>
                <completed>blue-core</completed>
            </filter>
            <action>
                <fill region="fill-3" material="air"/>
                <fill region="fill-4" material="air"/>
                <message text="Blue's reactor has leaked and its vault stands open: go and get the cyan wool!"/>
            </action>
        </trigger>
    </actions>
    <maxbuildheight>116</maxbuildheight>
    <portals>
        <portal y="@-64" sound="false" observers="never">
            <region>
                <below y="8"/>
            </region>
        </portal>
    </portals>
    <block-drops>
        <rule>
            <filter>
                <any>
                    <material>stained clay</material>
                    <material>wood</material>
                </any>
            </filter>
            <drops>
                <item material="stained clay" chance="0"/>
            </drops>
        </rule>
    </block-drops>
    <itemkeep>
        <item>iron sword</item>
        <item>bow</item>
        <item>diamond pickaxe</item>
        <item>iron axe</item>
        <item>golden apple</item>
        <item>water bucket</item>
        <item>stained clay</item>
        <item>wood</item>
        <item>cooked beef</item>
        <item>arrow</item>
    </itemkeep>
    <itemremove>
        <item>leather helmet</item>
        <item>iron chestplate</item>
        <item>chainmail leggings</item>
        <item>leather boots</item>
        <item>obsidian</item>
        <item>flint</item>
        <item>gravel</item>
        <item>sapling</item>
        <item>apple</item>
    </itemremove>
    <toolrepair>
        <tool>iron sword</tool>
        <tool>bow</tool>
        <tool>diamond pickaxe</tool>
        <tool>iron axe</tool>
    </toolrepair>
    <kill-rewards>
        <kill-reward>
            <item material="stained clay" amount="8" team-color="true"/>
            <item material="wood" amount="16"/>
        </kill-reward>
    </kill-rewards>
    <hunger>
        <depletion>off</depletion>
    </hunger>
</map>

