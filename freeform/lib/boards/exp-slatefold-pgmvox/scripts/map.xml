<map proto="1.5.0">
    <name>Slatefold</name>
    <version>1.0.0</version>
    <objective>Capture the enemy's two wools: the Kiln's and the Winding House's.</objective>
    <gamemode>ctw</gamemode>
    <authors>
        <author>Claude Sonnet 5.5 (freeform generator, on pgmvox)</author>
    </authors>
    <teams>
        <team id="red-team" color="red" max="12">Red</team>
        <team id="blue-team" color="blue" max="12">Blue</team>
    </teams>
    <filters>
        <team id="only-red">red-team</team>
        <not id="not-red">
            <team>red-team</team>
        </not>
        <team id="only-blue">blue-team</team>
        <not id="not-blue">
            <team>blue-team</team>
        </not>
        <any id="spawn-minable">
            <material>iron ore</material>
        </any>
        <all id="spawn-minable-regrowth">
            <filter id="spawn-minable"/>
            <cause>world</cause>
        </all>
        <any id="woolroom-materials">
            <material>wood</material>
            <material>stained clay</material>
            <material>web</material>
            <all>
                <cause>player</cause>
                <any>
                    <material>water</material>
                    <material>stationary water</material>
                </any>
            </all>
        </any>
        <all id="reds-woolrooms-filter">
            <filter id="not-red"/>
            <filter id="woolroom-materials"/>
        </all>
        <all id="blues-woolrooms-filter">
            <filter id="not-blue"/>
            <filter id="woolroom-materials"/>
        </all>
        <not id="not-void">
            <void/>
        </not>
    </filters>
    <spawns>
        <spawn team="red-team" kit="spawn-kit" yaw="0">
            <region>
                <point>0.5,75,-92.5</point>
            </region>
        </spawn>
        <spawn team="blue-team" kit="spawn-kit" yaw="180">
            <region>
                <point>0.5,75,92.5</point>
            </region>
        </spawn>
        <default yaw="90">
            <region>
                <point>0.5,96,0.5</point>
            </region>
        </default>
    </spawns>
    <regions>
        <cuboid min="-38,0,-106" max="33,128,-81" id="red-spawn"/>
        <apply enter="only-red" region="red-spawn" message="You may not enter the enemy spawn!"/>
        <apply block-place="spawn-minable-regrowth" block-break="spawn-minable" region="red-spawn" message="You may not edit the spawn!"/>
        <cuboid min="-38,0,81" max="33,128,106" id="blue-spawn"/>
        <apply enter="only-blue" region="blue-spawn" message="You may not enter the enemy spawn!"/>
        <apply block-place="spawn-minable-regrowth" block-break="spawn-minable" region="blue-spawn" message="You may not edit the spawn!"/>
        <block id="orange-blue-monument">-15,75,85</block>
        <cuboid min="55,59,-73" max="65,64,-62" id="orange-room"/>
        <apply enter="not-red" region="orange-room" message="You may not enter your own wool room!"/>
        <point id="orange-wool-spawn">60.5,60,-65.5</point>
        <block id="magenta-red-monument">-15,75,-86</block>
        <cuboid min="55,59,62" max="65,64,73" id="magenta-room"/>
        <apply enter="not-blue" region="magenta-room" message="You may not enter your own wool room!"/>
        <point id="magenta-wool-spawn">60.5,60,65.5</point>
        <block id="cyan-blue-monument">15,75,85</block>
        <cuboid min="-79,83,-95" max="-71,88,-86" id="cyan-room"/>
        <apply enter="not-red" region="cyan-room" message="You may not enter your own wool room!"/>
        <point id="cyan-wool-spawn">-75.5,84,-88.5</point>
        <block id="yellow-red-monument">15,75,-86</block>
        <cuboid min="-79,83,86" max="-71,88,95" id="yellow-room"/>
        <apply enter="not-blue" region="yellow-room" message="You may not enter your own wool room!"/>
        <point id="yellow-wool-spawn">-75.5,84,88.5</point>
        <union id="reds-woolrooms">
            <region id="orange-room"/>
            <region id="cyan-room"/>
        </union>
        <apply block="reds-woolrooms-filter" region="reds-woolrooms" message="You may not edit the wool room!"/>
        <union id="blues-woolrooms">
            <region id="magenta-room"/>
            <region id="yellow-room"/>
        </union>
        <apply block="blues-woolrooms-filter" region="blues-woolrooms" message="You may not edit the wool room!"/>
        <below y="36" id="the-fall"/>
        <apply kit="fall-kill" region="the-fall"/>
        <apply block-place="not-void" message="You may not build in the void!"/>
    </regions>
    <renewables>
        <renewable region="red-spawn" renew-filter="spawn-minable"/>
        <renewable region="blue-spawn" renew-filter="spawn-minable"/>
    </renewables>
    <wools craftable="false">
        <wool team="blue-team" color="orange" monument="orange-blue-monument" location="60.5,59,-67.5"/>
        <wool team="red-team" color="magenta" monument="magenta-red-monument" location="60.5,59,67.5"/>
        <wool team="blue-team" color="cyan" monument="cyan-blue-monument" location="-75.5,83,-90.5"/>
        <wool team="red-team" color="yellow" monument="yellow-red-monument" location="-75.5,83,90.5"/>
    </wools>
    <spawners>
        <spawner spawn-region="orange-wool-spawn" player-region="orange-room" delay="1.5s">
            <item material="wool" damage="1"/>
        </spawner>
        <spawner spawn-region="magenta-wool-spawn" player-region="magenta-room" delay="1.5s">
            <item material="wool" damage="2"/>
        </spawner>
        <spawner spawn-region="cyan-wool-spawn" player-region="cyan-room" delay="1.5s">
            <item material="wool" damage="9"/>
        </spawner>
        <spawner spawn-region="yellow-wool-spawn" player-region="yellow-room" delay="1.5s">
            <item material="wool" damage="4"/>
        </spawner>
    </spawners>
    <kits>
        <kit id="spawn-kit">
            <item slot="0" material="iron sword" unbreakable="true"/>
            <item slot="1" material="bow" unbreakable="true">
                <enchantment level="1">infinity</enchantment>
            </item>
            <item slot="2" material="iron pickaxe" unbreakable="true">
                <enchantment level="1">efficiency</enchantment>
            </item>
            <item slot="3" material="iron axe" unbreakable="true">
                <enchantment level="1">efficiency</enchantment>
            </item>
            <item slot="4" material="wood" amount="64" damage="1"/>
            <item slot="5" material="stained clay" amount="64" team-color="true"/>
            <item slot="6" material="golden apple"/>
            <item slot="7" material="water bucket"/>
            <item slot="8" material="cooked beef" amount="16"/>
            <item slot="28" material="arrow"/>
            <item slot="29" material="shears" unbreakable="true"/>
            <item slot="31" material="wood" amount="64" damage="1"/>
            <helmet material="leather helmet" unbreakable="true" team-color="true"/>
            <chestplate material="leather chestplate" unbreakable="true" team-color="true"/>
            <leggings material="chainmail leggings" unbreakable="true"/>
            <boots material="leather boots" unbreakable="true" team-color="true"/>
        </kit>
        <kit id="fall-kill" force="true">
            <effect duration="1" amplifier="5">instant damage</effect>
        </kit>
    </kits>
    <itemkeep>
        <item>iron sword</item>
        <item>bow</item>
        <item>iron pickaxe</item>
        <item>iron axe</item>
        <item>water bucket</item>
        <item>shears</item>
    </itemkeep>
    <kill-rewards>
        <kill-reward>
            <item material="wood" damage="1" amount="16"/>
            <item material="golden apple"/>
        </kill-reward>
    </kill-rewards>
    <maxbuildheight>104</maxbuildheight>
</map>

