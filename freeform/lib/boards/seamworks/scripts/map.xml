<map proto="1.5.0">
    <name>Seamworks</name>
    <version>0.1.0</version>
    <objective>Destroy the enemy monument, or carry their flag into your spawn 3 times.</objective>
    <gamemode>dtm</gamemode>
    <gamemode>ctf</gamemode>
    <include id="gapple-kill-reward"/>
    <authors>
        <author>Claude (freeform generator)</author>
    </authors>
    <kits>
        <kit id="spawn-kit">
            <clear/>
            <item slot="0" material="iron sword" unbreakable="true"/>
            <item slot="1" material="bow" unbreakable="true"/>
            <item slot="2" material="iron pickaxe" unbreakable="true">
                <enchantment level="2">efficiency</enchantment>
            </item>
            <item slot="3" material="iron axe" unbreakable="true"/>
            <item slot="4" material="wood" amount="64"/>
            <item slot="5" material="golden apple" amount="2"/>
            <item slot="6" material="wood" amount="64"/>
            <item slot="9" material="arrow" amount="32"/>
            <helmet material="leather helmet" unbreakable="true" team-color="true"/>
            <chestplate material="leather chestplate" unbreakable="true" team-color="true"/>
            <leggings material="chainmail leggings" unbreakable="true"/>
            <boots material="iron boots" unbreakable="true"/>
        </kit>
    </kits>
    <teams>
        <team id="red-team" color="red" max="8">Red</team>
        <team id="blue-team" color="blue" max="8">Blue</team>
    </teams>
    <filters>
        <team id="only-red">red-team</team>
        <not id="not-red">
            <team>red-team</team>
        </not>
        <team id="only-blue">blue-team</team>
        <not id="not-blue">
            <team>blue-team</team>
        </not>
        <carrying-flag id="red-flag-carrier">red-flag</carrying-flag>
        <carrying-flag id="blue-flag-carrier">blue-flag</carrying-flag>
        <not id="block-place-void-filter">
            <void/>
        </not>
        <any id="block-break-void-filter">
            <all>
                <any>
                    <material>log</material>
                    <material>log 2</material>
                    <material>leaves</material>
                    <material>leaves 2</material>
                    <material>long grass</material>
                    <material>yellow flower</material>
                    <material>red rose</material>
                    <material>double plant</material>
                    <material>water lily</material>
                    <material>vine</material>
                </any>
                <void/>
            </all>
            <filter id="block-place-void-filter"/>
        </any>
    </filters>
    <spawns>
        <default yaw="0" pitch="60">
            <region>
                <point>150.5,78,70.5</point>
            </region>
        </default>
        <spawn team="red-team" kit="spawn-kit" yaw="270">
            <region>
                <point>11.5,40,32.5</point>
            </region>
        </spawn>
        <spawn team="blue-team" kit="spawn-kit" yaw="90">
            <region>
                <point>288.5,40,107.5</point>
            </region>
        </spawn>
    </spawns>
    <regions>
        <cuboid min="7,40,21" max="17,50,45" id="red-spawn"/>
        <apply enter="only-red" region="red-spawn" message="You may not enter the enemy spawn!"/>
        <apply block="never" region="red-spawn" message="You may not build in a spawn!"/>
        <cuboid min="283,40,95" max="293,50,119" id="blue-spawn"/>
        <apply enter="only-blue" region="blue-spawn" message="You may not enter the enemy spawn!"/>
        <apply block="never" region="blue-spawn" message="You may not build in a spawn!"/>
        <cuboid min="109,53,38" max="111,55,40" id="red-monument-region"/>
        <cuboid min="189,53,100" max="191,55,102" id="blue-monument-region"/>
        <cuboid min="149,37,69" max="151,39,71" id="golden-apple"/>
        <cuboid min="145,37,65" max="154,41,74" id="golden-apple-near"/>
        <cuboid min="283,40,95" max="293,50,119" id="blue-net-region"/>
        <cuboid min="7,40,21" max="17,50,45" id="red-net-region"/>
        <apply block-place="block-place-void-filter" block-break="block-break-void-filter" message="You may not edit the void!"/>
    </regions>
    <flags>
        <flag id="red-flag" name="Red Flag" color="red" shared="false" points-rate="0" owner="red-team">
            <post return-time="0s" respawn-time="10s">
                <post name="passage" yaw="270">22.5,40,71.5</post>
                <post name="boiler house" yaw="270">9.5,37,106.5</post>
                <post name="forecourt" yaw="270">52.5,40,80.5</post>
            </post>
        </flag>
        <flag id="blue-flag" name="Blue Flag" color="blue" shared="false" points-rate="0" owner="blue-team">
            <post return-time="0s" respawn-time="10s">
                <post name="passage" yaw="90">277.5,40,68.5</post>
                <post name="boiler house" yaw="90">290.5,37,33.5</post>
                <post name="forecourt" yaw="90">247.5,40,59.5</post>
            </post>
        </flag>
        <net id="blue-net" owner="blue-team" flags="red-flag" points="1" region="blue-net-region"/>
        <net id="red-net" owner="red-team" flags="blue-flag" points="1" region="red-net-region"/>
    </flags>
    <score>
        <limit>3</limit>
    </score>
    <destroyables>
        <destroyable id="red-monument" name="Red Monument" owner="red-team" materials="obsidian" completion="100%" mode-changes="true" region="red-monument-region"/>
        <destroyable id="blue-monument" name="Blue Monument" owner="blue-team" materials="obsidian" completion="100%" mode-changes="true" region="blue-monument-region"/>
    </destroyables>
    <spawners>
        <spawner spawn-region="golden-apple" player-region="golden-apple-near" delay="45s" max-entities="1">
            <item material="golden apple"/>
        </spawner>
    </spawners>
    <maxbuildheight>78</maxbuildheight>
    <time>20m</time>
    <block-drops>
        <rule>
            <filter>
                <material>wood</material>
            </filter>
            <drops>
                <item material="wood" chance="0"/>
            </drops>
        </rule>
    </block-drops>
    <itemkeep>
        <item>iron sword</item>
        <item>bow</item>
        <item>iron pickaxe</item>
        <item>iron axe</item>
        <item>wood</item>
        <item>golden apple</item>
        <item>arrow</item>
    </itemkeep>
    <itemremove>
        <item>leather helmet</item>
        <item>leather chestplate</item>
        <item>chainmail leggings</item>
        <item>iron boots</item>
        <item>obsidian</item>
        <item>banner</item>
        <item>sapling</item>
        <item>apple</item>
        <item>pumpkin</item>
        <item>melon</item>
        <item>melon seeds</item>
    </itemremove>
    <toolrepair>
        <tool>iron sword</tool>
        <tool>bow</tool>
        <tool>iron pickaxe</tool>
        <tool>iron axe</tool>
    </toolrepair>
    <kill-rewards>
        <kill-reward>
            <item material="wood" amount="16"/>
        </kill-reward>
    </kill-rewards>
    <hunger>
        <depletion>off</depletion>
    </hunger>
</map>

