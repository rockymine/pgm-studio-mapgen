<map proto="1.5.0">
    <name>Riad</name>
    <version>0.1.0</version>
    <objective>Hold the flag for 200 seconds. While your team holds it, your dead wait.</objective>
    <gamemode>kotf</gamemode>
    <authors>
        <author>Claude (freeform generator)</author>
    </authors>
    <kits>
        <kit id="spawn-kit">
            <clear/>
            <item slot="0" material="stone sword" unbreakable="true"/>
            <item slot="1" material="bow" unbreakable="true"/>
            <item slot="2" material="golden apple"/>
            <item slot="3" material="compass"/>
            <item slot="8" material="arrow" amount="12"/>
            <helmet material="leather helmet" unbreakable="true" team-color="true"/>
            <chestplate material="leather chestplate" unbreakable="true" team-color="true"/>
            <leggings material="chainmail leggings" unbreakable="true">
                <enchantment level="3">projectile_protection</enchantment>
            </leggings>
            <boots material="iron boots" unbreakable="true"/>
            <effect duration="7.5s" amplifier="5">resistance</effect>
            <game-mode>adventure</game-mode>
        </kit>
        <kit id="flag-kit" force="true">
            <effect duration="3s" amplifier="2">absorption</effect>
            <effect>slowness</effect>
            <max-health>8</max-health>
            <action>
                <enchant-item ignore-metadata="true" enchantment="projectile_protection" level="2">
                    <find material="chainmail leggings"/>
                </enchant-item>
            </action>
        </kit>
        <kit id="reset-health" force="true">
            <effect duration="0s" amplifier="0">slowness</effect>
            <effect duration="2s" amplifier="10">regeneration</effect>
            <max-health>20</max-health>
            <action>
                <enchant-item ignore-metadata="true" enchantment="projectile_protection" level="3">
                    <find material="chainmail leggings"/>
                </enchant-item>
            </action>
            <action>
                <switch-scope inner="match">
                    <switch-scope inner="player" filter="all(alive,not(flag-carrier))">
                        <kit>
                            <effect duration="4s" amplifier="3">regeneration</effect>
                        </kit>
                    </switch-scope>
                </switch-scope>
            </action>
        </kit>
    </kits>
    <teams>
        <team id="red-team" color="red" max="16">Red</team>
        <team id="blue-team" color="blue" max="16">Blue</team>
    </teams>
    <filters>
        <team id="only-red">red-team</team>
        <not id="not-red">
            <team>red-team</team>
        </not>
        <team id="only-blue">blue-team</team>
        <not id="not-blue">
            <team>blue-team</team>
        </not>
        <any id="flag-free">
            <carrying-flag id="flag-carrier">flag</carrying-flag>
            <not>
                <same-team>
                    <filter id="flag-carrier"/>
                </same-team>
            </not>
        </any>
    </filters>
    <spawns>
        <default yaw="90">
            <region>
                <point>0.5,40,0.5</point>
            </region>
        </default>
        <spawn team="red-team" kit="spawn-kit" filter="flag-free" yaw="0">
            <region>
                <point>0.5,23,-51.5</point>
            </region>
        </spawn>
        <spawn team="blue-team" kit="spawn-kit" filter="flag-free" yaw="180">
            <region>
                <point>0.5,23,52.5</point>
            </region>
        </spawn>
    </spawns>
    <regions>
        <cuboid min="-10,22,-56" max="11,30,-45" id="red-spawn"/>
        <apply enter="only-red" region="red-spawn" message="You may not enter the enemy spawn!"/>
        <apply block="never" region="red-spawn" message="You may not build in a spawn!"/>
        <cuboid min="-10,22,46" max="11,30,57" id="blue-spawn"/>
        <apply enter="only-blue" region="blue-spawn" message="You may not enter the enemy spawn!"/>
        <apply block="never" region="blue-spawn" message="You may not build in a spawn!"/>
        <apply block="never" use="never"/>
    </regions>
    <flags>
        <flag id="flag" name="Flag" color="purple" shared="true" points-rate="1" pickup-kit="flag-kit" drop-kit="reset-health" flag-proximity-metric="none" show-respawn-on-pickup="false">
            <post return-time="0s" respawn-time="15s">
                <post name="the Cistern">0.5,25,0.5</post>
                <post name="the Mirador" yaw="90">-41.5,25,0.5</post>
                <post name="the Minaret" yaw="-90">30.5,23,0.5</post>
            </post>
        </flag>
    </flags>
    <compass show-distance="true">
        <player filter="flag-carrier" show-player="true" name="Flag Carrier"/>
    </compass>
    <score>
        <limit>200</limit>
    </score>
    <respawn delay="3s" auto="true" spectate="true">
        <message>{"translate":"death.respawn.confirmed.waiting.flagDropped"}</message>
    </respawn>
    <world>
        <timeset>6000</timeset>
        <timelock>on</timelock>
    </world>
    <itemkeep>
        <item>stone sword</item>
        <item>bow</item>
        <item>golden apple</item>
        <item>compass</item>
        <item>arrow</item>
    </itemkeep>
    <itemremove>
        <item>leather helmet</item>
        <item>leather chestplate</item>
        <item>chainmail leggings</item>
        <item>iron boots</item>
        <item>banner</item>
        <item>sapling</item>
        <item>apple</item>
        <item>seeds</item>
        <item>long grass</item>
        <item>yellow flower</item>
        <item>red rose</item>
    </itemremove>
    <toolrepair>
        <tool>stone sword</tool>
        <tool>bow</tool>
    </toolrepair>
    <kill-rewards>
        <kill-reward>
            <item material="arrow" amount="6"/>
        </kill-reward>
    </kill-rewards>
    <hunger>
        <depletion>off</depletion>
    </hunger>
</map>

