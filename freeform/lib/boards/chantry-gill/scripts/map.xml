    <teams>
        <team id="blue-team" color="blue" max="16">Blue</team>
        <team id="red-team" color="red" max="16">Red</team>
    </teams>
    <filters>
        <team id="only-blue">blue-team</team>
        <not id="not-blue">
            <team>blue-team</team>
        </not>
        <team id="only-red">red-team</team>
        <not id="not-red">
            <team>red-team</team>
        </not>
        <not id="block-place-void-filter">
            <void/>
        </not>
        <any id="block-break-void-filter">
            <all>
                <any>
                    <material>log</material>
                    <material>log 2</material>
                    <material>leaves</material>
                    <material>leaves 2</material>
                    <material>long grass</material>
                    <material>yellow flower</material>
                    <material>red rose</material>
                    <material>double plant</material>
                    <material>water lily</material>
                    <material>vine</material>
                </any>
                <void/>
            </all>
            <filter id="block-place-void-filter"/>
        </any>
    </filters>
    <spawns>
        <spawn team="blue-team" kit="spawn-kit" yaw="180">
            <region>
                <point>4.5,24,95.5</point>
            </region>
        </spawn>
        <spawn team="red-team" kit="spawn-kit" yaw="0">
