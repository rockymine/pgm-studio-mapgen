<map proto="1.5.0">
    <name>Lantern Karst</name>
    <version>0.2.0</version>
    <objective>Capture the enemy's two wools: the Pillar Shrine's and the Tea Store's.</objective>
    <gamemode>ctw</gamemode>
    <authors>
        <author>Claude (freeform generator, ported onto pgmvox)</author>
    </authors>
    <teams>
        <team id="red-team" color="red" max="16">Red</team>
        <team id="blue-team" color="blue" max="16">Blue</team>
    </teams>
    <filters>
        <team id="only-red">red-team</team>
        <not id="not-red">
            <team>red-team</team>
        </not>
        <team id="only-blue">blue-team</team>
        <not id="not-blue">
            <team>blue-team</team>
        </not>
        <material id="only-iron">iron block</material>
        <all id="only-iron-cause-world">
            <material>iron block</material>
            <cause>world</cause>
        </all>
        <any id="woolroom-materials">
            <material>wood</material>
            <material>stained clay</material>
            <material>web</material>
            <all>
                <cause>player</cause>
                <any>
                    <material>water</material>
                    <material>stationary water</material>
                </any>
            </all>
        </any>
        <all id="reds-woolrooms-filter">
            <filter id="not-red"/>
            <filter id="woolroom-materials"/>
        </all>
        <all id="blues-woolrooms-filter">
            <filter id="not-blue"/>
            <filter id="woolroom-materials"/>
        </all>
        <not id="not-void">
            <void/>
        </not>
    </filters>
    <spawns>
        <spawn team="red-team" kit="spawn-kit" yaw="0">
            <region>
                <point>-0.5,73,-104.5</point>
            </region>
        </spawn>
        <spawn team="blue-team" kit="spawn-kit" yaw="180">
            <region>
                <point>0.5,73,104.5</point>
            </region>
        </spawn>
        <default yaw="90">
            <region>
                <point>0.5,90,0.5</point>
            </region>
        </default>
    </spawns>
    <regions>
        <cuboid min="-20,0,-120" max="20,128,-78" id="red-spawn"/>
        <cuboid min="-20,0,78" max="20,128,120" id="blue-spawn"/>
        <block id="lime-blue-monument">3,71,88</block>
        <cuboid min="-66,75,-97" max="-58,92,-89" id="lime-room"/>
        <apply enter="not-red" region="lime-room" message="You may not enter your own wool room!"/>
        <block id="magenta-red-monument">-4,71,-89</block>
        <cuboid min="58,75,89" max="66,92,97" id="magenta-room"/>
        <apply enter="not-blue" region="magenta-room" message="You may not enter your own wool room!"/>
        <block id="yellow-blue-monument">-4,71,88</block>
        <cuboid min="47,71,-110" max="67,84,-96" id="yellow-room"/>
        <apply enter="not-red" region="yellow-room" message="You may not enter your own wool room!"/>
        <block id="orange-red-monument">3,71,-89</block>
        <cuboid min="-67,71,96" max="-47,84,110" id="orange-room"/>
        <apply enter="not-blue" region="orange-room" message="You may not enter your own wool room!"/>
        <union id="spawns">
            <region id="red-spawn"/>
            <region id="blue-spawn"/>
        </union>
        <apply enter="only-red" region="red-spawn" message="You may not enter the enemy's spawn!"/>
        <apply enter="only-blue" region="blue-spawn" message="You may not enter the enemy's spawn!"/>
        <apply block-place="only-iron-cause-world" block-break="only-iron" region="spawns" message="You may not edit the spawn!"/>
        <union id="reds-woolrooms">
            <region id="lime-room"/>
            <region id="yellow-room"/>
        </union>
        <apply block="reds-woolrooms-filter" region="reds-woolrooms" message="You may not edit the wool room!"/>
        <point id="lime-wool-spawn">-62.5,76,-91.5</point>
        <point id="yellow-wool-spawn">56.5,72,-103.5</point>
        <union id="blues-woolrooms">
            <region id="magenta-room"/>
            <region id="orange-room"/>
        </union>
        <apply block="blues-woolrooms-filter" region="blues-woolrooms" message="You may not edit the wool room!"/>
        <point id="magenta-wool-spawn">62.5,76,95.5</point>
        <point id="orange-wool-spawn">-56.5,72,107.5</point>
        <apply block-place="not-void" message="You may not build in the void!"/>
    </regions>
    <wools craftable="false">
        <wool team="blue-team" color="lime" monument="lime-blue-monument" location="-62.5,75,-93.5"/>
        <wool team="red-team" color="magenta" monument="magenta-red-monument" location="62.5,75,93.5"/>
        <wool team="blue-team" color="yellow" monument="yellow-blue-monument" location="56.5,71,-105.5"/>
        <wool team="red-team" color="orange" monument="orange-red-monument" location="-56.5,71,105.5"/>
    </wools>
    <kits>
        <kit id="spawn-kit">
            <item slot="0" material="iron sword" unbreakable="true"/>
            <item slot="1" material="bow" unbreakable="true">
                <enchantment level="1">infinity</enchantment>
            </item>
            <item slot="2" material="iron pickaxe" unbreakable="true">
                <enchantment level="1">efficiency</enchantment>
            </item>
            <item slot="3" material="iron axe" unbreakable="true">
                <enchantment level="1">efficiency</enchantment>
            </item>
            <item slot="4" material="wood" damage="1" amount="64"/>
            <item slot="5" material="stained clay" amount="48" team-color="true"/>
            <item slot="6" material="golden apple"/>
            <item slot="7" material="water bucket"/>
            <item slot="8" material="cooked beef" amount="16"/>
            <item slot="28" material="arrow"/>
            <item slot="29" material="shears" unbreakable="true"/>
            <item slot="31" material="wood" damage="1" amount="64"/>
            <helmet material="leather helmet" unbreakable="true" team-color="true"/>
            <chestplate material="leather chestplate" unbreakable="true" team-color="true"/>
            <leggings material="chainmail leggings" unbreakable="true"/>
            <boots material="leather boots" unbreakable="true" team-color="true"/>
        </kit>
    </kits>
    <portals>
        <portal y="@-64" sound="false" observers="never">
            <region>
                <below y="40"/>
            </region>
        </portal>
    </portals>
    <renewables>
        <renewable region="spawns" renew-filter="only-iron"/>
    </renewables>
    <spawners>
        <spawner spawn-region="lime-wool-spawn" player-region="lime-room" delay="1.5s">
            <item material="wool" damage="5"/>
        </spawner>
        <spawner spawn-region="yellow-wool-spawn" player-region="yellow-room" delay="1.5s">
            <item material="wool" damage="4"/>
        </spawner>
        <spawner spawn-region="magenta-wool-spawn" player-region="magenta-room" delay="1.5s">
            <item material="wool" damage="2"/>
        </spawner>
        <spawner spawn-region="orange-wool-spawn" player-region="orange-room" delay="1.5s">
            <item material="wool" damage="1"/>
        </spawner>
    </spawners>
    <itemkeep>
        <item>iron sword</item>
        <item>bow</item>
        <item>iron pickaxe</item>
        <item>iron axe</item>
        <item>water bucket</item>
        <item>shears</item>
    </itemkeep>
    <kill-rewards>
        <kill-reward>
            <item material="wood" damage="1" amount="16"/>
            <item material="golden apple"/>
        </kill-reward>
    </kill-rewards>
    <maxbuildheight>92</maxbuildheight>
</map>

