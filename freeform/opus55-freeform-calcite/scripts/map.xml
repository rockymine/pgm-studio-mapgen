<map proto="1.5.0">
<name>Calcite</name>
<version>0.1.0</version>
<objective>Hold the hills: the Middle pays double. First to 600 points.</objective>
<gamemode>koth</gamemode>
<authors>
    <author>Claude (freeform generator)</author>
</authors>
<teams>
    <team id="red-team" color="red" max="16">Red</team>
    <team id="blue-team" color="blue" max="16">Blue</team>
</teams>
<respawn delay="3s" auto="true"/>
<time>15m</time>
<kits>
    <kit id="spawn-kit">
        <clear/>
        <item slot="0" unbreakable="true" material="stone sword"/>
        <item slot="1" unbreakable="true" material="bow"/>
        <item slot="2" material="golden apple"/>
        <item slot="8" amount="16" material="arrow"/>
        <helmet unbreakable="true" team-color="true" material="leather helmet"/>
        <chestplate unbreakable="true" team-color="true" material="leather chestplate"/>
        <leggings unbreakable="true" material="chainmail leggings"/>
        <boots unbreakable="true" material="iron boots"/>
        <effect duration="3s" amplifier="5">resistance</effect>
    </kit>
    <!-- a pad marks its rider, and fall damage is denied until they have landed -->
    <kit id="used-jump-pad">
        <action scope="player">
            <set var="fall_variable" value="1"/>
        </action>
    </kit>
    <give>
        <filter>
            <all>
                <after duration="1s">
                    <not>
                        <region id="jump-pads"/>
                    </not>
                </after>
                <after duration="0.2s">
                    <grounded/>
                </after>
            </all>
        </filter>
        <kit>
            <action scope="player">
                <set var="fall_variable" value="0"/>
            </action>
        </kit>
    </give>
</kits>
<variables>
    <variable id="fall_variable" scope="player" default="0"/>
</variables>
<damage>
    <deny>
        <all>
            <cause>fall</cause>
            <variable var="fall_variable">1</variable>
        </all>
    </deny>
</damage>
<spawns>
    <default yaw="90">
        <region><point>0.5,40,0.5</point></region>
    </default>
    <spawn team="red-team" kit="spawn-kit" yaw="-90">
        <region><point>-51.5,29,-0.5</point></region>
    </spawn>
    <spawn team="blue-team" kit="spawn-kit" yaw="90">
        <region><point>51.5,29,0.5</point></region>
    </spawn>
</spawns>
<filters>
    <team id="only-red">red-team</team>
    <team id="only-blue">blue-team</team>
</filters>
<regions>
    <rectangle id="red-spawn" min="-55,-6" max="-45,6"/>
    <rectangle id="blue-spawn" min="45,-6" max="55,6"/>
    <!-- the hills: where a player stands to capture, and the wool ring that shows the holder -->
    <cuboid id="mid-capture" min="-4,22,-4" max="4,27,4"/>
    <cuboid id="mid-ring" min="-4,22,-4" max="4,23,4"/>
    <cuboid id="north-capture" min="-4,23,-34" max="4,28,-26"/>
    <cuboid id="north-ring" min="-4,23,-34" max="4,24,-26"/>
    <cuboid id="south-capture" min="-4,23,26" max="4,28,34"/>
    <cuboid id="south-ring" min="-4,23,26" max="4,24,34"/>
    <!-- the pads: four on the Middle's apron, two to each side hill's flanks; two in the Ledge's corners over the lava onto the Middle -->
    <union id="jump-pads">
        <cuboid id="pad-mid-nw" min="-6,20,-9" max="-4,22,-7"/>
        <cuboid id="pad-mid-ne" min="4,20,-9" max="6,22,-7"/>
        <cuboid id="pad-mid-se" min="4,20,7" max="6,22,9"/>
        <cuboid id="pad-mid-sw" min="-6,20,7" max="-4,22,9"/>
        <cuboid id="pad-ledge-nw" min="-29,17,-25" max="-26,19,-22"/>
        <cuboid id="pad-ledge-se" min="26,17,22" max="29,19,25"/>
    </union>
    <apply region="pad-mid-nw" kit="used-jump-pad" velocity="-1.08,0.75,-2.74"/>
    <apply region="pad-mid-ne" kit="used-jump-pad" velocity="1.08,0.75,-2.74"/>
    <apply region="pad-mid-se" kit="used-jump-pad" velocity="1.08,0.75,2.74"/>
    <apply region="pad-mid-sw" kit="used-jump-pad" velocity="-1.08,0.75,2.74"/>
    <apply region="pad-ledge-nw" kit="used-jump-pad" velocity="2.21,0.9,1.88"/>
    <apply region="pad-ledge-se" kit="used-jump-pad" velocity="-2.21,0.9,-1.88"/>
    <!-- the spawners: golden apples in the Spring under the Middle; arrows in two diagonal corners of the Ledge -->
    <cuboid id="apples" min="-1,14,-1" max="1,15,1"/>
    <cuboid id="arrows-ne" min="25,17,-23" max="26,18,-22"/>
    <cuboid id="arrows-sw" min="-26,17,21" max="-25,18,22"/>
    <apply enter="only-red" region="red-spawn" message="You may not enter the enemy spawn!"/>
    <apply enter="only-blue" region="blue-spawn" message="You may not enter the enemy spawn!"/>
    <apply block="never" use="never"/>
</regions>
<king>
    <hills required="false" capture-time="5s" points="1" time-multiplier="0" show-progress="true"
           neutral-state="true" incremental="true" permanent="false">
        <hill id="mid" name="the Middle" capture="mid-capture" progress="mid-ring" captured="mid-ring" points="2"/>
        <hill id="north" name="the North Hill" capture="north-capture" progress="north-ring" captured="north-ring"/>
        <hill id="south" name="the South Hill" capture="south-capture" progress="south-ring" captured="south-ring"/>
    </hills>
</king>
<score>
    <limit>600</limit>
</score>
<spawners>
    <spawner spawn-region="apples" delay="30s" max-entities="1">
        <item material="golden apple"/>
    </spawner>
    <spawner spawn-region="arrows-ne" delay="10s" max-entities="8">
        <item material="arrow" amount="4"/>
    </spawner>
    <spawner spawn-region="arrows-sw" delay="10s" max-entities="8">
        <item material="arrow" amount="4"/>
    </spawner>
</spawners>
<toolrepair>
    <tool>stone sword</tool>
    <tool>bow</tool>
</toolrepair>
<itemkeep>
    <item>stone sword</item>
    <item>bow</item>
    <item>arrow</item>
</itemkeep>
<itemremove>
    <item>leather helmet</item>
    <item>leather chestplate</item>
    <item>chainmail leggings</item>
    <item>iron boots</item>
</itemremove>
<kill-rewards>
    <kill-reward>
        <item amount="6" material="arrow"/>
    </kill-reward>
</kill-rewards>
<hunger>
    <depletion>off</depletion>
</hunger>
</map>
