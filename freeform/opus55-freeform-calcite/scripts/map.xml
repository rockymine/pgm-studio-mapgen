<map proto="1.5.0">
    <name>Calcite</name>
    <version>0.1.0</version>
    <objective>Hold the hills: the Middle pays double. First to 600 points.</objective>
    <gamemode>koth</gamemode>
    <authors>
        <author>Claude (freeform generator)</author>
    </authors>
    <kits>
        <kit id="spawn-kit">
            <clear/>
            <item slot="0" material="stone sword" unbreakable="true"/>
            <item slot="1" material="bow" unbreakable="true"/>
            <item slot="2" material="golden apple"/>
            <item slot="8" material="arrow" amount="16"/>
            <helmet material="leather helmet" unbreakable="true" team-color="true"/>
            <chestplate material="leather chestplate" unbreakable="true" team-color="true"/>
            <leggings material="chainmail leggings" unbreakable="true"/>
            <boots material="iron boots" unbreakable="true"/>
            <effect duration="3s" amplifier="5">resistance</effect>
        </kit>
        <kit id="used-jump-pad">
            <action scope="player">
                <set var="fall_variable" value="1"/>
            </action>
        </kit>
        <give>
            <filter>
                <all>
                    <after duration="1s">
                        <not>
                            <region id="jump-pads"/>
                        </not>
                    </after>
                    <after duration="0.2s">
                        <grounded/>
                    </after>
                </all>
            </filter>
            <kit>
                <action scope="player">
                    <set var="fall_variable" value="0"/>
                </action>
            </kit>
        </give>
    </kits>
    <teams>
        <team id="red-team" color="red" max="16">Red</team>
        <team id="blue-team" color="blue" max="16">Blue</team>
    </teams>
    <filters>
        <team id="only-red">red-team</team>
        <not id="not-red">
            <team>red-team</team>
        </not>
        <team id="only-blue">blue-team</team>
        <not id="not-blue">
            <team>blue-team</team>
        </not>
    </filters>
    <spawns>
        <default yaw="90">
            <region>
                <point>0.5,32,0.5</point>
            </region>
        </default>
        <spawn team="red-team" kit="spawn-kit" yaw="-90">
            <region>
                <point>-46.5,22,-0.5</point>
            </region>
        </spawn>
        <spawn team="blue-team" kit="spawn-kit" yaw="90">
            <region>
                <point>46.5,22,0.5</point>
            </region>
        </spawn>
    </spawns>
    <regions>
        <cuboid min="-49,0,-6" max="-41,256,6" id="red-spawn"/>
        <apply enter="only-red" region="red-spawn" message="You may not enter the enemy spawn!"/>
        <apply block="never" region="red-spawn" message="You may not build in a spawn!"/>
        <cuboid min="41,0,-6" max="49,256,6" id="blue-spawn"/>
        <apply enter="only-blue" region="blue-spawn" message="You may not enter the enemy spawn!"/>
        <apply block="never" region="blue-spawn" message="You may not build in a spawn!"/>
        <cuboid min="-4,17,-4" max="4,22,4" id="mid-capture"/>
        <cuboid min="-4,17,-4" max="4,18,4" id="mid-pad"/>
        <cuboid min="-4,20,-41" max="4,25,-33" id="north-capture"/>
        <cuboid min="-4,20,-41" max="4,21,-33" id="north-pad"/>
        <cuboid min="-4,20,33" max="4,25,41" id="south-capture"/>
        <cuboid min="-4,20,33" max="4,21,41" id="south-pad"/>
        <union id="jump-pads">
            <cuboid min="-6,15,-9" max="-4,17,-7" id="pad-mid-north-w"/>
            <cuboid min="4,15,7" max="6,17,9" id="pad-mid-north-w-turn"/>
            <cuboid min="4,15,-9" max="6,17,-7" id="pad-mid-north-e"/>
            <cuboid min="-6,15,7" max="-4,17,9" id="pad-mid-north-e-turn"/>
            <cuboid min="-29,14,-25" max="-26,16,-22" id="pad-ledge-mid"/>
            <cuboid min="26,14,22" max="29,16,25" id="pad-ledge-mid-turn"/>
        </union>
        <apply region="pad-mid-north-w" kit="used-jump-pad" velocity="-0.7,0.75,-2.87"/>
        <apply region="pad-mid-north-w-turn" kit="used-jump-pad" velocity="0.7,0.75,2.87"/>
        <apply region="pad-mid-north-e" kit="used-jump-pad" velocity="0.7,0.75,-2.87"/>
        <apply region="pad-mid-north-e-turn" kit="used-jump-pad" velocity="-0.7,0.75,2.87"/>
        <apply region="pad-ledge-mid" kit="used-jump-pad" velocity="2.1,0.8,1.78"/>
        <apply region="pad-ledge-mid-turn" kit="used-jump-pad" velocity="-2.1,0.8,-1.78"/>
        <cuboid min="-1,10,-1" max="1,11,1" id="apples"/>
        <cuboid min="25,14,-23" max="26,15,-22" id="arrows-0"/>
        <cuboid min="-26,14,21" max="-25,15,22" id="arrows-1"/>
        <apply block="never" use="never"/>
    </regions>
    <king>
        <hills required="false" neutral-state="true" incremental="true" show-progress="true" time-multiplier="0" permanent="false">
            <hill id="mid" name="the Middle" capture-region="mid-capture" progress-display-region="mid-pad" owner-display-region="mid-pad" capture-time="5s" points="2"/>
            <hill id="north" name="the North hill" capture-region="north-capture" progress-display-region="north-pad" owner-display-region="north-pad" capture-time="5s" points="1"/>
            <hill id="south" name="the South hill" capture-region="south-capture" progress-display-region="south-pad" owner-display-region="south-pad" capture-time="5s" points="1"/>
        </hills>
    </king>
    <score>
        <limit>600</limit>
    </score>
    <variables>
        <variable id="fall_variable" scope="player" default="0"/>
    </variables>
    <damage>
        <deny>
            <all>
                <cause>fall</cause>
                <variable var="fall_variable">1</variable>
            </all>
        </deny>
    </damage>
    <spawners>
        <spawner spawn-region="apples" delay="30s" max-entities="1">
            <item material="golden apple"/>
        </spawner>
        <spawner spawn-region="arrows-0" delay="10s" max-entities="8">
            <item material="arrow" amount="4"/>
        </spawner>
        <spawner spawn-region="arrows-1" delay="10s" max-entities="8">
            <item material="arrow" amount="4"/>
        </spawner>
    </spawners>
    <time>15m</time>
    <respawn delay="3s" auto="true"/>
    <itemkeep>
        <item>stone sword</item>
        <item>bow</item>
        <item>golden apple</item>
        <item>arrow</item>
    </itemkeep>
    <itemremove>
        <item>leather helmet</item>
        <item>leather chestplate</item>
        <item>chainmail leggings</item>
        <item>iron boots</item>
    </itemremove>
    <toolrepair>
        <tool>stone sword</tool>
        <tool>bow</tool>
    </toolrepair>
    <kill-rewards>
        <kill-reward>
            <item material="arrow" amount="6"/>
        </kill-reward>
    </kill-rewards>
    <hunger>
        <depletion>off</depletion>
    </hunger>
</map>

